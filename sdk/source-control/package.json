{
  "name": "@hyperfide/source-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "source": "./src/contracts.ts",
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js"
    }
  },
  "scripts": {
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "build": "node ../../tools/workspace/build-package.mjs"
  },
  "sideEffects": false,
  "types": "./src/index.ts"
}
