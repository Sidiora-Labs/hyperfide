{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
