{
    "codify.acp.claudeCommand": "npx -y @agentclientprotocol/claude-agent-acp",
    "editor.formatOnPaste": true,
    "files.trimTrailingWhitespace": true,
    "editor.fontSize": 14,
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.lineHeight": 22,
    "editor.minimap.enabled": true,
    "editor.wordWrap": "off",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll": "explicit"
    },
    "extensions.ignoreRecommendations": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[javascript][typescript][typescriptreact][javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "workbench.colorCustomizations": {
        "activityBar.background": "#000000",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#FEFBFF",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#ffffff",
        "statusBar.debuggingBackground": "#000000",
        "statusBar.debuggingForeground": "#FEFBFF",
        "statusBar.noFolderBackground": "#410A56",
        "statusBar.noFolderForeground": "#FEFBFF"
    },
    "explorer.compactFolders": false,
    "breadcrumbs.enabled": false,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 5,
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.scrollback": 5000,
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/.pytest_cache": true,
        "**/.cache": true,
        "**/.codegraph": true,
        "**/build": true,
        "**/.logs": true,
        "**/.kiro": true,
        "**/.gemini": true,
        "**/.devin": true,
        "**/.cursor": true,
        "**/.opencode": true,
        "**/.zed": true,
        "**/broadcast": true,
        "**/paxeer-network": true,
        "**/.agents": true,
        "**/.cgignore": true,
        "**/.claude": true,
        "**/.dockerignore": true,
        "**/.gideon-genui-20261002": true,
        "**/.github": true,
        "**/.gu26-commit-state": true,
        "**/.gu26-private": true,
        "**/.hypermid-fleet": true,
        "**/.hypermid-hosted": true,
        "**/.mcp.json": true
    },
    "codify.agent.interface": "panel",
    "codify.agent.driver": "claude",
    "codify.acp.diffStyle": "split"
}