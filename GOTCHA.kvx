[gotcha.source_spec_bootstrap]
symptom = "The installed hyperfide brief command refuses a fresh source checkout without initialized project state."
cause = "Repository source and spec files do not themselves initialize the local graph database."
resolution = "Specification authoring can use the strict KVX parser and structural validation without initializing or indexing the repository. Runtime commands require a separately initialized project."
evidence = "hyperfide 2.0.0-dev: brief exits 1 with not inside a Codify project; spec/hyperfide/tools/validate_pack.py exposes parse_kvx."
status = "documented"

[gotcha.spec_done_graph_refresh]
symptom = "hyperfide spec done with --no-sync still performs a repository-wide graph refresh after verify_cmd passes."
cause = "core/native/src/spec.c applies no_sync to spec trace; spec_verify_task calls spec_graph_open with sync=true."
resolution = "Keep focused test receipts distinct from full task qualification. An unfinished graph/evidence stage leaves the task implemented; --no-sync does not bypass that stage."
evidence = "Layout task 0.3 verify_cmd passed 22 checks; spec done was terminated with exit 143 during graph refresh. See spec/hyperfide-source-control/qualification.kvx."
status = "documented"

[gotcha.control_dist_stamp_concurrent_edits]
symptom = "A successful control-plane build stamp can describe source changes absent from emitted JavaScript when another writer edits during compilation."
cause = "The build invokes TypeScript before dist-stamp.mjs captures the source digest; a file can change between the compiler read and stamp creation."
resolution = "Freeze control-plane source writers before compilation and artifact capture. Discard a build produced across a source edit and rebuild the frozen tree."
evidence = "A concurrent processes.ts change added knownBlaxelMetadata to source while the stamped dist/providers/blaxel/processes.js lacked it."
status = "documented"

[gotcha.control_migration_checkpoint]
symptom = "Two release snapshots can have identical compiler source and output stamps but different migration SQL."
cause = "deploy/hyperfide/dist-stamp.mjs hashes root build inputs and src; migrations have their own release checksum catalog."
resolution = "Capture migration files and verify their checksums with the immutable runtime snapshot. A SQL correction requires a new snapshot even when the compiler stamp is unchanged."
evidence = "The 0727 review changed SQL while the compiler source stamp remained 2217d1238bd729e7640c20ba824827c4ca590b3bb096f5e63324ded8f9c73f1f. MigrationCoordinator verifies the independent SQL checksum history."
status = "documented"

[gotcha.isolated_typescript_transpile]
symptom = "An isolated runtime regression can pass while its TypeScript source has a syntax error."
cause = "TypeScript transpileModule can recover malformed syntax and emit JavaScript without rejecting it; outputText alone is not a compiler validity check."
resolution = "Request and reject error diagnostics before using isolated emitted code, and run the normal project compiler before capturing a release."
evidence = "The manager replacement fixture emitted a working supervisor despite an extra closing parenthesis rejected by the project compiler as TS1005. The fixture now rejects transpile diagnostics."
status = "resolved"

[gotcha.fleet_transient_http_status]
symptom = "The native heartbeat observer exits on a temporary database failure while retaining its pending operation."
cause = "Thrown database errors were mapped to HTTP 400, while component errors wrapped by handleRequest were returned with HTTP 200. Both paths bypass the observer's retry handling for temporary failures."
resolution = "Map temporary database failures to HTTP 503 for both thrown and returned error envelopes, preserving the original operation and error code."
evidence = "The signed TLS/PostgreSQL transport_http_status.py regression reproduces both failures on the prior checkpoint and passes 16 cases on control source c95244c1461b24341c759c81a2326d00171ea96e31c98884e3267d51ca4cafb3."
status = "resolved"

[gotcha.bootstrap_registration_row_lock]
symptom = "Native enrollment and runner inventory succeed, but preparation registration fails with SQLSTATE 42501."
cause = "The control role can read provider_native_bootstraps but lacks the UPDATE privilege PostgreSQL requires for SELECT FOR SHARE."
resolution = "For a scoped control role, grant UPDATE(id) on provider_native_bootstraps. Its immutable binding trigger prevents identity changes; bootstrap state and receipt columns remain outside that grant."
evidence = "The exact registration row lock failed before the grant and succeeded under the same control role afterwards; state and receipt UPDATE privileges remained false."
status = "resolved"

[gotcha.shared_provider_inventory_scope]
symptom = "Unrelated workloads in a shared provider workspace quarantine a fleet pool and block new admission."
cause = "Inventory reconciliation inserted every listed resource as an orphan before evaluating its ownership scope."
resolution = "Probe ownership before inserting orphans. Use protected positive owner rules and retained attribution evidence to separate pool membership from shared-account resource charges. Preserve unknown physical presence across stale observations and policy changes."
evidence = "foreign_inventory_capacity.py exercised signed APIs, PostgreSQL and 137 pinned-SDK HTTP reads, including foreign attribution, unknown ownership, expiry, deduplication and unchanged legacy rows."
status = "resolved"

[gotcha.fleet_assignment_packet_handoff]
symptom = "A manager can select an installed worker slot but cannot form an assignment without an execution packet digest unavailable in its observations."
cause = "The assignment API required callers to supply a pre-created packet and its opaque claim identities."
resolution = "Accept an explicit task and installed-slot selection. Create the authoritative packet, claim and worker registration in the same admitted transaction, preserving accepted interface roles and replay identities."
evidence = "fleet_selected_assignment.py exercises signed API assignment, PostgreSQL effects, refused stale or mismatched selections and replay without duplicate workers."
status = "resolved"

[gotcha.fleet_provider_budget_domains]
symptom = "Positively identified foreign workloads exhaust a fleet operating budget even when the provider account has capacity."
cause = "Provider quota and managed operating budget comparisons used the same shared resource total."
resolution = "An explicitly protected accounting policy separates managed allocations from shared provider quota. Retained declarations identify their domain; foreign ownership and physical presence remain observable."
evidence = "foreign_inventory_capacity.py exercises signed CREATE preparation with shared inventory, distinct quota declarations, expiry and unchanged managed budget ceilings."
status = "resolved"

[gotcha.fleet_observation_history_budget]
symptom = "Accumulated effect results and advisory messages exhaust the bounded model observation before another decision can run."
cause = "Repeated observations included complete historical payloads alongside current admission state; the Primary model action allowlist also omitted manager replacement."
resolution = "Project historical payloads to digest-bound summaries and expose authorized REPLAN history pages or UTF-8 entry chunks. Preserve current ownership, dependencies, uncertain effects and holds. Permit REPLACE_MANAGER for the Primary and exclude it from Wave Managers."
evidence = "fleet-provider-history.log passes ten named projection/history checks; fleet-model-role-contract.log captures two authenticated role-specific gateway requests through an HTTPS 503 response, with no model decision inserted."
status = "resolved"

[gotcha.fleet_http_failure_diagnostics]
symptom = "An HTTP failure can lose its useful typed diagnostic when forwarded by a runtime worker."
cause = "Error reporting paths differed between authentication, component dispatch and process-level stderr forwarding."
resolution = "Emit bounded typed failure events with validated operation/correlation identities; forward only sanitized diagnostic fields and preserve tested retry status mapping."
evidence = "http-diagnostics-after.log passes 18 signed TLS/PostgreSQL status cases and records 23 bounded events; invalid identities, poisoned codes and canary values are omitted or sanitized, and duplicate timer reports are suppressed. history-keeper-rollout-readiness.json records the deployed loader forwarding the matching strict HTTP 400 readiness diagnostic."
status = "resolved"

[gotcha.blaxel_bootstrap_observer_keeper]
symptom = "An idle provider sandbox can suspend its native observer while bootstrap metadata remains READY."
cause = "A detached native observer does not itself keep the provider SDK process boundary active."
resolution = "Run a bounded keeper for the exact existing manifest, daemon identity and boot, limited by actual VM and runner expiry. Persist submission before execution, reconcile the same process after uncertainty, and retain terminal failures without resubmission."
evidence = "bootstrap-observer-keeper-rerun.log passes eight checks using signed PostgreSQL coordination, the pinned SDK boundary and a real Node/proc identity probe; original READY metadata and receipt bytes remain unchanged. A separate live idle receipt records signed heartbeat advancement over 91,627 ms with the same original daemon and one ACTIVE keeper, using database SELECTs only and no install jobs or guest probes."
status = "resolved"

[gotcha.fleet_worker_feedback_projection]
symptom = "Managers lack bounded worker progress and checkpoint information needed for subsequent decisions."
cause = "Task assignment receipts do not expose current launch journals, checkpoint references or unresolved findings."
resolution = "Project the exact current task attempt and package-scoped recorded feedback, with explicit UNKNOWN, omission and cursor metadata. Use authorized REPLAN detail pages; recorded output and checkpoint references do not grant qualification or resume authority."
evidence = "fleet-worker-feedback-component-receipt.json passes three grouped signed PostgreSQL/TLS checks for current-plan provenance, isolation and bounded retrieval. fleet-model-role-install-selector-component-receipt.json captures the role-specific INSTALL selector contract through controlled HTTPS 503 responses."
status = "resolved"

[gotcha.fleet_source_cache_admission]
symptom = "Configured source-cache limits are not exercised by actual source materialization."
cause = "A materializer can verify payloads yet bypass cache admission and reuse accounting."
resolution = "Use the bounded verified cache in the source path, retaining content, security-scope and mount identity checks. Count misses and reuse from actual filesystem operations."
evidence = "cache-owner-receipt.json records 14 assertions over an isolated selected-source runtime and independent source review; the prior materializer fails the first cache-admission assertion."
status = "resolved"

[gotcha.fleet_transfer_measurement_provenance]
symptom = "Source inventory sizes can be mistaken for measured network transfer."
cause = "Inline payload bytes, cache activity, local writes and provider response bytes represent different operations."
resolution = "Bind actual application-layer response counters to the native execution and install receipt; record source/cache/local activity separately and leave unmeasured dependency-network transfer explicit."
evidence = "transfer-gate-receipt.json records 74 native assertions, 15 transfer-contract assertions and actual signed interrupted-install execution with five altered transfer closures refused."
status = "resolved"
