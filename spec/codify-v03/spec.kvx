# Codify v0.3 — govern the whole lifecycle, from one binary.

[meta]
feature = "codify-v03"
intro   = "Close the gaps between plan and proof: correct project boundaries, a real editor protocol, git as a peer, spec authoring, and per-edit governance that advises before it blocks."

[req.1]
title = "Correct project boundaries"
story = "As a developer, I want cg to bind to the right project so that commands never silently operate on an ancestor directory."
ac_1  = "WHEN an ancestor holds .codegraph but a nearer directory holds .git THE root walk SHALL stop at the .git boundary and report no project."
ac_2  = "WHEN cg init runs in a directory whose ancestor is a project THE command SHALL initialize here unless --nested is withheld and the user is warned."
ac_3  = "WHEN cg init targets $HOME THE command SHALL refuse without --force."
ac_4  = "WHEN any command binds a project THE resolved root SHALL be discoverable via cg root and cg info."
ac_5  = "WHEN two cg processes write concurrently THE database SHALL use WAL and a busy timeout rather than failing."

[req.2]
title = "Graph quality"
story = "As an agent, I want context calls to return relevant code so that I do not waste turns on noise."
ac_1  = "WHEN a query has multiple words THE search SHALL match per token and fuse scores rather than matching the whole phrase."
ac_2  = "WHEN context returns entry points THE entry points SHALL relate to the query, with main() only as a fallback."
ac_3  = "WHEN a symbol is requested THE tool SHALL be able to return just that symbol body rather than its whole file."
ac_4  = "WHEN a change touches symbols THE tool SHALL report which tests reference them."
ac_5  = "WHEN provenance is requested THE tool SHALL join a symbol to the commits, tasks, and memories behind it."

[req.3]
title = "Git as a peer"
story = "As a developer, I want Codify to understand my git repository so that adopting it is not all-or-nothing."
ac_1  = "WHEN .gitignore exists THE ignore rules SHALL honour it alongside .cgignore."
ac_2  = "WHEN git history is present THE graph SHALL ingest commits, authors, and per-file churn."
ac_3  = "WHEN churn data exists THE search and context ranking SHALL use it."
ac_4  = "WHEN cg commit runs with --git THE snapshot and a real git commit SHALL carry the same spec tag."

[req.4]
title = "Spec authoring and governance"
story = "As an agent, I want to create and validate plans so that the whole lifecycle lives in one tool."
ac_1  = "WHEN a feature is created THE tool SHALL scaffold spec/<feature>/spec.kvx and workflow.kvx if absent."
ac_2  = "WHEN a task is added THE kvx file SHALL gain the task with every other byte preserved."
ac_3  = "WHEN a spec is linted THE tool SHALL report requires cycles, unknown ids, missing acceptance criteria, and dead touches globs."
ac_4  = "WHEN mode is parallel THE tool SHALL allow multiple claims bounded by wave independence and touches disjointness."
ac_5  = "WHEN cg check runs THE command SHALL gate render staleness, lint, and task evidence in one exit code."

[req.5]
title = "Ambient agent governance"
story = "As a developer, I want Codify present at every step without being invoked so that the workflow governs itself."
ac_1  = "WHEN a session starts THE brief SHALL return repo state, active task, memories, and uncommitted blast radius in one call."
ac_2  = "WHEN a change is reviewed THE review SHALL pair changed symbols with the task's acceptance criteria and at-risk callers."
ac_3  = "WHEN an edit lands outside the active task's declared touches THE guard SHALL report it, warning by default."
ac_4  = "WHEN hooks are installed THE graph SHALL stay fresh without any explicit sync call."
ac_5  = "WHEN a decision is superseded THE older memory SHALL stop surfacing first."

[req.6]
title = "Modern agent and editor protocols"
story = "As an agent or editor, I want current protocol features so that Codify integrates without custom glue."
ac_1  = "WHEN tools are listed THE response SHALL carry read-only and destructive annotations and output schemas."
ac_2  = "WHEN a client supports resources and prompts THE server SHALL expose the spec and the workflow loop through them."
ac_3  = "WHEN initialize is called THE server SHALL negotiate a protocol version it supports rather than echoing the client."
ac_4  = "WHEN an editor speaks LSP THE cg lsp server SHALL answer definition, references, hover, and workspace symbol from the graph."
ac_5  = "WHEN a spec or scope problem exists THE LSP SHALL publish it as a diagnostic in the editor."

[design]
overview = "Every addition is a new command in the existing dispatch plus, where needed, one new module. No new link-time dependencies: git is read by piping git(1), and the LSP reuses the JSON scanner already used for MCP. Governance is advisory by default — cg guard warns unless --strict — so adoption never breaks an existing workflow."

[design.boundaries]
title  = "Root resolution"
points = ["cg_find_root gains a boundary set: .git/.hg/.svn stop the walk, $HOME stops the walk, a st_dev change stops the walk", "cg_find_root_at resolves from an explicit directory for the LSP and MCP roots", "init checks the cwd only and asks about ancestors"]

[design.modules]
title  = "New modules"
points = ["src/gitint.c — git history ingestion and churn", "src/lsp.c — Content-Length framed LSP server over the graph", "src/govern.c — brief, review, guard, check, hook install"]

[tasks]
heading = "Implementation Plan: Codify v0.3"

[task.0]
title   = "Foundation"
section = "Wave 0: correct boundaries"
status  = "pending"

[task.0.1]
title      = "Bound root resolution and harden the database"
status     = "done"
wave       = 0
symbols    = ["cg_find_root_at", "cmd_root"]
touches    = ["src/db.c", "src/main.c", "src/cg.h"]
verify_cmd = "make && CG=$PWD/cg tests/integration/09_root.sh"
do_1       = "Stop the upward walk at .git/.hg/.svn, $HOME, and mount boundaries"
do_2       = "Add cg_find_root_at for explicit-directory resolution"
do_3       = "init checks cwd only; --nested for ancestors; refuse $HOME without --force"
do_4       = "Add cg root and print the project root in cg info"
do_5       = "Enable WAL and a busy timeout in cg_open"
reqs       = ["1.1", "1.2", "1.3", "1.4", "1.5"]

[task.0.2]
title      = "Honour .gitignore"
status     = "done"
wave       = 0
