# Codify 1.6 — structured, reliable and evidence-backed code indexing.

[meta]
feature = "codify-v16"
intro = "Extend Codify into a structured multi-language code index with precise cross-file relationships, reliable incremental updates and explicit evidence. Preserve its single-executable deployment, branch-aware storage, bounded resource use and local operation."

[req.1]
title = "Reliable incremental indexing"
story = "As an agent or repository maintainer, I want reliable incremental indexing so that code navigation and change analysis can be trusted."
ac_1 = "WHEN the index is built or queried THE system Source changes SHALL be detected at subsecond timestamp precision; explicitly dirty paths SHALL be content-hashed even when size and timestamp are unchanged. Migration SHALL force older metadata through a verification pass."
ac_2 = "WHEN the index is built or queried THE system Watcher overflow, registration failure, root loss, and persistent synchronization errors SHALL produce durable reconciliation debt and visible degraded coverage, retained until successful reconciliation. Polling fallback SHALL keep supported non-Linux platforms fresh."
ac_3 = "WHEN the index is built or queried THE system Each indexed file SHALL expose complete, partial, skipped, or failed extraction with bounded reason codes, parser identity, diagnostics, generated status, and last successful content hash. Long lines and parser recovery SHALL never silently imply full coverage."
ac_4 = "WHEN the index is built or queried THE system Extractor-output version SHALL be independent of database schema version and branch-scoped. Semantic upgrades SHALL re-extract stale content, and failed or partial passes SHALL not stamp it current."
ac_5 = "WHEN the index is built or queried THE system Incremental indexing SHALL invalidate symbol bindings, export chains, configuration dependencies, route registrations and synthesized relations; interrupted updates SHALL retain retryable debt and converge to a clean rebuild."

[req.2]
title = "Structured extraction and language coverage"
story = "As an agent or repository maintainer, I want structured extraction and language coverage so that code navigation and change analysis can be trusted."
ac_1 = "WHEN the index is built or queried THE system A common extraction contract SHALL record symbol kind, qualified name, parent ownership, byte and line/column spans, signature, documentation, visibility, exports, modifiers, decorators, generic parameters and result type when syntax provides them. Unknown information SHALL remain unknown."
ac_2 = "WHEN the index is built or queried THE system A native syntax-tree backend SHALL be compiled into the executable from pinned, licensed sources; core indexing SHALL require no network, external parser process, language server, package installation or model call at runtime. Parser instances SHALL be worker-local, bounded, cancellable and freed after use; the heuristic fallback SHALL identify itself."
ac_3 = "WHEN the index is built or queried THE system TypeScript, TSX, JavaScript and JSX SHALL extract multiline declarations, classes and methods, object-literal actions, imports, exports, type references, callbacks and components using syntax nodes with positive and negative fixtures."
ac_4 = "WHEN the index is built or queried THE system C, C++, Objective-C, Go and Rust SHALL extract structural declarations, methods, type relations, imports/includes, function values and calls with language-specific scope and macro/error-boundary reporting."
ac_5 = "WHEN the index is built or queried THE system Python, Ruby and PHP SHALL extract nested definitions, classes, methods, decorated declarations, imports, documentation and scope-aware references without treating strings/comments as code."
ac_6 = "WHEN the index is built or queried THE system Java, Kotlin, Scala, C#, Swift and Dart SHALL extract ownership, types, generics, inheritance, methods and call/reference relationships, with syntax recovery and overloaded names explicitly represented."
ac_7 = "WHEN the index is built or queried THE system Lua, Luau, R, Erlang, Solidity, Terraform and Nix SHALL provide grammar-backed structural extraction; Pascal, COBOL, VB.NET, CFScript, CFQuery and ArkTS SHALL have tested extraction adapters. Grammar provenance and per-language coverage SHALL be inspectable; recognition alone SHALL not count as structural support."
ac_8 = "WHEN the index is built or queried THE system Vue, Svelte, Astro, Liquid, Razor, CFML, Delphi forms and MyBatis mappings SHALL expose embedded-code or declarative relationships with original source coordinates; JSON, YAML, Twig and properties SHALL be accurately labelled when only file-level tracking is available."

[req.3]
title = "Precise cross-file relationships"
story = "As an agent or repository maintainer, I want precise cross-file relationships so that code navigation and change analysis can be trusted."
ac_1 = "WHEN the index is built or queried THE system Imports SHALL preserve local/original/default/namespace bindings and exports, follow bounded cyclic-safe re-export chains, and support nearest project aliases and workspace package roots. Configuration changes SHALL invalidate dependent bindings."
ac_2 = "WHEN the index is built or queried THE system Receiver resolution SHALL use this/self ownership, explicit imported namespaces, constructors and declared receiver types before conservative name matching. Ambiguous equal candidates SHALL remain unresolved with candidate evidence; overloads and language visibility SHALL be respected."
ac_3 = "WHEN the index is built or queried THE system Typed graph relations SHALL include containment, calls, imports, exports, inheritance, implementation, references, types, returns, instantiation, overrides and decorators with branch-scoped endpoints and source locations."
ac_4 = "WHEN the index is built or queried THE system Every resolved or inferred relation SHALL retain original reference text, resolution strategy and evidence; synthesized relations SHALL be labelled heuristic with registration location and channel. Numeric confidence SHALL not be represented as calibrated probability."
ac_5 = "WHEN the index is built or queried THE system Framework adapters SHALL connect routes to handlers and composition/mounts for Express, Next.js, React Router, Expo Router, SvelteKit, Vue/Nuxt, FastAPI, Django, Flask, Laravel, Rails, Spring, Gin, Axum, ASP.NET and Vapor. File-based routes SHALL retain method and path semantics."
ac_6 = "WHEN the index is built or queried THE system Callback registration/invocation, observers, named event channels, interface dispatch, C function-pointer tables, React state-to-render/component relationships and native bridge registrations SHALL produce bounded evidence-backed relationships with invalidation on wiring changes."
ac_7 = "WHEN the index is built or queried THE system Literal HTTP method/path calls SHALL resolve only to uniquely matching local routes; literal queue, bus and socket channels SHALL connect only compatible producers/consumers. Dynamic values, ambiguous registrations and external boundaries SHALL remain explicit boundaries."
ac_8 = "WHEN the index is built or queried THE system Synthesis SHALL be dependency-gated, fan-out bounded, transactionally replaced and skipped on unrelated/no-op updates. Failed-reference retry SHALL preserve original references and avoid stale incoming edges after deletion or replacement."

[req.4]
title = "Retrieval that exposes evidence and limits"
story = "As an agent or repository maintainer, I want retrieval that exposes evidence and limits so that code navigation and change analysis can be trusted."
ac_1 = "WHEN the index is built or queried THE system Existing body/comment/trigram search and branch isolation SHALL be retained while symbol search gains composable kind/language/path/name filters, identifier-segment lookup, exact-match precedence and bounded typo fallback."
ac_2 = "WHEN the index is built or queried THE system Context SHALL combine query symbols and co-location evidence, return useful source bodies and all relevant overloads within explicit budgets, attach bounded paths among named symbols, and report weak matches and omitted content."
ac_3 = "WHEN the index is built or queried THE system Graph traversal SHALL enforce depth, node, edge, time and output budgets, explain paths with evidence and dynamic boundaries, and expose ancestors, subtypes and implementations."
ac_4 = "WHEN the index is built or queried THE system Dead-code candidates SHALL distinguish unreachable from merely unreferenced; exported, reflective, framework, generated and uncertain boundaries SHALL provide exclusion reasons rather than definitive deletion advice."
ac_5 = "WHEN the index is built or queried THE system CLI and MCP responses SHALL expose branch, extraction coverage and source freshness. Bounded source hash validation SHALL distinguish verified, stale and unchecked contributing files, without presenting a coalesced or failed refresh as fresh."

[req.5]
title = "Correctness, resource and release gates"
story = "As an agent or repository maintainer, I want correctness, resource and release gates so that code navigation and change analysis can be trusted."
ac_1 = "WHEN the index is built or queried THE system A deterministic labelled corpus SHALL measure positive and negative symbol/edge expectations by language and framework, precision, recall, unresolved counts and parser coverage; test success SHALL not depend only on name matches or edge counts."
ac_2 = "WHEN the index is built or queried THE system Full graph-set differential tests SHALL compare incremental edits and commit replay with fresh rebuilds across additions, deletions, renames, competing names, configuration changes, branch switches, synthesis and interrupted writes."
ac_3 = "WHEN the index is built or queried THE system Performance tests SHALL record cold index, no-op sync, one-file edits, deletion/rename, source-to-query freshness, peak memory, database size and phase times under fixed workers. Bounded queues and branch reuse SHALL be preserved; regressions SHALL be reported with reproducible inputs."
ac_4 = "WHEN the index is built or queried THE system Each task SHALL be owned by one worker on an isolated branch, verified before merge to main, with task-tagged evidence and strict dependency qualification. Final qualification SHALL run unit/integration suites, strict compilation, spec lint and documentation closure."
ac_5 = "WHEN the index is built or queried THE system Version 1.6 documentation SHALL state actual language/framework coverage, fallback and inference limits, migration behavior, commands and measured resource results. No speculative capability SHALL be described as shipped."

[design]
include = "design.body.md"

[documentation]
mode = "auto"
status = "pending"
audiences = ["user", "developer"]
targets = ["README.md", "CHANGELOG.md", "docs/**"]

