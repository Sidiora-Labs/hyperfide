heading = "Implementation Plan: Codify 1.6"

[task.1.1]
title = "Subsecond change detection and explicit-dirty hashing"
status = "done"
wave = 1
requires = []
touches = ["src/scan.c", "src/walk.c", "src/cg.h", "src/db.c", "tests/integration/54_freshness.sh"]
verify_cmd = "make -j2 cg && CG=$PWD/cg bash tests/integration/54_freshness.sh"
do_1 = "Fix same-size same-second and preserved-metadata dirty edits in full and targeted passes; migrate timestamps; preserve hash reuse, branch isolation and Git candidate behavior."
do_2 = "Implement only this task in an isolated worktree. Run meaningful positive and negative regression tests, record evidence in the task-tagged commit, and qualify dependencies before declaring done. Coordinate shared APIs with their owners; do not weaken tests or silently reduce the acceptance scope."
