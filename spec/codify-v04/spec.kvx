verify_cmd = "make && CG=$PWD/cg tests/integration/15_accuracy.sh"
do_1       = "SymRef gains qual + kind; capture receiver tokens for qualified calls"
do_2       = "Table-driven import extraction per language into the imports table"
do_3       = "Writer inserts and purges imports alongside other child rows"
