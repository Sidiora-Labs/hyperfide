# Codify v0.4 — agent-native indexing, sessions, and orchestration.

[meta]
feature = "codify-v04"
intro   = "Make the graph accurate enough to trust, the output cheap enough to read, and the workflow strong enough to drive real agent sessions: scope-aware indexing, ranked and budgeted retrieval, session handoff, and an orchestrator that runs parallel Codex and Claude Code sub-agents over the task board."

[req.1]
title = "Scope-accurate indexing"
story = "As an agent, I want call edges that reflect real scopes and imports so that impact analysis stops inventing callers."
ac_1  = "WHEN a reference sits between two function bodies THE indexer SHALL NOT attribute it to the preceding function."
ac_2  = "WHEN a definition ends THE symbol's end_line SHALL reflect its real scope from brace or indentation structure, not the next definition's start."
ac_3  = "WHEN a call has a receiver or qualifier THE reference SHALL record it for disambiguation."
ac_4  = "WHEN a file imports names or modules THE graph SHALL record the imports for query-time resolution."
ac_5  = "WHEN a multi-line string spans lines THE continuation lines SHALL NOT produce symbols or references."
ac_6  = "WHEN a file's content is unchanged THE rescan SHALL NOT regenerate its symbol rows."
ac_7  = "WHEN the database schema version changes THE derived graph tables SHALL rebuild while memories, leases, and history survive."

[req.2]
title = "Accurate, budgeted retrieval"
story = "As an agent, I want ranked, deduplicated, size-bounded answers so that one call gives me signal instead of noise."
ac_1  = "WHEN real code and test fixtures both match a query THE real code SHALL rank first."
ac_2  = "WHEN a name resolves to several definitions THE resolution SHALL prefer same file, then imported modules, then same directory, deterministically."
ac_3  = "WHEN context output would exceed the requested budget THE sections SHALL truncate with explicit omitted counts."
ac_4  = "WHEN a symbol repeats across context sections THE later occurrences SHALL use a compact reference form."
ac_5  = "WHEN edge lists are truncated THE selection SHALL be deterministic across runs."
ac_6  = "WHEN a spec-mutating MCP tool completes THE result SHALL be machine-readable JSON."

[req.3]
title = "Session handoff"
story = "As an agent, I want to hand work to a fresh session so that context bloat never forces me to lose progress."
ac_1  = "WHEN a session records a handoff THE note SHALL capture done steps, next steps, blockers, and touched files against the task."
ac_2  = "WHEN a fresh session resumes a task THE resume bundle SHALL include the task packet, the latest handoff, and task-scoped memories in one call."
ac_3  = "WHEN resume renders a prompt THE output SHALL be paste-ready for a new agent session."
ac_4  = "WHEN a newer handoff exists THE older handoff SHALL stop surfacing first."
ac_5  = "WHEN brief reports memories THE task-scoped memories SHALL rank before unrelated recent ones."

[req.4]
title = "Parallel-safe dispatch"
story = "As an orchestrator, I want atomic claims and honest gates so that parallel agents never collide or lie."
ac_1  = "WHEN two agents claim concurrently THE claims SHALL be atomic and never silently steal ownership."
ac_2  = "WHEN the ready frontier is requested THE output SHALL list every eligible task across waves."
ac_3  = "WHEN claim-next runs THE tool SHALL atomically pick, claim, and start a touches-disjoint task and return its full packet."
ac_4  = "WHEN a task completes THE lease SHALL release automatically."
ac_5  = "WHEN two live leases overlap on touches THE check SHALL fail even for partial overlaps."
ac_6  = "WHEN several tasks are in progress THE guard, review, brief, and commit tagging SHALL follow the invoking agent's task."

[req.5]
title = "Sub-agent orchestration"
story = "As a developer, I want cg to run the plan with parallel sub-agents so that a wave of disjoint tasks executes itself."
ac_1  = "WHEN cg spec run starts THE orchestrator SHALL claim disjoint tasks and spawn one driver process per slot up to the requested parallelism."
ac_2  = "WHEN a driver process exits THE orchestrator SHALL verify the task status and record an outcome instead of trusting the exit code."
ac_3  = "WHEN a driver fails THE lease SHALL release and the failure SHALL count toward a stop threshold."
ac_4  = "WHEN --dry-run is passed THE orchestrator SHALL print the plan without claiming anything."
ac_5  = "WHEN the driver is codex or claude THE spawned session SHALL receive a resume-style prompt for its task on stdin."

[req.6]
title = "IDE-driven agent sessions"
story = "As a developer, I want to start, watch, and hand off Codex and Claude Code sessions from VS Code so that the board drives the work."
ac_1  = "WHEN a task node action starts an agent THE extension SHALL claim the task and open a terminal session seeded with the task's resume prompt."
ac_2  = "WHEN a tracked session's terminal closes without completion THE extension SHALL offer to release the claim."
ac_3  = "WHEN sessions are active THE task board SHALL refresh from graph and spec changes without manual action."
ac_4  = "WHEN a wave run is requested THE extension SHALL execute the orchestrator with the configured parallelism."
ac_5  = "WHEN a handoff or resume is requested from the IDE THE extension SHALL drive the corresponding cg commands."

[design]
overview = "Every addition is a new command in the existing dispatch plus one new module (src/orchestrate.c). Accuracy work stays table-driven inside the existing regex engine: real scope ends, persistent string state, qualifier capture, and an imports table — no parser dependency. Retrieval gains a shared ranking function, deterministic ordering, and byte budgets threaded from CLI and MCP. Sessions become a first-class handoff artifact stored as superseding memories. Orchestration composes claim-next, resume prompts, and fork/exec drivers; the VS Code extension attaches terminals to claims. No new link-time dependencies."

[design.modules]
title  = "Structure"
points = ["src/lang.c — scope ends, string state, qualifiers, table-driven imports", "src/graph.c — find_symbols_all ranking, import-aware resolution, budgets, compact emission", "src/spec.c + src/govern.c — ready frontier, atomic claim-next, per-agent identity, handoff/resume", "src/orchestrate.c — cg spec run driver loop (new module)", "editors/vscode/agents.js — terminal-attached agent sessions (new module)"]

[tasks]
heading = "Implementation Plan: Codify v0.4"

[task.1]
title   = "Indexing accuracy"
section = "Wave 1: the graph tells the truth"
status  = "pending"

[task.1.1]
title      = "Scope-accurate extents and enclosing attribution"
status     = "done"
wave       = 1
symbols    = ["lang_scope_end"]
touches    = ["src/lang.c", "src/scan.c", "src/cg.h", "tests/unit/*.c", "tests/fixtures/*", "tests/integration/*.sh"]
verify_cmd = "make && CG=$PWD/cg tests/integration/15_accuracy.sh"
do_1       = "Compute real end_line per def: brace depth for brace languages, indentation for python, next-def fallback"
do_2       = "Persist multi-line string state in clean_line (python triple quotes, js template literals)"
do_3       = "Attribute refs to the innermost containing function/method scope; NULL outside any scope"
do_4       = "Unit tests for scoping, string state, and attribution"
reqs       = ["1.1", "1.2", "1.5"]

[task.1.2]
title      = "Ref qualifiers, kinds, and the imports table"
status     = "done"
wave       = 1
symbols    = ["lang_scan_imports"]
