# codify-v10 — fleet-safe sync, hierarchical fleet workflow, unified multi-branch graph, Jev decisions, full-feature editor.

[meta]
feature = "codify-v10"
intro   = "Make Codify safe under a fleet of agents (one coalescing indexer instead of fifty), model the Main Gideon / feature manager / wave worker hierarchy with branch, merge, PR, and checkpoint flow, track every branch and worktree of a repository as one unified graph and memory, add mandatory Jev decisions for classification and triage, and turn the VS Code extension into a full-feature interface."

[req.1]
title = "Smart auto sync without process storms"
story = "As an operator running a fleet of agents, I want indexing to stay cheap and single-writer so that fifty concurrent cg processes never saturate the CPU again."
ac_1  = "WHEN several cg processes need the index at the same time THE first SHALL run the pass and the others SHALL coalesce into it by leaving a dirty marker instead of walking, parsing, or resolving themselves."
ac_2  = "WHEN the index was refreshed within a caller's freshness window and nothing is pending THE sync SHALL skip the walk entirely and report the graph as fresh."
ac_3  = "WHEN an index pass runs from a hook, watcher, or editor refresh THE worker count SHALL be capped by machine-wide index slots so that concurrent projects cannot multiply parse threads beyond the core budget."
ac_4  = "WHEN a change touches a handful of files THE post-scan resolution SHALL rescope references, imports, and anchor edges to the changed files and the symbol names they added or removed instead of rewriting the whole graph."
ac_5  = "WHEN a Claude Code edit hook fires THE installed hook SHALL run one cg process that syncs the edited path and guards it, not two full syncs."
ac_6  = "WHEN the VS Code extension refreshes THE extension SHALL coalesce concurrent refreshes into one in-flight pass, SHALL NOT re-trigger on its own database writes, and SHALL NOT index on every poll."

[req.2]
title = "Hierarchical fleet workflow"
story = "As the fleet owner, I want a Main Gideon that owns the task list and merges PRs, feature managers that own one feature and its branch, and wave workers that implement one wave on their own branch, so that work flows upward through verified merges."
ac_1  = "WHEN the workflow declares the hierarchy THE roles main, feature, and worker SHALL be readable from workflow.kvx with their branch naming, base branch, remote, and gate commands."
ac_2  = "WHEN a worker starts a wave task THE tool SHALL create or reuse a worktree on a wave branch cut from the feature branch and record the branch, worktree, and parent in the attempt ledger."
ac_3  = "WHEN a worker's task qualifies THE tool SHALL merge the wave branch into the feature branch, and WHEN the merge conflicts THE feature manager SHALL receive a conflict report naming the paths."
ac_4  = "WHEN every task of a feature is qualified and the feature branch is merged into local main THE tool SHALL run the configured test and lint gates and open a pull request against remote main only when both are green."
ac_5  = "WHEN a checkpoint is reached THE tool SHALL merge the open Codify pull requests on remote main in order and report what merged and what did not."
ac_6  = "WHEN cg spec run drives the fleet THE orchestrator SHALL spawn feature managers per feature and wave workers under each manager with role, parent, branch, and base branch in their environment."

[req.3]
title = "Unified multi-branch graph and memory"
story = "As an agent in the fleet, I want one graph and one memory for the whole repository across every branch and worktree so that I see the complete picture of what every other worker is doing in real time."
ac_1  = "WHEN cg runs inside a git worktree of an already initialized repository THE tool SHALL resolve the shared project through the git common directory and use the one shared graph instead of demanding a second init."
ac_2  = "WHEN files are indexed THE rows SHALL be scoped to the branch they were seen on, and unchanged files across branches SHALL share content by hash rather than by re-parsing."
ac_3  = "WHEN a query runs without a branch flag THE result SHALL come from the current branch, and WHEN --all-branches is given THE result SHALL union every tracked branch and label each hit with its branch."
ac_4  = "WHEN a memory is written on a branch THE memory SHALL carry that branch, and WHEN the branch merges into its base THE memory SHALL be promoted to the base so decisions follow the code."
ac_5  = "WHEN cg watch runs in fleet mode THE watcher SHALL follow every registered worktree and keep each branch's slice of the graph current."
ac_6  = "WHEN cg brief runs THE output SHALL name the branch, its base, the role, and the other branches with live work."

[req.4]
title = "Jev decisions are part of Codify"
story = "As the owner of an internal tool, I want Jev decisions built into Codify as a required capability so that memories become skills, failures get triaged, and findings get ranked without a chat model."
ac_1  = "WHEN a Jev-backed command runs THE client SHALL send state and questions to the configured decision endpoint through curl, parse noul, choice, and score answers, retry on 429 and 529, and log request id, model, and cost."
ac_2  = "WHEN OPENROUTER_API_KEY is missing THE command SHALL fail with a clear message naming the variable, never silently degrade."
ac_3  = "WHEN cg memory classify runs THE tool SHALL ask Jev to class each memory as skill, decision, constraint, fact, or noise with confidence, store the class, and list the skill candidates."
ac_4  = "WHEN a skill candidate is promoted THE tool SHALL render it as a portable SKILL.md under .agents/skills with the Codify ownership marker and keep the source memory linked."
ac_5  = "WHEN a task's verify command fails THE failure SHALL be triaged by Jev into a category and a next action that is recorded with the outcome memory."
ac_6  = "WHEN guard reports findings THE findings SHALL be ranked by Jev severity, and the deterministic checks SHALL remain the only authority for pass or fail."

[req.5]
title = "Full-feature VS Code interface"
story = "As a developer, I want the extension to be the place I run the fleet from: an upgraded task UI, a real memory browser with filters and Jev classification, and a polished agent chat."
ac_1  = "WHEN the tasks view renders THE tree SHALL group by feature, section, and wave with status, owner, branch, and blockers, SHALL filter by status, wave, and owner, and SHALL offer start, done, claim, release, and open-branch actions."
ac_2  = "WHEN the memory browser opens THE panel SHALL search full text, filter by type, class, task, branch, and date, show detail with linked symbols and files, and offer supersede, forget, classify, and promote to skill."
ac_3  = "WHEN the fleet view renders THE panel SHALL show Main Gideon, feature managers, and workers with their branches, attempts, heartbeats, merge state, and open pull requests."
ac_4  = "WHEN the agent chat runs THE panel SHALL stream text and tool calls, render diffs and terminal output, show permission requests inline, support cancel, retry, session switch, and slash commands, and surface errors and cost."
ac_5  = "WHEN the extension packages THE marketplace identity, changelog, icon, and tests SHALL agree with each other."

[design]
overview = "Sync: a new syncgate module owns a single-writer index gate around cg_index. The gate takes a non-blocking flock on .codegraph/index.lock; a loser touches .codegraph/index.dirty and returns coalesced; the winner drains the dirty marker in bounded passes before releasing. A freshness window keyed by meta.last_index_at lets hooks, MCP, and spec commands skip the walk. Machine-wide slots under /tmp/codify-<uid> cap parse threads across projects, and hook syncs run at low priority. Post-scan resolution is scoped to changed file ids and touched symbol names through temp tables; --full keeps the global pass. Hooks collapse to one cg hook post-edit process. The extension coalesces refreshes and ignores its own graph.db writes. Hierarchy: workflow.kvx gains a [hierarchy] section and per-role [role.*] sections; identity gains role and parent; a new fleet module wraps git worktree, merge, gate, gh pr, and checkpoint flows over popen; the orchestrator grows a two-level slot tree. Unified graph: schema v15 adds branches, files.branch_id, memories.branch, and a content table keyed by hash; root discovery resolves worktrees to the git common dir; queries default to the current branch. Jev: a jev module builds canonical requests, runs curl, parses answers, retries, and logs cost; memory classify, failure triage, and guard ranking are its first consumers; the local_only principle becomes local_first. Extension: task tree, memory browser, fleet view, and agent chat are rebuilt on the same zero-dependency, CSP-strict webview base."

[documentation]
mode       = "auto"
status     = "pending"
audiences  = ["user", "developer"]
targets    = ["README.md", "docs/**", "CONTRIBUTING.md", "CHANGELOG.md", "editors/vscode/README.md", "editors/vscode/CHANGELOG.md"]

[tasks]
heading = "Implementation Plan: Codify v10"

[task.1]
title   = "Smart auto sync"
section = "One indexer, not fifty"
status  = "pending"

[task.1.1]
title      = "Single-writer index gate with coalescing, freshness, and slots"
status     = "done"
wave       = 1
symbols    = ["cg_index_ex", "syncgate_acquire", "syncgate_release", "syncgate_mark_dirty", "syncgate_slot_acquire"]
touches    = ["src/syncgate.c", "src/scan.c", "src/cg.h", "src/main.c", "tests/integration/25_syncgate.sh"]
verify_cmd = "make cg && CG=$PWD/cg tests/integration/25_syncgate.sh gate"
do_1       = "Add IndexOpts and cg_index_ex; keep cg_index as the blocking full-strength wrapper."
do_2       = "Take a non-blocking flock on .codegraph/index.lock; losers touch .codegraph/index.dirty and return coalesced; the winner drains the marker in bounded passes."
do_3       = "Skip the walk when meta.last_index_at is inside the caller's freshness window with nothing pending or dirty."
do_4       = "Cap workers by CG_INDEX_WORKERS and machine-wide slots under /tmp/codify-<uid>; background callers renice themselves."
do_5       = "Teach cg sync to take optional paths and report fresh, coalesced, and slot decisions in its output and --json."
reqs       = ["1.1", "1.2", "1.3"]

[task.1.2]
title      = "Incremental post-scan resolution"
status     = "done"
wave       = 1
symbols    = ["resolve_refs_scoped", "resolve_imports_scoped", "anchor_edges_scoped", "index_scope_begin"]
touches    = ["src/resolve.c", "src/scan.c", "src/cg.h", "tests/integration/25_syncgate.sh"]
verify_cmd = "make cg && CG=$PWD/cg tests/integration/25_syncgate.sh incremental && CG=$PWD/cg tests/integration/15_accuracy.sh"
do_1       = "Collect changed file ids and added or removed symbol names during the write phase into temp tables."
do_2       = "Resolve only refs in changed files plus refs anywhere that name a touched symbol; resolve imports of changed files; rebuild soft edges only for comments in changed files or naming touched symbols."
do_3       = "Keep the global pass for --full and for the pending-resolve recovery path, and keep resolution meta counters truthful by recomputing them from the table."
reqs       = ["1.4"]

[task.1.3]
title      = "Cheap callers: post-edit hook, spec, MCP, runtime, watch, and LSP"
status     = "done"
wave       = 2
requires   = ["1.1"]
symbols    = ["cmd_hook_post_edit", "runtime_workspace_revision"]
touches    = ["src/govern.c", "src/spec.c", "src/mcp.c", "src/runtime.c", "src/watch.c", "src/lsp.c", "src/main.c", "src/cg.h", "tests/integration/25_syncgate.sh"]
verify_cmd = "make cg && CG=$PWD/cg tests/integration/25_syncgate.sh callers && CG=$PWD/cg tests/integration/04_mcp.sh && CG=$PWD/cg tests/integration/22_control.sh"
do_1       = "Add cg hook post-edit reading the Claude Code hook payload from stdin and doing one targeted sync plus guard; update the Claude and git hook templates."
do_2       = "Route spec_graph_open, MCP sync_first, review, commit, and agentmd through cg_index_ex with a freshness window and bounded lock waits."
do_3       = "Batch runtime_workspace_revision into one write transaction under the index gate and skip the hash when the walk is unchanged."
do_4       = "Make watch and lsp honor the gate so they coalesce instead of racing hooks."
reqs       = ["1.1", "1.2", "1.5"]

[task.1.4]
title      = "Extension refresh coalescing and identity fix"
status     = "done"
wave       = 2
requires   = ["1.1"]
symbols    = ["scheduleRefresh", "runRefresh"]
touches    = ["editors/vscode/extension.js", "editors/vscode/agents.js", "editors/vscode/refresh.js", "editors/vscode/package.json", "editors/vscode/README.md", "editors/vscode/CHANGELOG.md", "tests/integration/14_vscode.sh", "README.md", "docs/ARCHITECTURE.md"]
verify_cmd = "make cg && CG=$PWD/cg tests/integration/14_vscode.sh"
do_1       = "Collapse afterMutation, watcher, and poll refreshes into one in-flight promise with a trailing debounce."
do_2       = "Stop watching graph.db for the extension's own writes; watch spec files and the dirty marker instead; poll at a low cadence."
do_3       = "Run spec trace only on demand and route every refresh through cg sync with a freshness window."
do_4       = "Align the marketplace identity, README, changelog, and test with codify-workflow."
reqs       = ["1.6", "5.5"]

