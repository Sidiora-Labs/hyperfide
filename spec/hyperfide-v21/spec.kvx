# Hyperfide 2.1 — the end-to-end run: finish what exists, fix what the inventory found, add the Ask primitive, the console and source tracking at scale.
# Planned 2026-10-22 from the six-agent inventory (scratchpad inventory/INVENTORY.md, published for the team). Decisions D1 to D10 below were taken by the programme owner the same day.

[meta]
feature = "hyperfide-v21"
name = "Hyperfide 2.1"
version = "2.1.0"
status = "pending"
review_date = "2026-10-22"
intro = "Complete end-to-end run over Codify and Hyperfide after the 2026-10-22 inventory: make qualification reproducible and the workflow source truthful; remove the fleet-scale traps; give agents a durable typed Ask with blocked as the waiting state; raise and answer without native prompts; expose Needs, Issues, Sandboxes and Leaders; move source tracking to Hyperfide snapshots with packet-scoped slices, an integrator merge queue and per-wave publication; requalify the hyperfide ledger; close with docs, release, changelog and human acceptance. Hyperfide feature tasks are closed through cg spec done -f hyperfide; this feature holds the work that gets them there."

[decisions]
d_1 = "D1 Qualification inputs: manifests and registrations are tracked on main; evidence and artifacts live in the S3 artifact store (artifacts/objects.ts, bucket versioning) with the local artifacts directory as a cache."
d_2 = "D2 Workflow source: CLAUDE.md, AGENTS.md and every other agent file point at spec/workflow.kvx, which is redesigned to be legible, unambiguous and contradiction-free."
d_3 = "D3 Raising an Ask: an MCP ask tool with an instruction rule is the primary path; a QUESTION classifier signal with forwarded native events is the safety net; prompts stay disabled in sandboxes."
d_4 = "D4 Waiting state: blocked, in both the service and the C spec engine."
d_5 = "D5 Spec placement: this feature (hyperfide-v21) holds the run; hyperfide's own tasks close through -f hyperfide."
d_6 = "D6 Console: the expanded VS Code extension is the console base, decided 2026-10-22 on the task 1.10 evaluation (OpenHands Agent Canvas has one shared API key in open source and duplicates the runner). Both panels and the Leaders webview live in editors/vscode; 6.10 records this and no second console surface is started."
d_7 = "D7 Storage engine: the best one by measurement; Git's object model as the store is the default, with a bake-off (5.6) before any change."
d_8 = "D8 Publication: per wave; the last wave of every feature is docs, release and changelog; the spec task file is current before every commit."
d_9 = "D9 Humans have three jobs: create the idea and the spec with the agent; provide variables and judge output; test the finished running system as the final release gate. Humans do not commit to the monorepo directly."
d_10 = "D10 Evidence pointers: keep pre-rewrite commits alive under refs/evidence/* now; re-point during requalification."

d_11 = "D11 Ask default policies, confirmed 2026-10-22: secret, variable and permission block; decision and question proceed on the recommended option and flag; deadlines and chains are set by task 3.6."
d_12 = "D12 Evidence refs: refs/evidence/* are published to origin and fetched by CI; 80_qualification_inputs.sh fails, never skips, when they are absent."
d_13 = "D13 CI secrets: CI materialises a fixture credential store for HF_CREDENTIAL_CONFIG_FILE (no secret needed) and maps the RAILWAY_TOKEN repository secret only into registrations whose required_env names HF_RAILWAY_TOKEN; the operator supplies that secret and any live-case variables; values are never printed."
d_14 = "D14 Fleet stop authority, decided 2026-10-22 on the task 2.4 Ask: POOL and ORGANISATION stops need an OPERATOR of that organisation; a DEPLOYMENT stop additionally needs the operator credential on the HYPERFIDE_DEPLOYMENT_OPERATORS allow-list, and an unset list refuses every DEPLOYMENT stop. The stop driver polls every 5000 ms by default; 0 disables it."
d_15 = "D15 Provider resolutions (task 2.1 Ask, 2026-10-22): RETAIN keeps an orphan counted as occupied but not unknown; DELETE records operator evidence and never calls the provider; RELEASE rejects the intent and hands its reservations to admission as RELEASE_PENDING; RETRY reconciles again with capacity held. Overdue items are durable rows in provider_resolution_asks until 3.1 migrates them. HYPERFIDE_PROVIDER_RESOLUTION_WINDOW_SECONDS has no code default; the operator sets it, 3600 recommended."
d_16 = "D16 Railway adoption (task 2.2 Ask): the create-time marker HF_PROVISION_OPERATION_ID read through sandboxExec is adoption evidence for a lost native id; authenticated enrollment still gates readiness."
d_17 = "D17 Secret references (task 2.8 Ask): the task packet names every variable (env_refs NAME to secret-ref:ID) and the pool profile is only an allowlist; admission writes env_refs in task 2.17."
d_18 = "D18 Object store and CI live cases (tasks 2.11 and 2.14 Asks): missing_region is STORE while mirrors are stood up; provisioner preflight warns, does not block, without HF_SLICE_SOURCE_CONFIG; the store URL, the per-region mirror URLs and the mirror refresh owner are open operator variables. No live Railway CI case is registered until a throwaway environment exists; the secret gate stays as built."
d_19 = "D19 Worker runtime, decided 2026-10-22: task workers run as local worktree agents on the supervising host through wave 3; at the wave 4 closure (Asks raised from sandboxes, answers reaching the agent, native events leaving the sandbox) the control service is stood up on Railway against the existing PostgreSQL and wave 5 onward runs in Railway sandboxes, which is also the first end-to-end test of the running system (D9)."
d_20 = "D20 Throughput, decided 2026-10-22 under the programme owner's instruction to parallelise: a task launches as soon as every task it requires is done on main, regardless of wave; wave closure (push and independent review) stays per wave; verified review findings become fix tasks in the current wave (3.10 to 3.13) instead of notes; the Railway control service and sandbox workers start as soon as 3.10, 4.2 and 4.4 are done rather than at the wave 4 closure (the D19 gate unchanged, the ceremony dropped)."
d_21 = "D21 Sandbox worker runtime, decided 2026-10-22 by the programme owner: Railway sandbox workers run Codex (approvalPolicy never, the codify MCP server with the ask tools injected, 4.3); Claude Code remains the local worktree and editor connector; the runtime sentence of D19 reads accordingly."
d_22 = "D22 Railway sandbox fleet now. A hand-built toolkit on the Railway sandbox SDK (4.10) stands the fleet up from the main working tree ahead of 4.2 and 4.4, on the base checkpoint of the earlier Paxeer fleet, running qualification jobs and Codex workers under D21; the 4.3 provider adopts the same checkpoint when it lands. Decided 2026-10-22 by the owner, who ordered one hundred sandboxes and every task in parallel."
d_23 = "D23 Hyperfide requalification runs in the hyperfide feature's own dependency order, not in the 7.1 to 7.7 grouping, which stays a set of reporting buckets. The fleet takes the 125 tasks layer by layer (29 layers computed from the feature's requires, the widest holds 9), one sandbox per task from the base checkpoint; every job re-pins the task manifest to the built tree, then runs cg spec start and cg spec done for the hyperfide feature with the PostgreSQL environment set; the supervisor folds each layer's status lines, manifests, campaign artifacts, evidence index and refs/evidence into main under the lane lock before the next layer starts. The dependency graph bounds the parallelism, not the sandbox count. Taken by the supervisor under D11 on 2026-10-22 after the 7.1 worker and a sandbox smoke on 11.2 showed the grouping deadlocks against requires and the pinned manifests are stale."
[req.1]
title = "Reproducible qualification and one truthful workflow source"
story = "As an engineer on the team of four, I need a fresh clone, CI and a remote worker to qualify the same way the main host does, and one workflow source that agents can read without contradiction."
ac_1 = "Every verify_cmd input (manifests, registrations, cases, registry) SHALL be tracked on main; evidence and artifacts SHALL be retrievable from the S3 artifact store by receipt when absent locally, with the local artifacts directory acting only as a cache."
ac_2 = "Evidence commits referenced by any evidence index SHALL stay reachable under refs/evidence/* until requalification re-points them."
ac_3 = "spec/workflow.kvx SHALL be the single workflow source: legible, free of contradiction with the Makefile and the programme policy, and declaring the human roles, the blocked status, the Ask kinds and the publication cadence. CLAUDE.md, AGENTS.md and every other generated agent file SHALL contain only a pointer to it and the active feature."
ac_4 = "The shipped control policy and bootstrap inputs SHALL take a clean host to a running control, dispatch and provisioner stack without test-injected grants or ignored files; preflight SHALL name every missing variable before anything is written."
ac_5 = "CI SHALL typecheck, build and syntax-check the service and deploy scripts and run the Postgres-backed case suite; a skipped case SHALL print SKIP, never PASS."

[req.2]
title = "Fleet-scale safety at one hundred sandboxes"
story = "As the operator of a 100-sandbox Railway fleet, I need capacity, stop and escalation paths that do not wedge silently."
ac_1 = "An orphan or quarantined provisioning intent SHALL have an operator resolution path that releases capacity; unresolved items SHALL surface as Asks, never as permanently unknown capacity."
ac_2 = "Railway SHALL have an ownership probe, a 429 backoff before UNKNOWN, and a live quota observer; attestation expiry SHALL warn before it lapses."
ac_3 = "Stop SHALL drive its own loop, support pool, organisation and deployment scopes, and paginate past 1,000 debts."
ac_4 = "The local supervisor SHALL exempt attempts with an open Ask from stall and budget kills, escalate to the configured main agent, and have no fixed task cap."
ac_5 = "Finding events SHALL reach a consumer; every agent launch SHALL carry the secret references its task or profile declares, and a supplied variable SHALL reach a running sandbox by relaunch with references."
ac_6 = "The supervisory host and the issue watcher SHALL deploy from the shipped units and templates on a clean host."

[req.3]
title = "The Ask primitive"
story = "As an agent that needs a variable, a permission, a decision or an answer, I need a durable typed place to park the request so a human sees it in a panel instead of the output stream."
ac_1 = "An Ask SHALL be a durable row with kind (secret, variable, permission, decision, question), options with a recommended choice, deadline, default policy (block or proceed-and-flag), escalation chain and task, attempt, session and sandbox references; raising and answering SHALL be actions available to every role the policy allows and delivered to operators, not only to the leader."
ac_2 = "A task whose attempt has an open blocking Ask SHALL be in status blocked: not eligible for dependants, preserved by stop, exempt from stall, and carrying the Ask reference; blocked SHALL be a declared status in the workflow and the C spec engine."
ac_3 = "The C core SHALL generalise fleet approvals into the same Ask shape with raise, answer and list verbs, MCP tools, events and a snapshot section; the Hyperfide client SHALL expose the Ask routes under the route contract test."
ac_4 = "A per-kind policy SHALL decide block versus proceed-and-flag and the deadline; a default taken on expiry SHALL be recorded as a decision with the Ask it replaced."

[req.4]
title = "Raising and answering without prompts"
story = "As the team, we keep native prompts disabled in sandboxes and still want every question an agent would have asked to reach us."
ac_1 = "The native-stream classifier SHALL recognise Claude AskUserQuestion and Codex requestUserInput as a QUESTION signal and write an Ask; classified native events SHALL be forwarded out of the sandbox by the launcher and ingested by the runner."
ac_2 = "An answer SHALL be delivered to a leader through session input and to a worker through instructions, with a re-wake path for a worker that made no edits while blocked."
ac_3 = "Notifications SHALL have producers for Ask raised, Ask expired and repair escalated, with an operator target; leader queue, external intake and escalated repairs SHALL have readers."
ac_4 = "Open programme decisions and expiring attestations, permits and drain deadlines SHALL be seeded as Asks."

[req.5]
title = "Console: Needs, Issues, Sandboxes, Leaders"
story = "As one of four humans watching hundreds of agents, I need four panels and two numbers, on whichever console base the evaluation chooses."
ac_1 = "A read model SHALL expose open Asks, pending human intents, admission escalations, leader queue, external intake and escalated repairs (Needs and Issues), a sandbox inventory joined across sandboxes, slots, runners, identity status and attempts (Sandboxes), and leaders from agent sessions (Leaders), each with freshness."
ac_2 = "The cg client SHALL expose console and needs verbs and list the distributed verbs in help."
ac_3 = "Metrics SHALL report decisions taken by default per hundred tasks, median Ask-to-answer time and bytes materialised per sandbox."
ac_4 = "The console base SHALL be chosen by a recorded evaluation of an OpenHands fork against an expanded VS Code extension; the editor SHALL in any case receive pushed cards, a global Ask registry with badge and notification, Needs, Issues, Sandboxes and Leaders views, reconnect snapshots, unique agent names and a current VSIX."

[req.6]
title = "Source tracking at scale"
story = "As a team working one multi-million-line monorepo with thousands of agent snapshots a day, we stop using Git as the workflow: Hyperfide snapshots are the unit of record, sandboxes get only what their task needs, and GitHub receives per-wave publications."
ac_1 = "Workers SHALL materialise packet-scoped slices from an internal object store mirrored near each provider; full-tree materialisation SHALL require a recorded reason; local fleet workers SHALL use sparse worktrees from the same manifest."
ac_2 = "A worker result SHALL be captured as a tree identity plus checkpoint in hyperfide.source_snapshots with base, slice digest and diff statistics; agents SHALL not run git."
ac_3 = "The integrator SHALL fold qualified result trees onto an internal trunk in touch-disjoint batches with tree-level three-way merge, batch requalification and bisect on failure; a conflict SHALL become a decision Ask. Watchers and findings SHALL read the internal trunk."
ac_4 = "Publication SHALL be one squashed commit per task batched per wave behind the release barrier, with snapshot identities in trailers; the final wave of every feature SHALL be docs, release and changelog; the spec task file SHALL be current before every commit."
ac_5 = "The built-in snapshot store SHALL keep a stat cache, serve local and offline mode only, and be marked non-authoritative in distributed mode; the storage engine choice SHALL be confirmed by a measured bake-off, with Git's object model as the default."

[req.7]
title = "Requalification and truth"
story = "As the programme owner, I need the ledger to say what the code does."
ac_1 = "Every hyperfide task with passing current receipts SHALL be marked done; every stale receipt SHALL be requalified in wave order with its evidence index re-pointed to the rewritten commits."
ac_2 = "Tasks with partial code or missing evidence (1.4, 2.1, 10.2, 27.1, 27.3, 28.4) SHALL be fixed and qualified or left pending with the reason recorded."
ac_3 = "The Postgres-backed case suite SHALL run for governance and core tasks with real evidence; dead modules and tables SHALL be removed after confirmation; the remaining full-case registrations SHALL be written."

[req.8]
title = "Closure: docs, release, changelog and human acceptance"
story = "As the humans, our three jobs are the spec, the inputs and judgement, and testing the finished system; that final test is the release gate."
ac_1 = "Documentation SHALL match the evidence: operations status table, README counts and claims, every operator variable, install arguments and policy examples; the docs claims ledger SHALL be usable and docs check SHALL be read-only or documented as not."
ac_2 = "A release SHALL be built, signed and published through the publication path with a current VSIX and dist; the changelog and codemap SHALL be regenerated by the programme owner."
ac_3 = "The feature SHALL close only on an answered human acceptance Ask recording a test of the running system, not of the code."

[documentation]
mode = "manual"
status = "pending"
audiences = ["user", "developer", "operator"]
targets = ["README.md", "docs/**", "editors/vscode/README.md", "spec/hyperfide-v21/**", "spec/workflow.kvx"]

[tasks]
heading = "Hyperfide 2.1 — eight waves; waves 2 to 5 carry the source-tracking fleet in parallel"

[task.1.1]
title = "Re-track qualification inputs and keep evidence commits reachable"
status = "done"
wave = 1
requires = []
touches = [".gitignore", "tests/hyperfide/manifests/tasks", "tests/hyperfide/registrations", "tests/integration/80_qualification_inputs.sh"]
verify_cmd = "bash tests/integration/80_qualification_inputs.sh"
do_1 = "Remove tests/hyperfide/manifests/tasks/ and tests/hyperfide/registrations/ from .gitignore and track every file in them; keep artifacts/, spec/hyperfide/evidence/ and deploy/hyperfide/identity/ ignored except as 1.6 says."
do_2 = "For every commit named by an evidence-index.json under artifacts/hyperfide/tasks, create refs/evidence/<task>/<n> so the loose objects survive gc; record the mapping in tests/hyperfide/evidence-refs.json."
do_3 = "80_qualification_inputs.sh asserts both directories are tracked with the expected counts, that no verify_cmd in spec/hyperfide/spec.kvx names an untracked file, and that each evidence ref resolves."
do_4 = "Implement only this task in an isolated task worktree. Run real positive and negative checks, keep the task status in spec/hyperfide-v21/spec.kvx current before every commit, tag the commit [spec:hyperfide-v21/<id>], and raise an Ask (fleet approval until 3.4 lands) for any variable, permission or decision you would otherwise default."
reqs = ["1.1", "1.2"]
owner = "qualification"

[task.1.2]
title = "Evidence and artifacts through the S3 artifact store"
status = "done"
wave = 1
requires = ["1.1"]
touches = ["tests/hyperfide/qualify.py", "tests/hyperfide/check-evidence.py", "services/hyperfide/src/artifacts/objects.ts", "docs/hyperfide/operations.md", "tests/hyperfide/cases/v21/1_2.py", "tests/hyperfide/evidence_store.py"]
verify_cmd = "npm --prefix services/hyperfide run check && python3 tests/hyperfide/cases/v21/1_2.py"
do_1 = "When artifacts/hyperfide/tasks/<id> is absent, qualify.py resolves the task's evidence by receipt from the artifact store (artifact.object.read, artifact.manifest.read) into the local cache before checking; the local directory is a cache, never the authority."
do_2 = "Publishing an evidence index commits it with artifact.manifest.commit under a retention class the operations manual documents; document bucket versioning and the credential variables the store reads."
do_3 = "1_2.py exercises absent-local resolution, digest mismatch refusal and a missing receipt against the s3-v1 backend contract with a stub endpoint."
do_4 = "Implement only this task in an isolated task worktree. Run real positive and negative checks, keep the task status in spec/hyperfide-v21/spec.kvx current before every commit, tag the commit [spec:hyperfide-v21/<id>], and raise an Ask (fleet approval until 3.4 lands) for any variable, permission or decision you would otherwise default."
reqs = ["1.1"]
owner = "qualification"

[task.1.3]
title = "One legible workflow source and pointer-only agent files"
status = "done"
wave = 1
requires = []
touches = ["spec/workflow.kvx", "src/spec.c", "src/agent.c", "tests/fixtures/specrepo/CLAUDE.md", "tests/fixtures/specrepo/.cursor/rules/spec-workflow.mdc", "tests/integration/81_workflow_pointer.sh"]
# CLAUDE.md and AGENTS.md are gitignored render outputs: no commit can evidence them, so `spec render --check` in verify_cmd proves them instead. Present outputs must already be current; only a fresh clone, which has neither, renders them first (task 3.13).
verify_cmd = "make -j2 cg && CG=$PWD/cg bash tests/integration/81_workflow_pointer.sh && { ./cg spec render --check || { test ! -e CLAUDE.md && test ! -e AGENTS.md && ./cg spec render && ./cg spec render --check; }; }"
do_1 = "Rewrite spec/workflow.kvx so no two statements contradict: the dependency rule names sqlite, libc, curl and crypto for the binary and declared pinned TypeScript dependencies for the services; status_values gain blocked; add [human] (three jobs: spec with the agent, inputs and judgement, final system test as the release gate), [asks] (five kinds, default policies), [publication] (per wave, final wave docs/release/changelog, task file current before every commit)."
do_2 = "build_brief emits only: the pointer sentence, the active feature path, the loop, and where to find the rules; no principle or rule text is duplicated into generated files. Regenerate CLAUDE.md and AGENTS.md; make cg agentmd's context file point at the kvx the same way."
do_3 = "81_workflow_pointer.sh asserts the generated files contain the pointer and nothing else, that the kvx parses, and that no statement in [principle] or [hard_rules] names a dependency the Makefile does not link."
do_4 = "Implement only this task in an isolated task worktree. Run real positive and negative checks, keep the task status in spec/hyperfide-v21/spec.kvx current before every commit, tag the commit [spec:hyperfide-v21/<id>], and raise an Ask (fleet approval until 3.4 lands) for any variable, permission or decision you would otherwise default."
reqs = ["1.3"]
owner = "workflow"

[task.1.4]
title = "Rebuild the service dist and refuse stale builds"
status = "done"
wave = 1
requires = []
touches = ["scripts/release.sh", "deploy/hyperfide/install-service.mjs", "tests/hyperfide/cases/v21/1_4.py", "services/hyperfide/package.json", "deploy/hyperfide/dist-stamp.mjs"]
verify_cmd = "npm --prefix services/hyperfide run build && python3 tests/hyperfide/cases/v21/1_4.py"
do_1 = "Rebuild dist from the current source so recovery/bootstrap_fence.js exists; add a stale-dist check (source digest recorded at build, compared at install and release) that fails install-service and release.sh when dist is older than src."
do_2 = "1_4.py builds, tampers a source file, and asserts the check refuses."
do_3 = "Implement only this task in an isolated task worktree. Run real positive and negative checks, keep the task status in spec/hyperfide-v21/spec.kvx current before every commit, tag the commit [spec:hyperfide-v21/<id>], and raise an Ask (fleet approval until 3.4 lands) for any variable, permission or decision you would otherwise default."
reqs = ["1.4"]
owner = "deployment"

[task.1.5]
title = "Ship activation and adoption grants in the control policy"
status = "done"
wave = 1
requires = ["1.1"]
touches = ["deploy/hyperfide/policies/control.example.json", "tests/hyperfide/cases/tasks/29_1.py", "tests/hyperfide/cases/tasks/29_5.py", "tests/hyperfide/cases/tasks/29_11.py", "tests/hyperfide/cases/tasks/29_12.py", "tests/hyperfide/support/withpg.py", "tests/hyperfide/proof_relocation.py", "tests/hyperfide/test_inspect_proof.py", "tests/hyperfide/manifests/tasks/29.1.json", "tests/hyperfide/manifests/tasks/29.5.json", "tests/hyperfide/manifests/tasks/29.9.json", "tests/hyperfide/manifests/tasks/29.11.json", "tests/hyperfide/manifests/tasks/29.12.json", "tests/hyperfide/manifests/tasks/27.1.json", "tests/hyperfide/manifests/tasks/28.3.json"]
verify_cmd = "python3 tests/hyperfide/support/withpg.py -- python3 tests/hyperfide/qualify.py --case V-062 --manifest tests/hyperfide/manifests/tasks/29.5.json && python3 tests/hyperfide/support/withpg.py -- python3 tests/hyperfide/qualify.py --case V-058 --manifest tests/hyperfide/manifests/tasks/29.1.json"
do_1 = "Add storage.authority.activate and storage.authority.adopt to the shipped control policy; remove the test-side injection in the four 29.x cases so they qualify against the shipped files."
do_2 = "Re-run V-058 and record the receipt; the 29.5 ledger row changes from done-without-shipped-policy to done."
do_3 = "Implement only this task in an isolated task worktree. Run real positive and negative checks, keep the task status in spec/hyperfide-v21/spec.kvx current before every commit, tag the commit [spec:hyperfide-v21/<id>], and raise an Ask (fleet approval until 3.4 lands) for any variable, permission or decision you would otherwise default."
reqs = ["1.4"]
owner = "deployment"

[task.1.6]
title = "Bootstrap a clean host without ignored inputs"
status = "done"
wave = 1
requires = []
touches = [".gitignore", "deploy/hyperfide/bootstrap-host.mjs", "deploy/hyperfide/identity", "deploy/hyperfide/bootstrap-fence.mjs", "tests/hyperfide/cases/v21/1_6.py"]
verify_cmd = "node --check deploy/hyperfide/bootstrap-host.mjs && python3 tests/hyperfide/cases/v21/1_6.py"
