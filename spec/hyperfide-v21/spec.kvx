[task.1.9]
title = "Client route contract test"
status = "done"
wave = 1
requires = []
touches = ["src/hyperfide/client.c", "services/hyperfide/components", "tests/integration/83_route_contract.sh", "tests/fixtures/route_contract/server_only.txt"]
verify_cmd = "make -j2 cg && CG=$PWD/cg bash tests/integration/83_route_contract.sh"
do_1 = "83_route_contract.sh extracts every route the C client declares and every action the component manifests export and fails on any route without an action or action without a route, naming them."
do_2 = "Keep the test data-driven so 3.7 extends it with the Ask routes."
do_3 = "Implement only this task in an isolated task worktree. Run real positive and negative checks, keep the task status in spec/hyperfide-v21/spec.kvx current before every commit, tag the commit [spec:hyperfide-v21/<id>], and raise an Ask (fleet approval until 3.4 lands) for any variable, permission or decision you would otherwise default."
reqs = ["1.1"]
owner = "client"

[task.1.10]
title = "Evaluate OpenHands as the console base"
status = "done"
wave = 1
