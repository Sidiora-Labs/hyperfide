do_1       = "Add fleet_runs and fleet_nodes; move the fleet loop into supervisor_tick over persisted state; keep cg spec run --fleet as a foreground alias."
do_2       = "cg fleet up detaches a supervisor with a pid file; down drains, pause freezes spawning, resume continues; --resume reattaches live children by pid and start time."
do_3       = "Approval gates stop at land, pr, retry-exhausted, or drift and wait for cg fleet approve <id>."
