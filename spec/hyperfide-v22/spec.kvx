do_2 = "Reinstall with pnpm (no frozen lockfile) so the lockfile drops the removed importers, then prove it settled with a frozen install. Remove dependencies that only those packages used."
do_3 = "0_4.sh asserts the directories are absent, no tracked file under platform/ imports the removed package names or references their former domain, `pnpm -C platform install --frozen-lockfile` succeeds and `pnpm -C platform typecheck` succeeds."
