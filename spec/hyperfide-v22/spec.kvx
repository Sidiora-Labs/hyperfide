# hyperfide-v22 — the master agent orchestration system: the ported platform runtime under platform/, governed by Hyperfide.
# Requirements, decisions, design, then the task list. Every task runs in its own Railway sandbox; this host runs only the
# orchestrator and one feature manager per wave.

[meta]
feature     = "hyperfide-v22"
name        = "Hyperfide 2.2: platform runtime under Hyperfide authority"
version     = "2.2.0-dev"
status      = "in_progress"
review_date = "2026-10-23"
intro       = "A multi-surface agent platform (server, web app, desktop, host daemon, provider bridges, plugin SDK and plugins) was ported verbatim under platform/ at ce200df4. This feature renames it to Hyperfide identity, wires the hyperfide binary, spec, Asks, qualification and fleet into it as plugins, moves authority state to PostgreSQL, and closes with slices, memory and a release. The ported runtime serves; Hyperfide's spec, Asks, qualification and graph govern."

[decisions]
d_1 = "RULED by the owner on 2026-10-23: Hyperfide stays the repository. The ported runtime lives under platform/ in this repository and carries Hyperfide identity throughout; nothing is renamed at the repository level."
d_2 = "RULED by the owner on 2026-10-23: the ported code is attributed by its MIT licence in licenses/bb/LICENSE and nowhere else; no other mention of its former name, scope, domain or identifiers remains in the repository once wave 0 closes; no upstream compatibility is kept and no rebases happen."
d_3 = "RULED by the owner on 2026-10-23: every task of every wave runs in a Railway sandbox (Blaxel as the fallback), launched as soon as its requires are merged, so waves overlap; this host runs only the orchestrator and one feature manager per wave. No local worker agents."
d_4 = "Flagged (proceeding on the recommendation): hyperfide-v21 is frozen at 38067d0d with its failure ledger; its fleet rules D20 to D27 and the deploy/hyperfide/sandbox toolkit are inputs to waves 0 and 5."
d_5 = "Flagged (proceeding on the recommendation): plugin-private SQLite is the store through wave 5; the PostgreSQL authority arrives at wave 6 behind the same plugin storage interface."
d_6 = "Flagged (proceeding on the recommendation): third-party telemetry and the hosted connect gates are removed, not disabled; git worktrees stay the environment through wave 6 and slices arrive at wave 7."
d_7 = "Flagged (proceeding on the recommendation): the platform runs on the repository's existing Node 24 pin (its engines field allows it); there is no second Node pin and no .nvmrc for 22."
d_8 = "Flagged (proceeding on the recommendation): the ported command-line tool becomes the hyperfide-platform binary of platform/apps/cli and is folded under the C front door as `hyperfide platform <args>`; the C binary stays the single entry point."
d_10 = "Launch policy: a task launches when every task it requires is merged into the integration branch with status implemented or done; qualification (`hyperfide spec done` in a sandbox) follows the merge and never holds dependants, as hyperfide-v21 ruled. Tasks that edit existing platform code (0.3, 0.5, 0.6) run beside the scope rename 0.2 and the final sweep 0.7 reconciles; every task that writes new platform TypeScript requires 0.2 so it is born in the @hyperfide scope."
d_9 = "Flagged (proceeding on the recommendation): the exact former identifiers exist in the repository only inside the encoded pattern list of tests/hyperfide/cases/v22/identity_gate.py, so that the repository text itself stays clean; the rename map under platform/tools/rename is deleted by task 0.7 once applied."

[req.1]
title = "The ported runtime builds, tests and ships under Hyperfide identity"
story = "As the owner, I need the ported platform to be ours in name and in build: one pnpm workspace under platform/ that installs, typechecks, builds and tests green on Node 24 with Hyperfide names everywhere, attributed only by its licence folder."
ac_1 = "platform/ SHALL install with a frozen lockfile, typecheck, build and pass its unit tests on Node 24 with every package in the @hyperfide scope, the CLI named hyperfide-platform, environment variables prefixed HYPERFIDE_, the data directory ~/.hyperfide and plugin ids prefixed hyperfide-."
ac_2 = "An identity gate SHALL scan every tracked file outside licenses/bb and fail on any former product name, package scope, domain, environment prefix, data directory or plugin id; it SHALL pass at the wave 0 close and stay in every later verify_cmd that touches platform/."
ac_3 = "The marketing site, the hosted connect gates and their tunnel packages, the hosted account plugin and all third-party telemetry SHALL be absent from the tree, with no dependent left importing them."
ac_4 = "The sandbox image steps, the Makefile targets and a CI workflow SHALL build the platform the same way a sandbox does, from the repository's own toolkit, with timings recorded in docs/hyperfide/operations.md."

[req.2]
title = "The hyperfide binary and graph are first-class inside the platform"
story = "As an operator running agents through the platform, I need every worker to see the graph the way a local engineer does: the binary verified per host, survey and context before edits, index status visible, and the editor backed by the binary's language server."
ac_1 = "`hyperfide platform <args>` SHALL run the platform CLI from the C front door with the same exit code and streams, and `hyperfide platform --help` SHALL list its commands."
ac_2 = "The host daemon SHALL locate and verify the hyperfide binary (path, version, digest) and the app SHALL show binary and index status for the host."
ac_3 = "A thread started in a repository with .codegraph SHALL receive the codify MCP server with CG_TASK set and a skill that teaches survey, then context, before editing, for the Claude Code and Codex providers."
ac_4 = "The editor plugin SHALL use `hyperfide lsp` through the host daemon for definitions, references and hover."
ac_5 = "The graph index SHALL cover platform/ with a full `hyperfide init` under 45 minutes in a sandbox, with the ignore rules and worker count that achieve it recorded."

[req.3]
title = "The spec is the task authority inside the platform"
story = "As a feature manager, I need the kvx spec to drive the platform: a board of waves and tasks, a worker thread per task with its packet, status transitions written back by the binary, and the editor extension reduced to a language client."
ac_1 = "A spec plugin SHALL expose features, tasks, waves, statuses, requires and touches from spec.kvx over RPC with realtime updates when the file changes."
ac_2 = "The task board SHALL show tasks by wave and status with detail (criteria, touches, verify_cmd, requires) and actions start and implemented that go through `hyperfide spec`."
ac_3 = "Run task SHALL create a thread in a managed environment with the task packet, CG_TASK and the chosen provider, and a finished thread SHALL update the task status."
ac_4 = "`hyperfide platform spec next|start|implemented|status` SHALL work from the front door."
ac_5 = "editors/vscode SHALL keep only the language client and commands that open the platform app, and tests/integration/14_vscode.sh SHALL pass."

[req.4]
title = "Asks reach humans and gate threads"
story = "As the owner, I need every missing secret, variable or permission to stop the thread until I answer, every decision or question to proceed on the recommendation and be flagged, and to see all of it in one inbox with notifications."
ac_1 = "An asks plugin SHALL mirror `hyperfide ask` (kinds secret, variable, permission, decision, question; status; deadlines; recommendation) over RPC with realtime updates and write answers back through the binary."
ac_2 = "A blocking Ask raised from a thread SHALL pause that thread; the answer SHALL resume it with the answer injected; decision and question Asks SHALL proceed and annotate the thread as flagged."
ac_3 = "The inbox SHALL list open Asks across tasks with kind, deadline and recommended option; secret answers SHALL be stored as secret references through the secrets plugin, never as values in the spec or logs."
ac_4 = "A new blocking Ask SHALL raise a push notification, and an agent's in-thread question SHALL be a question Ask."

[req.5]
title = "Qualification is proven inside the platform"
story = "As a feature manager, I need verify lanes, receipts, an independent checker and wave closure to run through the platform so that done means proven and publication follows the wave cadence."
ac_1 = "A qualify plugin SHALL run a task's verify_cmd in an environment with the pinned toolchain, one lane per graph lock, streaming logs and recording exit code and duration."
ac_2 = "Each lane SHALL produce a receipt and evidence bundle readable from the task detail, and closure_check SHALL run against them."
ac_3 = "A checker thread with a provider different from the worker's SHALL review an implemented task against its criteria and diff, and its findings SHALL become fix tasks in the current wave."
ac_4 = "Wave closure SHALL require every task done, checker pass and lanes green; publication SHALL squash per task and publish per wave, and SHALL push only after an operator permission Ask is answered."

[req.6]
title = "The fleet is a platform capability"
story = "As the owner, I need one task per sandbox across Railway and Blaxel, launched by dependency, budgeted against gateway limits, collected and integrated automatically, and visible on a dashboard."
ac_1 = "A Railway machine provider SHALL create from a checkpoint, exec, read and write files, checkpoint and destroy, with credentials from the secrets plugin under HYPERFIDE_RAILWAY_API_TOKEN and HYPERFIDE_RAILWAY_ENV_ID."
ac_2 = "A Blaxel machine provider SHALL meet the same contract with a bootstrap for its Alpine image."
ac_3 = "An image builder SHALL turn a repository commit into a checkpoint through the recorded base steps and record the checkpoint and commit."
ac_4 = "The dispatcher SHALL launch every task whose requires are merged, one per machine, under a concurrency cap, per-key gateway budget and 429 backoff, retrying once on another machine."
ac_5 = "Results SHALL land as local branches, merge into the integration branch with conflict detection, lockfile regeneration and spec reconciliation, and a duplicate task header SHALL fail the merge."
ac_6 = "The dashboard SHALL show machines, jobs, budget state and per-task timelines with log tails."

[req.7]
title = "Authority state lives in PostgreSQL behind the control plane"
story = "As an operator of several hosts, I need the platform's storage on PostgreSQL, identities and receipts from the Hyperfide control plane, and hosts enrolled through machine providers."
ac_1 = "The platform server SHALL run on PostgreSQL or SQLite by configuration with the same migrations tested on both."
ac_2 = "The platform SHALL authenticate operators and record receipts through services/hyperfide under HYPERFIDE_AUTHORITY_URL, with the operator allow-list honoured."
ac_3 = "Spec, asks, qualify and dispatch plugin state SHALL move to the authority schema with migration scripts, with an embedded PostgreSQL fallback for a single host."
ac_4 = "Several host daemons SHALL register with one server and machine providers SHALL enroll sandboxes as hosts that the dispatcher schedules across."

[req.8]
title = "Slices, memory and a release close the feature"
story = "As the owner, I need the source-tracking direction started, durable memory shared between workers, documentation that matches, a release, and my own two gates: the changelog and the full-system test."
ac_1 = "An environment provider backed by hyperfide snapshots and slices SHALL be selectable per repository, with Git used only for publishing."
ac_2 = "The memory plugin SHALL read and write `hyperfide remember` and `hyperfide recall` scoped per task, and recalled decisions SHALL enter worker packets."
ac_3 = "docs/hyperfide/platform.md, operations.md and platform/docs SHALL describe the merged system truthfully, checked by the docs ledger."
ac_4 = "Release 2.2.0 SHALL ship the binary, the service, the platform server, app and host daemon artifacts and the VSIX with smoke tests."
ac_5 = "The owner SHALL regenerate CHANGELOG.md and CODEMAP.md and run the full system from board to qualified task through a Railway sandbox before the feature closes."

[design]
overview = "Four layers. Surfaces (ported app, desktop, mobile, CLI under the C front door) and execution (ported server, host daemons, provider bridges, environments and machines) come from platform/. Authority (spec, asks, qualify, dispatch) and proof (graph, receipts, closure) come from Hyperfide as platform plugins that call the hyperfide binary and, from wave 6, the services/hyperfide control plane on PostgreSQL. Wave 0 renames and strips; wave 1 wires the binary; waves 2 to 4 add the authority plugins; wave 5 makes the fleet a capability; wave 6 moves state to the authority; wave 7 starts slices and memory and releases. Dependencies, not wave numbers, decide launch order."
identity = "Hyperfide names only: scope @hyperfide/*, CLI hyperfide-platform under `hyperfide platform`, environment prefix HYPERFIDE_, data directory ~/.hyperfide, plugin ids hyperfide-*, product name Hyperfide, domain hyperfide.dev where a domain is unavoidable. The former identifiers are listed once, encoded, in tests/hyperfide/cases/v22/identity_gate.py; every verify_cmd that touches platform/ runs the gate on the files it changed."
fleet = "Each task runs as a Codex job on a Railway sandbox from the checkpoint built by deploy/hyperfide/sandbox from the integration branch: prepare rebuilds cg and the service, reinstalls platform dependencies when the lockfile moved, the worker implements only its task, runs its verify_cmd until it passes, sets status implemented and commits once; the result returns as a bundle and lands as sandbox/<id>; the wave's feature manager reviews, merges into the integration branch and marks done after qualification in a sandbox."
verify = "Every task owns a case under tests/hyperfide/cases/v22/ (bash or python) that runs the real checks named in its do lines; platform packages are checked with turbo typecheck and test filtered by directory; integration scripts live under tests/integration with numbers from 99 upwards."

[documentation]
mode = "manual"
status = "pending"
audiences = ["user", "developer", "operator"]
targets = ["README.md", "docs/**", "platform/docs/**", "platform/README.md", "editors/vscode/README.md", "deploy/hyperfide/sandbox/README.md", "spec/hyperfide-v22/**"]

[tasks]
heading = "Implementation Plan: hyperfide-v22"

# ── Wave 0: port and identity ─────────────────────────────────────────────────

[task.0.1]
title = "Rename map and codemod"
status = "done"
wave = 0
requires = []
touches = ["platform/tools/rename/map.json", "platform/tools/rename/apply.mjs", "platform/tools/rename/README.md", "tests/hyperfide/cases/v22/0_1.sh", "tests/hyperfide/cases/v22/fixtures/rename/**"]
verify_cmd = "bash tests/hyperfide/cases/v22/0_1.sh"
do_1 = "Write platform/tools/rename/map.json: an ordered list of rules {from, to, kind, paths, exclude} covering the former package scope to @hyperfide/, the former CLI name to hyperfide-platform, the former environment prefix to HYPERFIDE_, the former data directory to .hyperfide, former plugin ids and package directory names to hyperfide-* equivalents, the former product name and domains in strings and docs, and the telemetry environment flag. Kinds: identifier (word-boundary), path (directory rename), text (docs and strings). Derive the complete list from the tree itself (grep every occurrence class and record the counts in README.md) so nothing is left to a later guess."
do_2 = "Write platform/tools/rename/apply.mjs (Node 24, no dependencies): --dry-run prints a JSON report of replacements per rule and per file and planned directory renames; --apply performs text replacements and git mv for path rules, skipping node_modules, dist, .turbo and licenses/; running it twice is a no-op. Path rules run after identifier rules; the lockfile is never edited by hand (the applying task reinstalls)."
do_3 = "tests/hyperfide/cases/v22/0_1.sh builds a fixture tree under tests/hyperfide/cases/v22/fixtures/rename with every rule kind, applies the codemod, asserts the expected tree and contents, asserts idempotence, and runs --dry-run against platform/ asserting the report covers all rule kinds with non-zero counts."
reqs = ["1.1"]
owner = "identity"

[task.0.2]
title = "Apply the package scope rename across the workspace"
status = "implemented"
wave = 0
requires = ["0.1", "0.4"]
touches = ["platform/**", "tests/hyperfide/cases/v22/0_2.sh"]
verify_cmd = "bash tests/hyperfide/cases/v22/0_2.sh"
do_1 = "Apply the identifier rules of the rename map for the package scope and package names to every manifest, tsconfig path, import, turbo filter, vitest config, script and document under platform/ (directory renames stay for 0.7). Update root package.json scripts and filters accordingly."
do_2 = "Reinstall with pnpm (no frozen lockfile) so platform/pnpm-lock.yaml follows the new names, then install again with --frozen-lockfile to prove it is settled. Fix every typecheck error the rename surfaces without changing behaviour."
do_3 = "0_2.sh asserts: no file under platform/ outside node_modules contains the former scope; `pnpm -C platform install --frozen-lockfile` succeeds; `pnpm -C platform typecheck` succeeds; `pnpm -C platform exec turbo run test --filter=./packages/plugin-sdk --filter=./packages/config --filter=./apps/server` passes."
reqs = ["1.1"]
owner = "identity"

[task.0.3]
title = "Environment, data directory and CLI identity"
status = "done"
wave = 0
requires = []
touches = ["platform/packages/config/**", "platform/apps/cli/**", "platform/apps/server/src/**", "platform/apps/host-daemon/src/**", "platform/packages/scripts/**", "platform/packages/host-daemon-contract/**", "platform/packages/server-contract/**", "platform/apps/app/src/**", "platform/apps/desktop/src/**", "platform/apps/mobile/**", "platform/package.json", "platform/.env.example", "tests/hyperfide/cases/v22/0_3.sh"]
verify_cmd = "bash tests/hyperfide/cases/v22/0_3.sh"
do_1 = "Rename every environment variable of the former prefix to HYPERFIDE_ (config package, scripts, server, host daemon, app, desktop, mobile, dotenv examples) and the data directory to ~/.hyperfide with a one-time migration that moves an existing former directory when present and logs it."
do_2 = "Rename the CLI binary to hyperfide-platform (bin field, launcher scripts, help text, shell completions) and the root scripts that invoke it; the title helper stays."
do_3 = "0_3.sh asserts: no former environment prefix or former data directory string remains under the touched packages; the config and host daemon unit tests pass (`pnpm -C platform exec turbo run test --filter=./packages/config --filter=./apps/host-daemon --filter=./apps/cli`); `node platform/apps/cli/bin/hyperfide-platform --help` exits 0 after `pnpm -C platform exec turbo run build --filter=./apps/cli`."
reqs = ["1.1"]
owner = "identity"

[task.0.4]
title = "Remove the marketing site, hosted connect gates and hosted account"
status = "done"
wave = 0
requires = []
touches = ["platform/apps/web/**", "platform/apps/connect/**", "platform/apps/connect-next/**", "platform/packages/connect-client/**", "platform/packages/connect-db/**", "platform/packages/tunnel-client/**", "platform/packages/tunnel-contract/**", "platform/packages/frp-client/**", "platform/plugins/connect/**", "platform/plugins/connect-next/**", "platform/plugins/*-account/**", "platform/plugins/*-official.json", "platform/apps/server/src/**", "platform/apps/app/src/**", "platform/apps/cli/src/**", "platform/packages/bundled-plugins/**", "platform/package.json", "platform/pnpm-lock.yaml", "platform/turbo.json", "platform/docs/**", "tests/hyperfide/cases/v22/0_4.sh"]
