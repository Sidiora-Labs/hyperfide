do_2 = "Every place that reported an event becomes either nothing or a local logger call at debug level; no environment flag for telemetry remains."
do_3 = "0_5.sh asserts no tracked file under platform/ outside node_modules references segment, posthog, analytics write keys or a telemetry flag, and the launcher, scripts and server unit tests pass (`pnpm -C platform exec turbo run test --filter=./packages/scripts --filter=./apps/server`)."
