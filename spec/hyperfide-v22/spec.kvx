verify_cmd = "bash tests/hyperfide/cases/v22/3_2.sh"
do_1 = "When an Ask of a blocking kind appears for a thread's task, the plugin pauses the thread (lifecycle hook or interrupt through the SDK; add the hook if the SDK lacks it) and records the pause reason; when the answer lands the thread resumes with a message carrying the answer (secret answers as the reference name, never the value)."
do_2 = "A decision or question Ask proceeds: the thread continues and gets an annotation flagged with the recommendation taken; the board shows the flag on the task."
do_3 = "3_2.sh runs the server tests with the echo provider raising each kind: blocking kinds pause and resume, flagged kinds annotate, the secret value never appears in the thread transcript; identity_gate.py --changed."
