[task.7.21]
title = "Import prior Claude Code and Codex sessions from the host into threads the app lists, shows and resumes"
status = "pending"
wave = 7
requires = ["7.9"]
touches = ["platform/apps/server/src/services/threads/thread-import/**", "platform/apps/server/src/routes/threads/**", "platform/packages/server-contract/src/api/**", "platform/apps/cli/src/commands/thread/**", "platform/plugins/provider-claude-code/src/**", "platform/plugins/provider-codex/src/**", "platform/apps/app/src/components/settings/**", "tests/hyperfide/cases/v22/7_21.sh"]
verify_cmd = "bash tests/hyperfide/cases/v22/7_21.sh"
do_1 = "Gap found at the 7.6 owner test on 2026-10-24: the platform database holds 0 threads while the host holds 9 Claude Code sessions (with 826 subagent transcripts beneath them) under ~/.claude/projects and 1,035 Codex rollouts under ~/.codex/sessions, so the owner sees an empty app and cannot continue any prior work in it. There is no importer: scripts/provider-recordings/convert-claude-transcript.mjs, referenced by platform/plugins/provider-claude-code/src/__fixtures__/transcripts/README.md, is absent from the repository; the translators exist (createClaudeDeltaTranslator in provider-claude-code/src/delta-translation.ts, createCodexEventTranslator in provider-codex/src/translator.ts) but consume live SDK and app-server streams only. Claude Code session files are JSON lines with types user, assistant, system, attachment, ai-title, last-prompt and others, each carrying sessionId and cwd; Codex rollouts are JSON lines with timestamp, ordinal, type (response_item, event_msg, turn_context, token_usage_record, ...) and payload."
do_2 = "A session import service discovers sources on the host daemon's machine (default roots ~/.claude/projects and ~/.codex/sessions, overridable), maps each session to a project by its cwd (falling back to the personal project), creates one thread per session with the title from ai-title or the first user prompt, created and updated times from the transcript, the provider id of provider-claude-code or provider-codex, and the provider thread id set to the Claude session id or Codex thread id so that a later message resumes the provider session through the bridges' existing thread/resume path. Records are translated through the provider's existing translator so imported threads render exactly like live ones (tool calls, results, reasoning, subagent sidechains as child threads linked by parentThreadId). Import is idempotent per (provider, session id): a rerun imports only new sessions and appends only new records to sessions already imported, so a session still being written can be re-imported later. Files stream line by line, insert in batches and yield between sessions so a thousand rollouts never block the server. Transcript contents are never logged. Surfaces: `hyperfide-platform thread import [--source claude-code|codex] [--root P] [--dry-run] --json`, REST POST /api/v1/threads/import and GET /api/v1/threads/import/sources in the server contract, and a Settings section `Import sessions` listing the discovered sources with counts, an Import button, progress and the result, styled like UpdatesSettingsSection with a story."
do_3 = "Tests use the existing __fixtures__/transcripts streams plus small redacted synthetic fixtures (one Claude session file with a subagent sidechain, one Codex rollout, together under 200 KB) and assert the thread, title, project mapping, event sequence, child thread and idempotency. 7_21.sh runs the server, cli and both provider typechecks and tests, boots the built server the way 7_7.sh does with HOME pointing at a temporary directory holding the fixtures, runs `thread import --json` twice and asserts the first run lists the expected titles and provider ids and the second imports 0; it prints each step's seconds and exit code and ends with `ok: 7.21`."
reqs = ["8.5"]
owner = "app"
