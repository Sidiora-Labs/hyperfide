# ── Wave 1: the binary and graph inside the platform ──────────────────────────

[task.1.1]
title = "hyperfide platform front door"
status = "done"
wave = 1
requires = []
touches = ["src/platform_cmd.c", "src/platform_cmd.h", "src/main.c", "src/help.c", "Makefile", "docs/hyperfide/cli.md", "README.md", "tests/integration/99_platform_frontdoor.sh"]
verify_cmd = "make cg && bash tests/integration/99_platform_frontdoor.sh"
do_1 = "Add `hyperfide platform <args>`: locate the platform CLI (HYPERFIDE_PLATFORM_BIN, then platform/apps/cli/bin/hyperfide-platform relative to the repository root, then PATH), exec it with the arguments, the inherited streams and environment plus HYPERFIDE_REPO_ROOT; exit with its code; print a precise error and exit 69 when no CLI is found."
do_2 = "`hyperfide platform --help` prints the CLI's help; `hyperfide --help` lists the platform group. The man and docs pages describe it."
do_3 = "99_platform_frontdoor.sh builds cg, runs the front door against a stub CLI script (arguments, exit code, stdout and stderr pass-through, environment variable present) and against a missing CLI (exit 69, message)."
reqs = ["2.1"]
owner = "core"

[task.1.2]
title = "Host daemon locates and verifies the binary"
status = "done"
wave = 1
requires = ["0.2", "0.3"]
touches = ["platform/apps/host-daemon/src/**", "platform/packages/host-daemon-contract/src/**", "platform/apps/server/src/**", "platform/packages/server-contract/src/**", "platform/apps/app/src/**", "tests/hyperfide/cases/v22/1_2.sh"]
verify_cmd = "bash tests/hyperfide/cases/v22/1_2.sh"
do_1 = "The host daemon resolves the hyperfide binary (HYPERFIDE_BIN, repository ./cg, PATH), runs --version, computes its sha256 and reports {path, version, digest, ok} through a new host contract message; the server stores it per host and exposes it on the hosts route."
