# Hyperfide — distributed successor to Codify, proposed version 2.0.
# Implementation authorised by the programme owner; qualification remains evidence driven.
# Task 1.4 owns activation and the versioned workflow policy transition.
# Approval metadata below is a review boundary, not an existing runtime gate.

[meta]
feature = "hyperfide"
name = "Hyperfide"
version = "2.0.1-proposed"
status = "in_progress"
implementation_authorized = true
review_date = "2026-10-16"
intro = "Evolve Codify into Hyperfide: a centrally coordinated, evidence-backed engineering fleet with a supervisory main server, PostgreSQL authority and versioned code graphs, Railway and Blaxel execution pools, frontier coding agents, independent semantic assurance, and calibrated decision assistance. Implementation is authorised; task and programme qualification remain separate."

[req.1]
title = "Programme authority and execution boundaries"
story = "As the programme owner, I provide the specification through the primary leader and expect the approved build-out to be agent owned."
ac_1 = "The approved run policy SHALL place the primary Claude Code or Codex leader and feature managers on the supervisory server defined by the approved deployment profile; implementation, dependency preparation, indexing, builds, tests, reproductions and integration execution SHALL be dispatched remotely. Source inspection and published graph queries MAY run on the main server."
ac_2 = "Human programme interaction SHALL occur through the primary leader. Routine scheduling, provisioning, repairs, retries and review routing SHALL follow the approved run policy without per-task human approval; unresolved changes to programme intent SHALL return through that leader."
ac_3 = "The system SHALL preserve frontier-only engineering agents and the configured Claude short-critical-complex versus Codex sustained-complex assignment policy. Configured model aliases SHALL resolve through qualified connector configuration to supported frontier deployments."
ac_4 = "This draft SHALL remain inactive with every implementation task pending and acceptance scenario UNRUN until user approval. The implementation SHALL replace applicable legacy dependency and single-binary restrictions through a versioned policy change; it SHALL NOT infer that unrelated repositories waived their policies."

[req.2]
title = "Versioned specification and dependency semantics"
story = "As a leader, I need the execution graph to preserve intent, declared wave barriers and multi-repository obligations."
ac_1 = "Each run SHALL pin a specification revision, repository identity map, acceptance clauses, allowed actions and closure policy. Live task state SHALL have one PostgreSQL authority; exported KVX status SHALL identify its revision and cannot independently overwrite newer live state."
ac_2 = "Import and mutation SHALL reject unknown dependencies, dependency cycles, contradictory ownership and invalid wave prerequisites with concrete diagnostics. Cross-feature, cross-programme and cross-repository dependencies SHALL have explicit identities and required qualification or integration milestones."
ac_3 = "Managers MAY propose task decomposition and dependency changes within policy; changes SHALL be versioned, checked for impact on active attempts and structurally validated before scheduling. Required acceptance SHALL NOT be weakened through ordinary retry or completion operations."
ac_4 = "Criteria SHALL map to executable evidence or an explicitly permitted review rubric. Declared task completion, linked requirement IDs, source snippets and UNRUN scenario declarations SHALL never alone establish behavioural qualification."

[req.3]
title = "Agent hierarchy and scoped context"
story = "As a feature manager, I need stable ownership and bounded context while coordinating work through waves."
ac_1 = "The hierarchy SHALL distinguish programme leader, accountable feature/domain manager, wave package, task worker, reviewer and integration role. Stable feature ownership across successive wave packages SHALL be an explicit proposed policy, while preserving the user's ability to allocate managers by wave."
ac_2 = "A task packet SHALL identify run, spec revision, task, attempt, ownership generation, parent and accountable manager, exact repository inputs, owned scope, relevant contracts, required evidence, limits and environment profile. Mandatory intent and constraints SHALL not be removed by context ranking."
ac_3 = "Leader and manager views SHALL present scoped summaries, exceptions, unresolved dependencies and evidence links with freshness, omitted-context and source provenance. Agents SHALL not require the entire programme history or graph in every prompt."
ac_4 = "Native child agents SHALL register parentage, role, task association, sandbox/slot and resource use. Manager replacement SHALL adopt the persisted package and valid descendants without silently creating competing owners or restarting healthy workers."

[req.4]
title = "PostgreSQL authority and causal read routing"
story = "As the coordinator, I need transactional fleet state and consistent packets across hundreds of clients."
ac_1 = "PostgreSQL SHALL own runs, spec revisions, tasks, attempts, leases, pools, reservations, sandboxes, slots, agents, branch metadata, graph manifests, findings, evidence and publication intents with explicit keys and integrity constraints. Git SHALL own source objects and artifact storage SHALL own large payloads."
ac_2 = "Ownership, renewal, result acceptance, dependency release and publication authorisation SHALL validate current state on the primary in short transactions. Replica observations MAY discover candidates but SHALL not grant authority. Clients SHALL use bounded connection pools and explicit request limits."
ac_3 = "A packet SHALL be assembled from a consistent database snapshot and identify its spec, source, dependency evidence and graph generations. Replica use SHALL verify availability and causal freshness using a topology/timeline-aware barrier or fall back to the primary; failover SHALL invalidate obsolete barriers."
ac_4 = "Database migrations SHALL be versioned and recoverable. The authority durability and failover contract SHALL prevent acknowledged ownership from being silently lost or an old primary from remaining writable; backup and restore SHALL be exercised against fleet identities and artifact references."

[req.5]
title = "Scheduling, reservations and fenced ownership"
story = "As a manager, I request work while Codify enforces valid ownership and available execution capacity."
ac_1 = "Claiming work SHALL atomically validate dependencies, declared wave policy, scope conflicts, role capability, run state and task ownership and reserve eligible capacity. Provider provisioning rate and running sandbox quota SHALL be separate limits; creating and prepared resources SHALL be counted."
ac_2 = "Each compute attempt SHALL receive a monotonic ownership generation and primary-clock lease. Initial submission SHALL validate current compute authority and atomically transfer its immutable result to a current coordinator-owned submission custody generation. Released or expired worker leases SHALL not reclaim active submitted, qualifying, qualified or integrating custody. Qualification SHALL validate current custody; integration SHALL validate contributor custody or prior integration receipts and its own publication fence. Explicit revocation or reassignment SHALL supersede affected custody transactionally; omitted or stale authority SHALL be rejected."
ac_3 = "Dispatch and retry SHALL be idempotent for an identified request. An unknown provider or process outcome SHALL enter reconciliation before replacement; duplicate physical execution MAY occur, but superseded execution SHALL not gain accepted completion or target-branch authority."
ac_4 = "The scheduler SHALL support declared agent, build, test, review, indexing, exclusive-environment and provider limits without fixed 16-slot or 256-start ceilings. Admission SHALL expose the actual limiting resource and apply review/integration backpressure rather than misclassify queued work as stalled."

[req.6]
title = "Durable events, commands and steering"
story = "As a distributed agent, I need acknowledged instructions and results that survive retries and disconnections."
ac_1 = "State changes and their outgoing event intents SHALL commit atomically. Dispatch SHALL process committed pending records with replayable acknowledgement; consumers SHALL not use a bare increasing database sequence as a safe commit-order cursor."
ac_2 = "Consumers SHALL deduplicate by event identity and apply state changes with revision checks. Delayed, duplicated, reordered and partially delivered events SHALL not lose work or reapply terminal actions; retention gaps SHALL require explicit resynchronisation."
ac_3 = "Steering, cancellation and task-start commands SHALL have stable identities, target attempt/generation, delivery state and acknowledgements. Redelivery SHALL not spawn another agent or append an instruction twice; durable local spool and central retention SHALL be bounded and observable."
ac_4 = "Notifications and streaming connections MAY wake consumers but SHALL not be the only durable queue. Coordinator or runner restart SHALL recover pending work from persisted state and reconcile externally visible effects."

[req.7]
title = "Central versioned graph and efficient indexing"
story = "As an agent, I need fleet-wide source knowledge without indexing competing with task ownership."
ac_1 = "Graph facts SHALL be keyed by repository, source tree or identified workspace overlay, extraction/configuration version and generation. Parsing and indexing execution SHALL occur remotely; optional local caches SHALL identify their generation and remain non-authoritative for fleet state."
ac_2 = "Ingestion SHALL use bounded bulk loading/staging and set-based resolution where appropriate, with bounded transactions and independent admission from coordination traffic. It SHALL not translate every local per-symbol query into a network round trip without measured justification."
ac_3 = "A graph generation SHALL become visible only after its manifest and required resolution/coverage checks are complete. Interrupted or failed generations SHALL preserve the previous published generation, expose reconciliation debt, and never masquerade as fresh complete coverage."
ac_4 = "Search, FTS/body/comment/trigram behaviour, provenance, branch isolation, incremental invalidation and bounded traversal SHALL have PostgreSQL-versus-current parity fixtures. Performance SHALL be measured under mixed claims, events, replica reads and graph writes; migration SHALL not claim an automatic speedup."

[req.8]
title = "Provider abstraction and fleet inventory"
story = "As the fleet controller, I allocate execution across Railway and Blaxel through a common qualified contract."
ac_1 = "Provider adapters SHALL expose capability discovery, prepare/create, observe/list with complete pagination, attach, execute/inspect/stop, file transfer, lifetime control and destroy with provider-specific outcome semantics. Unsupported capabilities SHALL be explicit and SHALL not silently degrade task requirements."
ac_2 = "Pools SHALL identify provider, account/workspace/environment, region, profile compatibility and configured quota. Account quotas, environment/workspace topology and negotiated entitlements SHALL be private deployment configuration, verified before use and separate from the approved operating budget."
ac_3 = "Provisioning intent SHALL be durable before the external call. Returned IDs SHALL be persisted as early as possible, ambiguous outcomes reconciled, stale reservations released safely and orphans quarantined before cleanup; provider creation SHALL not be described as exactly-once without proof."
ac_4 = "All pools SHALL reach an authenticated coordinator endpoint without assuming cross-environment Railway private DNS or equivalent Blaxel networking. Provider outages and rate limits SHALL permit bounded retry or compatible relocation while preserving source, environment and ownership identities."

[req.9]
title = "Railway execution adapter"
story = "As a manager, I use Railway prepared environments and durable commands without inheriting unsafe assumptions."
ac_1 = "The Railway adapter SHALL qualify pinned SDK/API behaviour for templates, disk checkpoints and forks, region/environment affinity and content preparation. Every restored sandbox SHALL start a fresh runner identity; running processes and agent memory SHALL not be assumed to survive a disk-only restore."
ac_2 = "Create/fork/restore SHALL pass a complete runtime profile including resources, network mode, region constraints, lifetime and variables. Build-time environment SHALL be distinguished from runtime values; non-inherited options SHALL not be omitted accidentally."
ac_3 = "Long-running execution SHALL persist sandbox and session identity, inspect exit codes, support reattachment and explicit process-group termination, and independently spool complete logs. Limited retained provider output, HTTP command limits and unsupported stdin controls SHALL not silently truncate evidence or terminate agents."
ac_4 = "The adapter SHALL reconcile create/readiness timeouts, inventory pagination, unknown command outcomes and checkpoint identifier API/documentation differences against the pinned version. Actual account networking, quota, idle policy and 72-hour lifecycle SHALL be qualified before full-scale use."

[req.10]
title = "Blaxel execution adapter"
story = "As a manager, I use Blaxel prepared images and processes while explicitly handling standby and storage semantics."
ac_1 = "Prepared coding images SHALL retain the required sandbox API and runtime build toolchains; default image slimming SHALL be disabled where it removes required tools. RAM-backed writable storage, volume mount behaviour and template symlink/hardlink limitations SHALL be checked for each profile."
ac_2 = "Long-running supervisors SHALL explicitly configure keepAlive and timeout semantics and a deletion policy compatible with nonstop runs. API waiting limits, process termination deadlines, standby and sandbox expiration SHALL be tracked as distinct mechanisms."
ac_3 = "Named create-or-get SHALL verify the returned configuration and reconcile ambiguity; mutable nonunique external IDs SHALL not establish ownership. Process names/IDs, exit codes, logs, stdin partial writes and API restarts SHALL have qualified recovery handling."
ac_4 = "Image-based fresh runner registration SHALL be the baseline. Preview memory snapshots, live variable updates and shared storage SHALL be optional capabilities with separate qualification; cloned process memory or credentials SHALL never clone accepted task authority."

[req.11]
title = "Prepared environments and exact source bootstrap"
story = "As a worker, I begin with verified code and prerequisites rather than repeat expensive setup or guess inputs."
ac_1 = "Environment profiles SHALL pin OS/architecture, toolchains, package manager and lock inputs, native agent CLI, runner/Codify versions and required capabilities. Reusable preparation SHALL have a content-derived manifest and shall not contain live credentials, task leases or active agent identity."
ac_2 = "Bootstrap SHALL materialise exact repository commits and dependency inputs, with isolated writable workspaces and explicitly keyed dependency/build caches. Source, lock, command, configuration or toolchain changes SHALL invalidate affected cached results."
ac_3 = "Readiness SHALL verify the actual published environment: tool availability, source identity, credentials availability, storage, network and required execution capabilities. A provider RUNNING status alone SHALL not imply task readiness."
ac_4 = "Preparation SHALL run remotely with bounded retries, complete diagnostics and prewarming driven by eligible work. Partial downloads, package failures and obsolete preparation manifests SHALL never be published as reusable complete bases."
ac_5 = "For repositories whose size makes full materialisation per slot the dominant cost, workspace materialisation SHALL support packet-scoped slices derived from the declared task scope and the published code graph's dependency closure (imports, build targets, test fixtures and shared contracts), materialised with partial clone and sparse checkout from the exact pinned commit under an immutable slice manifest. A slice SHALL fall back to the full tree with a recorded reason when closure derivation is incomplete, SHALL detect and record out-of-slice reads and writes, and slice qualification SHALL never be presented as full-tree qualification without the recorded slice identity."

[req.12]
title = "Sandbox supervisor and isolated worker slots"
story = "As the controller, I manage agents and execution jobs through a durable supervisor in each sandbox."
ac_1 = "Supervisor registration SHALL include sandbox, boot identity, capabilities, preparation manifest and slot inventory. Slots SHALL separate writable checkout/worktree, build outputs, runtime home, temporary files and ports; separate worktrees SHALL not be represented as VM-level security isolation."
ac_2 = "The supervisor SHALL atomically record accepted start commands before spawning, persist process/native-session associations, own local communication channels and reconcile after restart. Controller disconnection SHALL not accidentally close native agent input or trigger duplicate launch."
ac_3 = "Process lifecycle, sandbox reachability, task progress and assurance validity SHALL remain distinct observations. Native descendants SHALL be tracked for accounting, cancellation and checkpointing; execution limits SHALL apply to the complete job process tree."
ac_4 = "Pause, drain, cancel and stop SHALL have distinct documented semantics. Confirmed termination or unresolved termination SHALL be reported accurately; credentials/leases SHALL be revoked or fenced before a replacement can publish, and cleanup SHALL wait for required durable artifacts."

[req.13]
title = "Frontier agent connectors and session continuity"
story = "As a leader, I retain the configured frontier agents and their context across long jobs and recoveries."
ac_1 = "Claude Code and Codex connectors SHALL declare qualified launch, input, output, steer, cancellation, child-registration and resume capabilities for pinned CLI versions. Model aliases SHALL resolve to actual configured providers before dispatch; unsupported resume SHALL not be simulated as preserved context."
ac_2 = "Each agent session SHALL retain parentage, role, task/attempt, native session ID, process/boot identity, configuration version and checkpoint references. Model/provider context and source workspace checkpoints SHALL be linked so recovery cannot silently resume against a different tree."
ac_3 = "On transport loss the connector SHALL inspect/reconnect; on process loss it SHALL resume supported saved state or start a new explicitly identified session from a provenance-bearing handoff. Context loss, expired authentication and partial protocol writes SHALL be visible recovery reasons."
ac_4 = "Provider rate limits, model quotas and native approval/permission behaviour SHALL be integrated with admission and the approved autonomous run policy. The system SHALL not substitute decision models for coding agents or invent a supported account credential-sharing mechanism."

[req.14]
title = "Identity, credentials and authority boundaries"
story = "As the operator, I require each process to receive only the authority needed for its assigned work."
ac_1 = "Provider administration credentials SHALL remain with provisioning services. Supervisor enrollment SHALL bind a short-lived or otherwise controlled bootstrap credential to provisioning intent and boot identity; role and attempt credentials SHALL be checked independently of model text."
ac_2 = "Build-time, sandbox runtime and process variables SHALL be distinct layers. Credentials SHALL be referenced through approved storage/injection mechanisms, excluded from reusable images/logs/model packets, rotated without unsafe shared-session refresh, and revoked or expired on reassignment and cleanup."
ac_3 = "Account-session and API-credential authentication SHALL be separately qualified connector modes because the user's current mode is unresolved. The implementation SHALL not copy arbitrary host auth directories, assume refresh-token concurrency is safe, or claim unsupported credential portability."
ac_4 = "Protected Git publication, artifact namespaces, model decision egress and controller operations SHALL enforce role-scoped authority. Untrusted repository text, logs, model output or a forged heartbeat SHALL not grant scheduling, qualification or publication rights."

[req.15]
title = "Source workspaces, artifacts and checkpoints"
story = "As a manager, I can recover source and evidence independently from a disposable sandbox."
ac_1 = "Attempt work SHALL publish to attributable attempt branches or identified source artifacts; branch names alone SHALL not establish identity. Checkpoints SHALL preserve committed and required uncommitted changes, relevant session state, dependency inputs and environment fingerprints."
ac_2 = "Large logs, build results and verification artifacts SHALL use immutable or content-addressed durable objects with checksums, upload receipts, retention class and database references. Incomplete uploads or provider log backfill SHALL not be accepted as complete evidence."
ac_3 = "Artifact adoption from an expired attempt SHALL be an explicit validated operation that preserves provenance without restoring old authority. Restoration SHALL verify source/session/environment compatibility before continuing work."
ac_4 = "Retention, garbage collection and sandbox destruction SHALL honour active references, unresolved findings, pending publication and recovery needs. Cleanup SHALL be idempotent and observable and SHALL not remove the only copy of required code or evidence."

[req.16]
title = "Independent task qualification"
story = "As the programme owner, I can distinguish implementation reports from reproducible verification."
ac_1 = "Worker submission SHALL identify an immutable source revision, affected criteria/contracts and evidence manifest. Independent qualification SHALL execute required checks against those inputs in a separate qualified execution environment."
ac_2 = "Qualification SHALL reject missing, skipped, empty, unknown, interrupted or stale required checks and preserve command, environment, exit status and full artifacts. Historical forced status or nonempty proof text SHALL not become a passing qualification receipt."
ac_3 = "Criteria traceability SHALL reference the specific acceptance clause and applicable evidence. Where policy permits review judgement instead of executable proof, the record SHALL identify the rubric, reviewer, supporting evidence and limitations; a model score SHALL not replace mandatory proof."
ac_4 = "Implementation progress, qualified task state and current assurance validity SHALL be separate. Relevant changes SHALL invalidate affected evidence and schedule requalification while retaining historical results and their provenance."

[req.17]
title = "Commit and semantic assurance"
story = "As a feature manager, I need reviews to detect API and whole-system incoherence beyond mechanical checks."
ac_1 = "The initial policy SHALL preserve the user's 10–15 commit watchers, with each configured watcher reviewing every relevant commit. Coverage SHALL enumerate every required watcher and commit revision. Specialist sharding or any reduction of that baseline SHALL require an explicitly accepted policy change."
ac_2 = "Contract review SHALL join affected producers and consumers and examine schemas/signatures, errors, authorisation, state transitions, units, precision, ordering, idempotency, compatibility and operational invariants as applicable. Unchanged signatures SHALL not suppress behavioural review."
ac_3 = "Each review SHALL identify source and dependency revisions, spec/contract/rubric versions, reviewer identity, coverage, findings and limitations. Changed inputs SHALL invalidate affected conclusions; decision models MAY rank risk or flag insufficient evidence but SHALL not certify correctness."
ac_4 = "Review execution, reproductions and contract/system tests SHALL run remotely. Projection conflicts and graph inference SHALL retain uncertainty and SHALL not be mistaken for proof that an integrated candidate builds or behaves correctly."

[req.18]
title = "Finding lifecycle and GitHub issue coordination"
story = "As a manager, I receive accountable, deduplicated findings and can prove repairs resolve them."
ac_1 = "Canonical findings SHALL carry affected contract/revision, evidence, severity, originating task/attempt, accountable manager, affected managers and resolution condition. Duplicate reports SHALL retain supporting provenance rather than create independent untracked repair work."
ac_2 = "GitHub issues SHALL be an idempotent projection and external input to the internal finding lifecycle. Webhooks MAY accelerate routing, while the user's ten-minute watcher cadence SHALL remain a reconciliation baseline unless explicitly changed."
ac_3 = "Routing SHALL follow finding to reviewed revision to commit/task attempt to feature and current accountable manager, including cross-feature defects. Retries, duplicate webhook delivery and remote API uncertainty SHALL not create duplicate repairs or silently drop issues."
ac_4 = "Repair work SHALL use ordinary fenced attempts and qualification. Issue closure SHALL require the recorded resolution condition to pass on the intended revision; GitHub closed status alone SHALL not establish restored assurance."

[req.19]
title = "Integration, wave closure and programme acceptance"
story = "As the leader, I accept one coherent assembled system rather than a collection of isolated task reports."
ac_1 = "Integration SHALL assemble immutable candidates from qualified inputs and execute required mechanical, semantic, regression and system gates remotely. Candidate identities SHALL include every relevant repository/source input and environment; changing an input SHALL invalidate affected gates."
ac_2 = "Only the publication path SHALL possess protected-target write authority. Publication intents SHALL bind expected target head, candidate, generation and evidence; ambiguous Git outcomes SHALL be read back and reconciled before superseding an intent. A database fence alone SHALL not be treated as a Git server fence."
ac_3 = "Dependency release SHALL honour the declared qualification or integration milestone. Wave closure SHALL require its accepted candidate, applicable reviews, criterion evidence and finding disposition; programme closure SHALL additionally require specified end-to-end and activation/rehearsal obligations."
ac_4 = "Multi-repository publication SHALL record exact partial outcomes and use a programme manifest/release barrier; ordinary separate Git pushes SHALL not be represented as an atomic multi-repository transaction. Recovery and compensating action SHALL preserve audit history."

[req.20]
title = "Typed decision-provider interface"
story = "As Codify, I can evaluate Span, Jev and Liquid through a precise capability-aware interface."
ac_1 = "Adapters SHALL cover requested respan/span-02, typesafe/jev-1.14 and liquid/d1-ultra with pinned native or gateway routes, actual model IDs, modalities, default/experimental context limits, question capabilities, timeouts, cost accounting and response validation. Unsupported extensions SHALL fail explicitly."
ac_2 = "Raw choice distributions, yes probabilities, ordinal score outputs, provider confidence and optional numeric/box outputs SHALL retain their distinct semantics. Thresholds SHALL be calibrated per purpose/model/route; lack of evidence SHALL have an explicit abstention outcome."
ac_3 = "Provider-specific image encodings, per-question versus batched-state billing, reasoning controls and zero-budget semantics SHALL be represented accurately. Unknown pricing or usage SHALL remain unknown; marketing latency/quality SHALL not be reported as Hyperfide measurements."
ac_4 = "Calls SHALL execute outside the scheduling/heartbeat critical path with bounded admission, total deadline, retries, stale-packet rejection and deterministic fallback or escalation. Decision-provider outage SHALL not prevent safe core-loop operation."

[req.21]
title = "Bounded decision assistance"
story = "As the leader and managers, I use decision assistance at specific measured judgement points."
ac_1 = "Spec critique SHALL flag ambiguous criteria, unsupported verification, missing interfaces and suspected dependencies with source references. Proposed changes SHALL pass ordinary spec validation before affecting eligibility; advice SHALL not directly mutate authority."
ac_2 = "Recovery assistance SHALL classify failure/context/resource states and rank only policy-permitted responses, including insufficient evidence and manager escalation. Repeating an attempt SHALL preserve prior failure evidence and identify what changed."
ac_3 = "Worker/profile selection SHALL rank deterministically eligible frontier choices using task needs and measured outcomes. Context ranking SHALL preserve mandatory packet content; review routing and finding consolidation SHALL preserve original evidence and accountable ownership."
ac_4 = "Decision records SHALL include purpose, packet hash/revisions, rubric/model/route/version, raw output, calibrated interpretation, actual action, latency/usage and eventual outcome. Model recommendations SHALL not grant leases, waive required evidence or publish protected branches."

[req.22]
title = "Decision evaluation and promotion"
story = "As the programme owner, I select decision models from reproducible workload evidence."
ac_1 = "Evaluation packets SHALL contain only information available at the original decision time, with feature/incident-separated splits and independent labels for spec defects, missed findings and unnecessary recovery. Passing existing gates SHALL not be the sole quality label."
ac_2 = "The scorecard SHALL measure precision/recall by purpose, calibration, abstention risk/coverage, p50/p95/p99 latency, error rate, actual billed usage and cost per qualified result. A declared baseline SHALL permit meaningful comparison among the three providers."
ac_3 = "Shadow evaluation SHALL precede automatic policy influence; bounded controlled trials SHALL establish effects on retries, qualified throughput and total cost. Counterfactual scheduling benefit SHALL not be inferred from shadow agreement alone."
ac_4 = "Promotion SHALL require versioned thresholds and a rollback condition; provider/model/rubric drift SHALL trigger replay and requalification. Optional Span self-hosting SHALL have separate hardware, licence, correctness and operational qualification and SHALL not be required for the core fleet."

[req.23]
title = "Observability, resource admission and progress"
story = "As the primary leader, I see current fleet progress and its bottlenecks without polling every worker."
ac_1 = "Views SHALL expose desired versus observed state, data freshness, task/attempt/agent/sandbox identities, resource queue reasons, review/integration backlog, evidence validity and the critical dependency path. Activity SHALL not be labelled useful progress without supporting events."
ac_2 = "Resource accounting SHALL distinguish sandbox quota, agent sessions, CPU/RAM/disk, compilation/linking, tests, exclusive services, indexing, model quotas and provider API rates. Profiles SHALL expose measured limits and declared reservations instead of assuming every agent consumes identical resources."
ac_3 = "Fleet metrics SHALL include task readiness-to-start, provisioning/preparation phases, lease/result latency, event lag, replica lag, source-to-graph freshness, recovery loss, qualification throughput, retries and actual cost where available. Unknown measurements SHALL not be fabricated."
ac_4 = "Leader/manager notifications SHALL be scoped and bounded with durable evidence links and actionable exceptions. Logging, event ingestion and dashboards SHALL not become unbounded memory, connection or database-write consumers during a 72-hour run."

[req.24]
title = "Failure recovery and operational control"
story = "As the operator, I can recover or stop the fleet without losing ownership or evidence."
ac_1 = "Coordinator restart SHALL reconstruct durable desired state and adopt valid supervisors/sessions. Main-server loss SHALL expose the single supervision failure domain and enforce the approved bounded continuation or safe-pause policy; uninterrupted failover SHALL not be claimed without a qualified standby."
ac_2 = "Sandbox/process loss SHALL fence unfinished compute authority and restore compatible source/session/environment checkpoints into new identified attempts while preserving available artifacts. Already admitted submission custody with complete durable inputs SHALL survive loss of its former coding sandbox; lost verification jobs SHALL recover under their own leases. Custody revocation requires explicit disposition. Provider and network partitions SHALL be tested with delayed surviving old workers."
ac_3 = "Pause SHALL prevent new dispatch as specified; drain SHALL finish allowed in-flight work; cancel/stop SHALL revoke authority, deliver termination and record confirmed or unresolved outcomes. All modes SHALL have idempotent cleanup and resumability semantics."
ac_4 = "Backup/restore, PostgreSQL failover, artifact corruption, unavailable Git, credential expiry, full disk and provider outage SHALL have exercised recovery procedures and explicit RPO/RTO targets. Targets SHALL be labelled proposed until measured and accepted."

[req.25]
title = "Migration and compatibility"
story = "As an existing Codify user, I can migrate state without split authority or lost capabilities."
ac_1 = "The importer SHALL inventory actual SQLite schema/columns, graph/FTS semantics, KVX statuses, attempts, events, source identities and evidence before migration. It SHALL preserve identifiers and provenance and distinguish historical claims from qualified runtime receipts."
ac_2 = "Cutover SHALL quiesce or explicitly reconcile writers, snapshot/import/check counts and semantic samples, and switch a named authority epoch. Shadow comparison SHALL not create dual writable authorities; rollback before and after new PostgreSQL writes SHALL have separate safe procedures."
ac_3 = "Existing CLI, MCP, editor, hook, work_open/work_update, handoff, projection and documentation workflows SHALL have compatibility fixtures. Local/offline operation MAY retain local storage but SHALL not claim distributed ownership or accepted remote publication while disconnected."
ac_4 = "Deployment SHALL use pinned supported dependencies, reproducible remote builds, service configuration and upgrade ordering. The main box SHALL remain supervisory during bootstrap, deployment and future Hyperfide self-development."

[req.26]
title = "Hyperfide rebranding and identity migration"
story = "As the product owner, I receive Hyperfide with a deliberate compatibility path from Codify."
ac_1 = "User-facing product identity SHALL become Hyperfide across CLI help/version, installers/packages, generated guidance, editor/MCP surfaces, documentation, runtime labels and agent instructions. Existing names SHALL be classified as compatibility, historical evidence or required third-party identifiers before changing them."
ac_2 = "The proposed canonical CLI SHALL be hyperfide, with an explicit cg compatibility alias and documented deprecation policy. A short alias and public version/domain/package ownership SHALL not be assumed available or silently reserved."
ac_3 = "Configuration/data directory and environment-variable migration SHALL detect conflicts, preserve backups and support established workspaces, session links, hooks and task tags without destructive automatic renames. Legacy imports SHALL retain original provenance."
ac_4 = "Generated AGENTS/CLAUDE/codemap and spec mirrors SHALL be regenerated from their owning source after approval; they SHALL not be hand-edited during this draft. Brand completeness SHALL be checked alongside functional old/new entrypoint parity."

[req.27]
title = "Distributed qualification and scale campaign"
story = "As the programme owner, I require measured proof that the system supports the intended run profile."
ac_1 = "The qualification harness SHALL fail on missing runner, unknown/empty selection, missing required credentials/fixtures or skipped required scenarios. Spec-pack structural validation SHALL be reported separately from product/runtime qualification; every unexecuted product scenario SHALL remain UNRUN."
ac_2 = "Deterministic load/fault replay SHALL exercise representative 1,483-task and 299-task specification fixtures, mixed graph/coordination traffic, hundreds of readers, 200 concurrent registered worker slots, and at least 1,500 distinct agent sessions over a run without fixed start-history limits. Simulated agents SHALL be labelled as such."
ac_3 = "Staged live qualification SHALL cover both providers, real frontier connectors, 100 sandboxes with the approved slot density, 200 concurrent frontier agents for the declared interval, and a 48–72-hour endurance campaign with retained evidence. The exact minimum sustained concurrency window and smaller-run profile SHALL be agreed before the expensive campaign."
ac_4 = "Fault campaigns SHALL include reversed commit order, stale leases, delayed surviving workers, duplicate provisioning, controller restart, database failover, replica lag, sandbox loss, incomplete artifacts, credential renewal and ambiguous Git publication. No duplicate accepted task ownership or unqualified protected publication SHALL be tolerated."

[req.28]
title = "Documentation closure and release readiness"
story = "As the programme owner, I can operate and review the delivered system from complete, evidence-backed documentation."
ac_1 = "Documentation SHALL cover actual commands/APIs, architecture and role boundaries, provider capability differences, configuration/auth modes, migration/rebrand compatibility, troubleshooting, stop/recovery, retention and measured qualification limits. Proposed or unavailable capabilities SHALL remain labelled."
ac_2 = "Documentation closure SHALL produce successful deterministic checks and a durable snapshot/baseline receipt linked to the implementation revision. A connector exit code or warning-only baseline failure SHALL not establish closure."
ac_3 = "Release readiness SHALL require criterion-level traceability, passing required task/candidate/programme gates, resolved policy-blocking findings and complete operating procedures. Unqualified features SHALL not be described as supported in release material."
ac_4 = "The public review pack SHALL retain requirement and source evidence, proposed decisions and unresolved qualification items, schematics, a dependency-checked task plan and sanitised independent review dispositions. Raw discussions, private provenance, account details and local operational inventory SHALL remain outside tracked publication artifacts. Review completion SHALL not be confused with implementation approval or production qualification."

[req.29]
title = "First authority epoch and shared epoch adoption"
story = "As an operator, I need a fresh install to obtain its first authority epoch once and have every service role accept it."
ac_1 = "A trusted operator activation path SHALL call AuthorityStore.activate exactly once for a deployment with no predecessor, producing activation_kind BOOTSTRAP, and SHALL refuse a second BOOTSTRAP while any epoch exists."
ac_2 = "The control, provisioner and dispatch roles SHALL each pass assertExternalAuthorityCurrent against the single committed epoch without minting their own epoch, although they run as different uids."
ac_3 = "The activation SHALL require a LIVE_PROVIDER fence receipt with the existing expiry bound and SHALL NOT accept component-fixture fence evidence."
ac_4 = "Install and migrate tooling SHALL report authority_activated from the store, never as a hardcoded constant."

[req.30]
title = "Reachable provisioner and self-started worker"
story = "As the control role, I need the provisioner's actions to be invocable and its worker to run without a manual start."
ac_1 = "The provisioner SHALL expose an authenticated transport so that provider.pools.configure, provider.pools.attest-capacity, provider.pools.observe and provider.intents.execute/reconcile are invocable by authorised principals."
ac_2 = "The provisioner worker SHALL start at service boot under a self-signed PROVISIONER invocation loaded from a 0600, single-link executor config, mirroring the runner executor model."
ac_3 = "Worker start SHALL be idempotent across restarts and SHALL refuse to start with missing, group/world-readable or multiply-linked credentials."
ac_4 = "Daemon mode without a transport SHALL NOT remain the shipped unit configuration."

[req.31]
title = "Capacity accounts, worker slots and scheduling policy seeding"
story = "As the scheduler, I need claimable slots and accounts so claimTask can admit work."
ac_1 = "When a sandbox boot reaches RUNNING, the system SHALL create its worker_slots row in state READY for that boot_generation in the same transaction."
ac_2 = "A configured pool SHALL seed capacity_accounts per required dimension and a scheduling_policies row from its approved pool configuration, with provenance_digest and qualification_state recorded."
ac_3 = "Seeding SHALL be idempotent and SHALL NOT raise configured limits above the pool's qualified capacity."
ac_4 = "A stopped or replaced boot SHALL retire its slots so no READY slot outlives its boot."

[req.32]
title = "Qualified Railway quota through operator-declared capacity"
story = "As an operator on a provider without a quota API, I need a declared-capacity path that admission accepts."
ac_1 = "Railway pools SHALL become admissible through the existing provider.pools.attest-capacity OPERATOR_DECLARED_CAPACITY path for SANDBOX, PROVISIONING, CPU_MILLIS, MEMORY_BYTES and DISK_BYTES."
ac_2 = "The live Railway observer SHALL keep refusing with QUOTA_UNQUALIFIED; declared capacity SHALL NOT be presented as observed quota."
ac_3 = "Declarations SHALL keep the existing OPERATOR role, COMPLETE retained provenance artifact and 30-day expiry bounds; expired declarations SHALL stop admitting CREATE."
ac_4 = "A shipped example declaration and validation SHALL exist for the Railway dimensions."

[req.33]
title = "Durable Railway execution and complete adapter surface"
story = "As the provisioner, I need live executeBound on Railway to produce a definite outcome."
ac_1 = "executeBound SHALL pass the durable session binding the Railway spool requires, so a live execute reaches a real Railway session instead of an UNKNOWN outcome."
ac_2 = "The Railway adapter SHALL answer capabilities, prepare and transfer from real dependencies or a typed UNSUPPORTED with a stated reason that admission honours."
ac_3 = "The public 9.3 live-mode refusal SHALL remain; only the bound 8.3/9.4 path SHALL execute live."
ac_4 = "An exception inside the adapter SHALL keep its error code in the recorded outcome rather than collapsing to an untyped UNKNOWN."

[req.34]
title = "Per-role run policy and database grants"
story = "As an operator, I need a shipped, reviewable action list per role and the grants the runtime checks."
ac_1 = "The release SHALL ship one example run policy per role whose allowed_actions cover every action the role's registered components and dispatcher routes require."
ac_2 = "Each example SHALL pass validatePolicy for its role, and a missing action SHALL be reported by name."
ac_3 = "A trusted operator grant script SHALL provide the runtime role privileges assertRuntimePrivileges checks and the pg_control_system/pg_control_checkpoint EXECUTE grants, never as runtime DDL."
ac_4 = "Runtime roles SHALL NOT receive migration privileges."

[req.35]
title = "Host bootstrap and per-role environment"
story = "As an operator, I need one idempotent bootstrap to prepare users, directories, environment and units."
ac_1 = "A bootstrap SHALL create the hyperfide, hyperfide-provisioner and hyperfide-dispatch users, the configuration and state trees with least-privilege ownership and modes, and install the units."
ac_2 = "The release SHALL ship per-role example environment files listing every variable each role requires, with HYPERFIDE_MIGRATION_* absent."
ac_3 = "A preflight SHALL map each missing or unsafe variable to the existing refusal code before any service starts."
ac_4 = "The bootstrap SHALL be re-runnable without overwriting existing secrets or configuration."

[req.36]
title = "Runner supervisor and preparation-receipt capabilities"
story = "As recovery and reproduction, I need the 12.4 capabilities I require to exist."
ac_1 = "Task 12.4 SHALL export runner.supervisors.v1 with the verifyStop contract recovery/stop.ts consumes."
ac_2 = "Task 12.4 SHALL export runner.preparation-receipts.v1 backed by the existing preparation_receipts.ts functions."
ac_3 = "Recovery and reproduction SHALL resolve these capabilities without RECOVERY_DEPENDENCY_UNAVAILABLE in a registered runtime."
ac_4 = "Type guards at the consumers SHALL accept the exported objects unchanged."

[req.37]
title = "Satisfiable writer-isolation digest binding"
story = "As the fencing service, I need a fence configuration that can be valid."
ac_1 = "The permit, fence topology and binding digest checks SHALL be satisfiable by a non-circular configuration; no check SHALL require a resource digest to equal a hash over itself."
ac_2 = "Every existing binding check SHALL keep its strength: permit-to-fence resource equality and binding-to-resource agreement SHALL still be enforced."
ac_3 = "Writer isolation SHALL be built with a destruction preflight so the first isolation does not fail DESTRUCTION_PREFLIGHT_UNAVAILABLE."
ac_4 = "A tampered resource or topology digest SHALL still be refused."

[req.38]
title = "Qualified supervisory-host and issue-watcher units"
story = "As release management, I need the two remaining units qualified once their owning implementation is done."
ac_1 = "issue-watcher.service and supervisory-host.service SHALL move from UNQUALIFIED only after parent task 26.4 is done with its gates passing."
ac_2 = "The release status change and the 25.4 expectations SHALL change together as a qualified status transition, citing the 26.4 receipt."
ac_3 = "The units SHALL start their 26.4 entrypoints with the shipped configuration paths."
ac_4 = "No unit SHALL be marked qualified without its receipt."

