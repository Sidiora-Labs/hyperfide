[acceptance.V-001]
feature = "hyperfide"
reqs = ["1.2", "1.4", "2.1", "2.2", "2.3", "3.1", "3.2"]
scenario = "Start a pinned-spec run; attempt unknown dependencies, cyclic dependencies, invalid cross-repository references and invalid wave barriers; amend intent during execution."
expected = "Invalid plans cannot dispatch; diagnostics identify the actual defect. Valid amendments are versioned and affect only explicitly revalidated work. Existing accepted work retains its provenance."
contract = "verification.md"
test = "python3 tests/hyperfide/qualify.py --case V-001 --manifest <immutable-full-case-campaign-manifest.json> (planned)"
qualification = "UNRUN"

[acceptance.V-002]
feature = "hyperfide"
reqs = ["4.1", "4.2", "5.1", "27.4"]
scenario = "Many managers concurrently claim the same eligible task and scarce slot; retry requests after lost responses. After immutable durable submission transfers authority to coordinator submission custody, expire the original worker lease and clean its sandbox while qualification is pending; concurrently run the expiry sweeper."
expected = "Exactly one current authoritative attempt and valid slot reservation; retries return the same operation outcome. Other callers receive explicit conflict/wait states; no over-admission or silent lost request. Released compute capacity does not release coordinator submission custody: the sweeper cannot reclaim submitted work solely because its former worker lease expired, and independent qualification can complete without the original sandbox."
contract = "verification.md"
test = "python3 tests/hyperfide/qualify.py --case V-002 --manifest <immutable-full-case-campaign-manifest.json> (planned)"
qualification = "UNRUN"

