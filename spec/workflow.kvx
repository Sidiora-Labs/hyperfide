# Hyperfide's own spec workflow. Hyperfide uses Hyperfide to build Hyperfide.

[meta]
name            = "Hyperfide Workflow"
active_feature  = "hyperfide-v21"
source_of_truth = "spec/ (kvx). Generated files are pointers — regenerate, never hand-edit."

[mode]
name = "parallel"

[limits]
max_in_progress = 8

[agents]
driver = "claude"
max    = 10
ttl    = 3600

# The fleet: one repository, a tree of agents. Main Gideon owns the task
# list and merges pull requests; a feature manager owns one feature branch
# and reports to Gideon; a wave worker owns one wave on a branch cut from the
# feature branch. Work merges upward: wave into feature, feature into local
# main, main out through a pull request once both gates are green.
#
# Each [role.*] may also set what the role is run with and may spend:
# driver (codex|claude|custom), model, args, max (alive at once), wall and
# stall (90s, 30m, 2h), spend (USD per attempt), retries, and approve — a
# list of land, pr, retry, drift that stop for `hyperfide fleet approve`. Unset
# keys take the defaults `hyperfide fleet roles` prints.
[hierarchy]
enabled    = true
main       = "main"
remote     = "origin"
worktrees  = ".codegraph/worktrees"
test_gate  = "make test"
lint_gate  = "make hyperfide CFLAGS='-O2 -Werror'"
pr         = "auto"
checkpoint = "manual"

[role.main]
title  = "Main Gideon"
agent  = "gideon"
branch = "{main}"

[role.manager]
title  = "Wave Manager"
agent  = "wm-{feature}-{wave}"
branch = "wave/{feature}/{wave}"
base   = "{main}"

[role.worker]
title  = "Task Worker"
agent  = "w-{feature}-{task}"
branch = "task/{feature}/{task}"
base   = "wave/{feature}/{wave}"

[principle]
task_driven     = "Work is driven by the active feature's task list, in wave order."
verified_done   = "A task is done only after real remote verification and graph checks pass. Wave closure additionally requires remote regression checks and independent correctness review; component success never certifies a full acceptance case."
runtime_boundaries = "The approved Hyperfide programme permits declared TypeScript services, PostgreSQL, provider SDKs and native components. Pin and qualify dependencies; preserve the compatible local runtime and its cg compatibility alias."
non_invasive    = "Hyperfide observes and advises by default; it blocks only where the user asked it to."
local_first = "The compatible local graph, memory and workflow remain usable offline with no telemetry. Local caches identify their freshness and never grant remote fleet ownership. Decision-model output is advisory; verification and graph checks determine qualification."
distributed_authority = "Remote fleet authority requires the authenticated coordinator and PostgreSQL. Engineering execution remains remote under the approved programme policy; disconnected clients cannot obtain or renew ownership from cached state."
anchor_intent   = "Anchor what a reader could not derive from the code: purpose, contract, danger, pointer. Derivable comments are noise."
generated_owners = "hyperfide spec render owns AGENTS.md and CLAUDE.md; hyperfide agentmd owns agent-context.md in the configured context directory (.hyperfide/context by default; legacy .codify is migrated with backups); hyperfide codemap owns CODEMAP.md."

[loop]
step_1 = "hyperfide brief — load repo state, active task, and prior decisions."
step_2 = "hyperfide spec next — take the lowest-wave eligible task."
step_3 = "hyperfide spec start <id> — claim it."
step_4 = "hyperfide survey <area> for the wide picture, then hyperfide context <area> — the code you need in one call."
step_5 = "Implement remotely in an isolated task workspace. Anchor nonderivable intent and retain durable evidence; the main host supervises."
step_6 = "hyperfide review — the change against its criteria; hyperfide guard for grounding, contract, and hygiene findings; hyperfide anchors --stale for docs your edits outdated."
step_7 = "Create an explicit-path Git commit tagged [spec:<feature>/<id>]. Qualify the task, commit its lifecycle projection, and push its reviewed task branch after every task; retain Git publication credentials at the supervising gateway."
step_8 = "hyperfide spec done <id> — qualification runs; done means proven."

[memory]
recall   = "hyperfide recall at session start; hyperfide brief includes it automatically."
remember = "Persist decisions and constraints as they occur, not afterwards."

[status_values]
task = ["pending", "in_progress", "implemented", "done"]

[hard_rules]
no_fakes        = "Never fake a test to make it pass."
no_false_done   = "Never mark a task done that did not qualify."
declared_dependencies = "Additional dependencies are approved for Hyperfide under the versioned programme policy. Declare, pin and verify them; unrelated repository policies remain unchanged."
warn_dont_block = "New governance defaults to a warning. Blocking is opt-in."

[render]
markdown_mirror = false
mirror_to_kiro  = false
banner = "GENERATED by hyperfide spec render from spec/ kvx — DO NOT EDIT."

[adapters]
claude = "CLAUDE.md"
agents = "AGENTS.md"
