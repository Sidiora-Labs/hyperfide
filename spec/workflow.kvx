# Codify's own spec workflow. Codify uses Codify to build Codify.

[meta]
name            = "Codify Workflow"
active_feature  = "codify-v03"
source_of_truth = "spec/ (kvx). Generated files are pointers — regenerate, never hand-edit."

[mode]
name = "standard"

[principle]
task_driven     = "Work is driven by the active feature's task list, in wave order."
verified_done   = "A task is done only when its verify_cmd and graph checks pass. Trust the work, not the report."
one_binary      = "Everything ships in the single cg binary. No new runtime dependencies."
non_invasive    = "Codify observes and advises by default; it blocks only where the user asked it to."
local_only      = "No network calls, no telemetry, no API keys. Ever."

[loop]
step_1 = "cg brief — load repo state, active task, and prior decisions."
step_2 = "cg spec next — take the lowest-wave eligible task."
step_3 = "cg spec start <id> — claim it."
step_4 = "cg context <area> — pull the code you need in one call."
step_5 = "Implement. cg remember any decision worth keeping."
step_6 = "cg review — check the change against the task's acceptance criteria."
step_7 = "cg commit -m <msg> — snapshot, auto-tagged with the task."
step_8 = "cg spec done <id> — qualification runs; done means proven."

[memory]
recall   = "cg recall at session start; cg brief includes it automatically."
remember = "Persist decisions and constraints as they occur, not afterwards."

[status_values]
task = ["pending", "in_progress", "implemented", "done"]

[hard_rules]
no_fakes        = "Never fake a test to make it pass."
no_false_done   = "Never mark a task done that did not qualify."
no_new_deps     = "libsqlite3 and libc only. No new link-time dependencies."
warn_dont_block = "New governance defaults to a warning. Blocking is opt-in."

[render]
markdown_mirror = true
mirror_to_kiro  = false
banner = "GENERATED by cg spec render from spec/ kvx — DO NOT EDIT."

[adapters]
claude = "CLAUDE.md"
agents = "AGENTS.md"
