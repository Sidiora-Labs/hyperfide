# Hyperfide's own spec workflow: the single workflow source for this repo.
# CLAUDE.md, AGENTS.md and agent-context.md only point here (`hyperfide spec
# render`, `hyperfide agentmd`). Each rule is stated once, in one section;
# a statement that needs another section names it instead of restating it.

[meta]
name            = "Hyperfide Workflow"
active_feature  = "hyperfide-source-control"
source_of_truth = "spec/ (kvx). Generated files are pointers — regenerate, never hand-edit."

[mode]
name = "parallel"

[limits]
max_in_progress = 8

[agents]
driver = "claude"
max    = 10
ttl    = 3600

# The fleet: one repository, a tree of agents. Main Gideon owns the task
# list and merges pull requests; a feature manager owns one feature branch
# and reports to Gideon; a wave worker owns one wave on a branch cut from the
# feature branch. Work merges upward: wave into feature, feature into local
# main, main out through a pull request once both gates are green.
#
# Each [role.*] may also set what the role is run with and may spend:
# driver (codex|claude|custom), model, args, max (alive at once), wall and
# stall (90s, 30m, 2h), spend (USD per attempt), retries, and approve — a
# list of land, pr, retry, drift that stop for `hyperfide fleet approve`. Unset
# keys take the defaults `hyperfide fleet roles` prints.
#
# Workspaces: a task worker's worktree is a sparse slice of its touches by
# default (sparse = "slice"); sparse = "full" opts the fleet out and is
# recorded as HIERARCHY_SPARSE_FULL. A worker that needs a path outside its
# slice widens with `hyperfide slice <id> --widen PATH --reason CODE`, which
# records the path in its [task] touches and widened. Manager and wave
# worktrees are always the full tree (MANAGER_INTEGRATES_WAVE): they merge
# every worker's branch and run the wave's gates.
[hierarchy]
enabled    = true
main       = "main"
remote     = "origin"
worktrees  = ".codegraph/worktrees"
test_gate  = "make test"
lint_gate  = "make hyperfide CFLAGS='-O2 -Werror'"
pr         = "auto"
checkpoint = "manual"
sparse     = "slice"

[role.main]
title  = "Main Gideon"
agent  = "gideon"
branch = "{main}"

[role.manager]
title  = "Wave Manager"
agent  = "wm-{feature}-{wave}"
branch = "wave/{feature}/{wave}"
base   = "{main}"

[role.worker]
title  = "Task Worker"
agent  = "w-{feature}-{task}"
branch = "task/{feature}/{task}"
base   = "wave/{feature}/{wave}"

[principle]
task_driven     = "Work is driven by the active feature's task list, in wave order, one claimed task per worker."
verified_done   = "A task is done only when hyperfide spec done reruns its verify_cmd and graph checks and they pass. A wave closes only after its regression checks and an independent correctness review; a component passing never certifies a full acceptance case."
dependencies    = "The hyperfide binary links sqlite, curl and crypto plus the C library and its pthread and math objects, and nothing else (the Makefile LDLIBS line is authoritative). The TypeScript services may use declared, pinned dependencies listed in their package.json. Anything else needs a permission Ask first."
non_invasive    = "Hyperfide observes and advises by default; it blocks only where the user asked it to."
local_first     = "The local graph, memory and workflow work offline with no telemetry. Local caches state their freshness and never grant remote fleet ownership. Decision-model output narrows and ranks; verify_cmd and graph checks decide."
distributed_authority = "Remote fleet ownership requires the authenticated coordinator and PostgreSQL; a disconnected client cannot obtain or renew it from cached state."
anchor_intent   = "Anchor what a reader could not derive from the code: purpose, contract, danger, pointer. Derivable comments are noise."

[loop]
step_1 = "hyperfide brief — load repo state, the active task and prior decisions."
step_2 = "hyperfide spec next — take the lowest-wave eligible task."
step_3 = "hyperfide spec start <id> — claim it in an isolated task worktree or sandbox."
step_4 = "hyperfide survey <area> for the wide picture, then hyperfide context <area> for the code you need."
step_5 = "Implement only the claimed task. Never default what you were not given: raise an Ask (MCP ask_raise, or hyperfide ask raise), keep working on what does not depend on it, and read the answer with ask_status. Raise a secret when a credential or token is missing (it is answered with a secret-ref, never a value); a variable when a configuration value, path or endpoint is unknown; a permission before anything destructive, outside the task's touches, or a new dependency; a decision when more than one design fits, naming the option you recommend; a question when the spec or a criterion is ambiguous, with your reading as the recommendation. secret, variable and permission block; decision and question proceed on the recommendation and are flagged ([asks])."
step_6 = "hyperfide review against the task's criteria; hyperfide guard for grounding, contract and hygiene; hyperfide anchors --stale for docs your edits outdated."
step_7 = "Update the task status in the feature spec.kvx, then commit explicit paths with a message tagged [spec:<feature>/<id>]. Publication beyond the task branch follows [publication]."
step_8 = "hyperfide spec done <id> — qualification reruns verify_cmd; done means proven."

[memory]
recall   = "hyperfide recall at session start; hyperfide brief includes it."
remember = "hyperfide remember decisions and constraints as they occur, not afterwards."

[status_values]
# blocked: the attempt has an open blocking Ask, named in the task's
# blocked_ask; raising it from an in_progress task blocks the task and
# answering it returns the task to in_progress. A blocked task is not next
# and not eligible for dependants, stop preserves it, and stall detection
# exempts it. (The documentation stage's "blocked" is a failed docs closure,
# not this.)
# superseded: terminal; closed without qualifying, its work owned by the
# task or feature named in superseded_by, the reason in superseded_reason.
task = ["pending", "in_progress", "blocked", "implemented", "done", "superseded"]

[human]
# What the humans do; every other job belongs to agents.
job_1 = "Create the idea and the feature spec together with an agent."
job_2 = "Provide variables, secrets and permissions, and judge output by answering Asks."
job_3 = "Test the finished running system; that test is the release gate and closes the feature."
no_direct_commits = "Humans do not commit to the monorepo directly; their changes arrive through a spec task."

[asks]
# The one channel from an agent to a human. Per-kind deadlines and
# escalation chains are the policy table of hyperfide-v21 task 3.6; these
# are the defaults it starts from. When an agent raises each kind is the
# instruction rule in [loop] step_5.
kinds = ["secret", "variable", "permission", "decision", "question"]
secret     = "block"
variable   = "block"
permission = "block"
decision   = "proceed-and-flag"
question   = "proceed-and-flag"
shape = "An Ask carries its kind, the options with one recommended, a deadline, its default policy, an escalation chain and the task, attempt, session and sandbox it came from."
block = "block: the task is blocked until the Ask is answered."
proceed_and_flag = "proceed-and-flag: work continues on the recommended option; when the deadline passes unanswered, the default taken is recorded as a decision naming the Ask it replaced."

[publication]
cadence    = "Per wave: qualified task results publish together once the wave closes, never task by task."
final_wave = "The last wave of every feature is docs, release and changelog."
task_file  = "The feature spec.kvx task statuses are current before every commit."

[hard_rules]
no_fakes        = "Never fake or weaken a test to make it pass."
no_false_done   = "Never mark a task done that did not qualify."
no_silent_default = "Never default a secret, variable, permission or decision you were not given; raise an Ask."
warn_dont_block = "New governance defaults to a warning. Blocking is opt-in, except the [asks] policy, where secret, variable and permission Asks block by design."

[render]
markdown_mirror = false
mirror_to_kiro  = false
banner = "GENERATED by hyperfide spec render from spec/ kvx — DO NOT EDIT."
# printed in every generated file, so a reader knows what owns which file
generated_owners = "hyperfide spec render owns AGENTS.md and CLAUDE.md; hyperfide agentmd owns agent-context.md in the configured context directory (.hyperfide/context by default; legacy .codify is migrated with backups); hyperfide codemap owns CODEMAP.md."

[adapters]
claude = "CLAUDE.md"
agents = "AGENTS.md"

[workspace]
root = "."
package_manager = "pnpm@9.15.0"
control_service = "core/control-plane retains its independent npm lockfile and declared toolchain."
commands = "Run pnpm workspace commands from the repository root. Public CLI remains hyperfide platform."
