# Hyperfide native source control with layout and agent-led fleet prerequisites. Layout implementation started.
# Layout 0.3-0.9, fleet 0.10-0.14, then native 0.1; layout 0.3 in progress; product cases UNRUN.

[meta]
feature = "hyperfide-source-control"
name = "Hyperfide native source control for large monorepos and agent fleets"
version = "0.3.1-layout"
status = "in_progress"
stage = "implementation"
review_date = "2026-10-31"
source_baseline = "2f7331ef2085f6f374adf2d1e2ee01405fecb72d"
intro = "First qualify category-based repository reorganization, then the final prerequisite: agent-led fleet orchestration with interfaces.kvx, sandbox package.kvx and .neron source configuration. Only then implement the online server-authoritative source-control subsystem. An online server-authoritative source-control subsystem integrated into Hyperfide: immutable S3 content and bounded trees, thin clients, complete APIs, server-side history and source operations, optional sparse and virtualized working copies, within-monorepo sharding, exact-evidence acceptance, and GitHub/GitLab compatibility at the remote boundary. Layout implementation begins with inventory task 0.3; later product implementation and full qualification remain pending."

[decisions]
d_1 = "Native online source control is a Hyperfide subsystem with a versioned service boundary; Hyperfide keeps task, attempt, scheduling and qualification-policy authority. Basic source operations also support authorized taskless principals."
d_2 = "S3 holds immutable source objects. Native storage and clients do not use Git packs or require repository history clones. The remote compatibility adapter may generate bounded transient Git pack streams."
d_3 = "The primary workload is one growing monorepo containing many large projects. Physical partitions and service workers must scale within a single repository and project."
d_4 = "No service requires full source materialization. Explicit sparse, virtual or full client working copies are reproducible scoped snapshot materializations; whole-source materialization never implies a history clone."
d_5 = "Revision creation has no repository-wide lock or mandatory shared ref update. A globally ordered accepted trunk has a short explicit ordering transaction; no claim of coordination-free acceptance is made."
d_6 = "Protocol, namespace, storage schema, implementation language extensions and numerical service objectives are proposed choices recorded in decisions.md and verification.md. Their presence is not a benchmark or deployed capability claim."
d_7 = "Earlier specifications and spec/workflow.kvx are historical/current inputs unchanged by this draft. Migration makes scoped authority changes and preserves old source/evidence identities through explicit adapters."
d_8 = "Repository category reorganization tasks 0.3 through 0.9 run first; agent-led fleet and sandbox contracts tasks 0.10 through 0.14 run second and are the final prerequisite. Native task 0.1 follows 0.14. Existing task IDs remain stable."
d_9 = "Primary and Wave Manager reasoning sessions share the supervisory box. The Primary delegates waves; managers choose provider sandbox capacity and worker task assignments through scoped tools. Deterministic engine code validates contracts and executes admitted decisions; it does not silently replace agent planning."
d_10 = "Every sandbox carries .neron source configuration and package.kvx environment requirements. hyperfide install assembles exact source, dependencies, configs and interface subsets before worker readiness. Environment packages are distinct from task assignments. The prerequisite uses an explicit existing-source adapter and later adopts native source through the same contract."

