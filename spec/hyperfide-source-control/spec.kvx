[req.1]
title = "Online asymmetric native source control inside Hyperfide"
story = "As an operator of thousands of agents sharing one growing monorepo, I need source operations whose baseline cost does not grow with unrelated projects or full repository history."
ac_1 = "Native source clients SHALL require online server authority for durable mutations, preserve explicit unavailable or pending states on disconnection, and never infer committed source or ownership from a local save or stale cache."
ac_2 = "All source reads, ancestry, history, blame, diffs, commits, merge, rebase, revert and acceptance SHALL have versioned programmatic interfaces usable without a local repository; clients SHALL limit work to source presentation, change monitoring, content transfer and bounded caches."
ac_3 = "Content, tree metadata, revision metadata, indexes, queries and source-operation workers SHALL support partitioning or independent worker scaling within one repository; no infrastructure service SHALL require a complete checkout or full local history replica."
ac_4 = "Independent immutable revision creation SHALL avoid repository-wide locks, full-tree scans, pack maintenance and mandatory mutation of global names; changed content and affected metadata SHALL determine ordinary update work, with separate budgets for necessary ancestry and validation scope."
ac_5 = "Working copies SHALL be optional and SHALL support sparse, virtual and explicitly requested materialized source including a whole snapshot where necessary; cached content and dirty writes SHALL have separate lifetimes and no mode SHALL require cloning history."
ac_6 = "Git compatibility SHALL exist at the external import/export boundary for GitHub and GitLab; native source identity, operations and accepted history SHALL not depend on a Git repository, Git executable or remote availability."
ac_7 = "Hyperfide SHALL remain the task, attempt and qualification-policy authority while source control owns valid source transactions; source operations SHALL accept explicitly authorized taskless principals without manufacturing task assignments."
ac_8 = "Saved local edits, uploaded objects, durable checkpoints, submitted revisions, qualified candidates, native acceptance and external publication SHALL be separate observable states with explicit receipts; one SHALL NOT imply another."

[req.2]
title = "Immutable source identities and bounded persistent trees"
story = "As a source client, I need a complete logical snapshot identified without downloading or rewriting unrelated source."
ac_1 = "Native objects SHALL use versioned type-separated canonical encodings with SHA-256 identities; cross-language golden vectors SHALL cover empty content, Unicode, binary data, integer bounds, escaping and rejected alternate encodings. S3 ETags, physical keys and legacy Git OIDs SHALL remain distinct identities."
ac_2 = "Source snapshots SHALL be persistent bounded radix trees whose updates share unchanged nodes; a change in a huge directory SHALL NOT serialize that directory's entire entry set or enumerate the whole repository. Format limits and split/merge rules SHALL be explicit and deterministic."
ac_3 = "File objects SHALL preserve exact bytes, executable mode, file kind and explicit symlink content, and support versioned large-file chunk descriptors with verified full length and digest. Repository paths SHALL have a canonical validation/comparison policy and unsupported client/import names SHALL be reported without silent rewriting."
ac_4 = "A new verified tree SHALL establish transitive source availability by canonical validation of changed nodes and durable direct-child protection receipts; reused verified subtree roots SHALL NOT require a whole-repository closure walk per commit. Missing, corrupt, cross-domain or non-referenceable children SHALL prevent publication."
ac_5 = "Content/catalog routing SHALL partition within a single repository by versioned object/security-domain routing; project roots SHALL NOT be mandatory physical shards. Routing changes SHALL preserve immutable IDs, fence obsolete owners and retain bounded client retry behaviour."
ac_6 = "The online engine SHALL store no required Git packfiles, perform no Git repacking and require no service to materialize a complete checkout/history. Complete source materialization MAY be requested explicitly by a client; its bytes and cost SHALL be accounted separately."

[req.3]
title = "S3 persistence, acknowledgment and safe incremental reclamation"
story = "As an operator, I need durable source objects with cheap incremental updates, unambiguous acknowledgments and collection that cannot erase referenced code."
ac_1 = "The source store SHALL write immutable objects through idempotent bounded upload sessions and conditional creation into a dedicated security-scoped namespace. Verification SHALL check native type, encoding, byte length and content identity; multipart completion, lost responses and existing objects SHALL have explicit reconciliation outcomes."
ac_2 = "Revision acknowledgment SHALL follow verified object readiness and committed metadata/idempotency state under a declared durability profile. Upload success alone SHALL NOT acknowledge a revision; required replica availability SHALL be observed rather than inferred from asynchronous replication or cached metadata. No metadata transaction SHALL span backend network calls."
ac_3 = "A pinned tree/manifest SHALL drive source reads and materialization; ordinary operations SHALL NOT enumerate bucket contents for repository membership. Transfer grants, range reads, bounded parallelism and regional caches SHALL preserve snapshot identity and authorization while exposing unavailable placements explicitly."
ac_4 = "Durable roots and direct-child pins SHALL protect retained revisions/history, active workspaces, uploads, submitted custody, candidates, evidence, imports/exports, backups and holds. Parent readiness and pin acquisition SHALL synchronize with per-object lifecycle fences; cached reference counts and age alone SHALL NOT authorize collection."
ac_5 = "Collection SHALL be partitioned, bounded and resumable through quarantine, recheck, exact-incarnation deletion intent and reconciliation. References racing quarantine SHALL rescue before deletion authorization or retry a fresh incarnation; delayed deletion SHALL NOT erase re-uploaded content, and outgoing child pins SHALL release only after parent absence is reconciled."
ac_6 = "Backup, metadata failover and restore SHALL bind source roots, retained object placements, routing/codec/policy versions and authority epochs. Restore SHALL fence former writers, reconcile uncertain upload/delete/export outcomes and prove retained closure availability before opening writes; missing referenced objects SHALL fail the restoration completeness gate."

[req.4]
title = "Immutable changes and incremental server-side transformations"
story = "As an online agent or automation client, I need durable source revisions and server transformations whose work follows my changes while preserving every earlier source identity."
ac_1 = "The SCM SHALL distinguish stable repository-scoped change identities from immutable revision/root identities; concurrent successors SHALL remain addressable as divergence rather than being silently overwritten by a preferred revision."
ac_2 = "Revision creation SHALL accept explicit parents and verified patch/root inputs, reuse unchanged subtrees and register only new metadata/content; it SHALL NOT require a shared repository head, global sequence, repository-wide lock, complete checkout or full-tree walk. Sparse omissions SHALL NOT imply deletions."
ac_3 = "Merge, rebase and revert SHALL execute on server-held immutable objects with pinned revisions and algorithm versions; add/delete, text, binary, mode, symlink, directory/file and multiple-base cases SHALL have deterministic results or typed conflicts. Revert of a merge SHALL require an explicit mainline."
ac_4 = "Rebase, dependency replacement and conflict resolution SHALL create new revisions with explicit predecessor mappings and pinned dependency revisions; they SHALL preserve original history and SHALL NOT silently mutate descendants or substitute a newer revision by change identity alone."
ac_5 = "Mutation retries SHALL have scoped canonical request digests and durable idempotent results; acknowledged source SHALL survive the declared durability model, ambiguous outcomes SHALL reconcile by operation identity, and stale workspace/attempt generations SHALL NOT authorize new effects."
ac_6 = "Transformation workers SHALL expose visited objects, changed bytes, history scope, conflicts and queued/executing time, enforce bounded admission/cancellation and resume interrupted work; no latency claim SHALL omit content size, ancestry or necessary conflict work."

[req.5]
title = "Complete versioned source API and committed event replay"
story = "As a tool or CI controller, I need metadata and source operations without maintaining a local repository, with exact source inputs and recoverable delivery."
ac_1 = "A versioned authenticated API and typed contract SHALL expose content/tree reads, upload completion, revision/change history, ancestry, merge bases, diff, blame, line mapping, merge/rebase/revert, workspace checkpoints, candidates, acceptance and operation status/cancellation without requiring a filesystem checkout or local history."
ac_2 = "Queries SHALL pin immutable source inputs and authorization scope; pagination SHALL bind query/snapshot/index identity and ordering, expose coverage and partial/redacted results, and reject altered or expired cursors without silently mixing source generations."
ac_3 = "Mutations and long operations SHALL validate bounded schemas, expected versions and idempotency keys; version/capability discovery, stable error codes, retry/outcome classification, streaming/pagination, cancellation and durable continuation SHALL be available through the same protocol used by CLI/SDK clients."
ac_4 = "Every authoritative source state transition SHALL persist its outbox obligation transactionally; committed pending delivery discovery, per-aggregate ordering, consumer deduplication and snapshot bootstrap SHALL survive reordered commits, reconnects and retention gaps without relying on a bare global sequence high-water mark."
ac_5 = "A mutation receipt SHALL provide a causal read token whose dependent queries use sufficiently current metadata/object availability or explicit bounded failure; failover, restored database and partition epochs SHALL invalidate incompatible tokens rather than allowing stale reads to imply current authority."
ac_6 = "Query and event services SHALL partition and admit work within a repository independently of content uploads and acceptance; batched reads and bounded index/ancestry workers SHALL avoid mandatory full-history replicas and network-per-symbol traversal. Slow subscriptions SHALL expose bounded retention debt and resnapshot obligations."

[req.6]
title = "Online workspaces with bounded sparse and virtual materialization"
story = "As an agent or automated tool, I need exact source files when my work requires them without cloning the monorepo or its history."
ac_1 = "The service SHALL support API_ONLY, SPARSE, VIRTUAL and explicit MATERIALIZED modes by immutable repository/revision identity without a seed checkout; admission, filesystem readiness and physical downloads SHALL be reported separately."
ac_2 = "Each workspace SHALL pin a base revision, versioned read/write scope and dependency-closure manifest; scope widening and base advancement SHALL be explicit generation-checked operations that preserve dirty overlays and never silently materialize the full monorepo."
ac_3 = "Host caches SHALL have bounded bytes/entries, security-domain-scoped authorization and verified immutable objects, with partial transfers hidden and private writable copies or copy-on-write overlays; cache pressure SHALL NOT evict unacknowledged dirty source or create mutable hardlinks into shared cached content."
ac_4 = "Materialization and capture SHALL preserve exact UTF-8 names, regular-file bytes, executable state and supported symlink semantics; incompatible host paths and unsupported types SHALL be explicit, and sparse absence, hydration state or scope removal SHALL never imply source deletion."
ac_5 = "Watch notifications SHALL be hints backed by dirty-path journals and bounded reconciliation; a checkpoint SHALL capture a stable overlay generation, submit explicit mutations and receive acknowledgment only after server-held object and revision durability, with lost acknowledgment retries resolving to the same result."
ac_6 = "The virtual adapter SHALL advertise its pinned host capabilities, support declared build-tool I/O semantics, bound metadata/content fetching and map network or authorization failures to explicit I/O errors; unsupported virtualization SHALL require an explicit sparse/materialized fallback, never silent full checkout."

[req.7]
title = "Exact-evidence candidates and atomic source acceptance"
story = "As the integrator, I need source acceptance that preserves one coherent monorepo view while independent agents checkpoint continuously and Hyperfide retains qualification authority."
ac_1 = "Hyperfide SHALL own task/attempt scheduling, custody and qualification policy; SCM SHALL own valid source transactions. Source creation/acceptance SHALL NOT independently mark a task done, and source-only clients SHALL be supported through repository capabilities without fabricated tasks."
ac_2 = "An immutable candidate SHALL bind expected acceptance-domain state, ordered contributor/dependency revisions, resulting source root, transformation version, policy/spec/criteria, current custody/revocation and toolchain/configuration/graph/contract inputs; evidence applicability SHALL require those exact inputs and authenticated checker receipts."
ac_3 = "Acceptance SHALL be linearizable within its explicit domain through a bounded compare-and-swap metadata transaction that rechecks expected state, current authority, evidence applicability and retained object availability, then records acceptance, domain advancement, roots, idempotent result and outbox together. Upload/merge/build/test/remote publication SHALL execute outside it."
ac_4 = "An advancing accepted source or changed policy/input/custody SHALL invalidate conflicting candidate preconditions; reuse of evidence SHALL require a qualified applicability verifier and complete captured inputs, otherwise affected checks SHALL run on a new candidate. Disjoint paths or declared read sets alone SHALL NOT prove semantic independence."
ac_5 = "Speculative batches SHALL identify their exact contributor set and have bounded size, fairness and retry budgets; failure isolation SHALL preserve original proposals and create newly qualified candidates rather than transfer receipts between different candidate sources."
ac_6 = "The SCM SHALL retain distinct durable revision-created, candidate-qualified, native-accepted and remote-publication outcomes. Single-trunk ordering cost SHALL be explicit; independent domains SHALL require explicit policy and coherent manifests, and neither remote failure nor task-state projection SHALL silently rewrite accepted history."

[req.8]
title = "Hyperfide task authority integrated with native source transactions"
story = "As a fleet operator, I need Hyperfide to orchestrate work while the source engine preserves immutable source, valid transactions and exact evidence across worker replacement."
ac_1 = "Hyperfide SHALL retain task/attempt scheduling, budgets and qualification policy while the source service owns source identities, workspace mutation and acceptance; a source acceptance SHALL NOT itself mark a task done or create a second task authority."
ac_2 = "Assignments SHALL carry principal, repository, base revision, scope, authority epoch and task/attempt/workspace generations, enforced by the source service; taskless authenticated users and jobs SHALL also be supported, and stale workers SHALL be unable to mutate a replacement workspace."
ac_3 = "Submission SHALL atomically establish durable coordinator-owned result custody and source retention roots; compute lease expiry or worker cleanup SHALL NOT revoke accepted submission custody, and duplicate or ambiguous submissions SHALL be reconciled idempotently."
ac_4 = "Graph/context responses SHALL identify exact source, extraction/schema/configuration versions, overlay identity and coverage; incremental extraction SHALL reuse valid immutable facts and invalidate affected cross-project consumers, with stale or partial graph coverage unable to narrow required qualification silently."
ac_5 = "Qualification SHALL execute against an exact native candidate revision and environment/closure identities; integration SHALL retain the evidence binding, and task progress, durable checkpoint, native acceptance and external publication SHALL remain distinct states."
ac_6 = "Managers, integration services, query clients and ordinary workers SHALL operate without mandatory full checkouts or local Git history; image preparation, environment registration, collection and qualification SHALL consume native manifests and revisions, with legacy Git adapters explicitly identified during migration."

[req.9]
title = "GitHub and GitLab compatibility exists only at the remote boundary"
story = "As a project maintainer, I publish selected accepted native source to public Git remotes and may ingest external contributions without giving native agents full Git repositories."
ac_1 = "Git interoperability SHALL be implemented by independently budgeted remote adapters; native revision creation, queries, merging, rebasing and workspaces SHALL require no Git objects, refs, packfiles, worktrees, subprocesses or full local clones. Initial export MAY traverse all authorized projected objects with bounded streaming memory and spool."
ac_2 = "Each projection SHALL pin native repository, authorized root/path mappings, provider repository identity, target ref, policy version/digest, dependency treatment, public metadata schema, Git object format and history/grouping policy. Projection changes SHALL create an explicit new policy version and never silently rewrite published history."
ac_3 = "Export SHALL deterministically construct Git blobs, trees and commits including exact bytes, entry modes/symlinks, ordered projected parents, persisted author/committer timestamps and message encoding; mappings SHALL distinguish native sha256 IDs from namespaced Git SHA-1/SHA-256 IDs and survive worker retry/restart."
ac_4 = "Filtered no-change revisions, duplicate/collapsed merge parents and annotated tag targets SHALL follow a declared deterministic policy with retained provenance. Unsupported path encodings/types, gitlinks, signatures and missing dependency payloads SHALL produce explicit blocked results rather than lossy or silently incomplete exports."
ac_5 = "An export SHALL persist immutable intent and required retention roots before sending; validate current authorization and expected destination/ref; stream transient Git transport packs without native repacking; and retain remote mutation state, credential cleanup and acknowledged readback evidence. An uncertain issued push SHALL remain fenced and reconciled before a conflicting target operation proceeds."
ac_6 = "Native acceptance SHALL remain separate from remote publication and pull/merge request creation. Provider outage or remote divergence SHALL expose durable backlog/reconciliation state without overwriting remote work, weakening native qualification or reporting an unknown outcome as success; GitHub and GitLab SHALL have separately qualified capability/credential/protection profiles."
ac_7 = "Public projection access SHALL enforce source/history authorization and an allowlisted public metadata schema, excluding private task/session/memory payloads; dependencies outside the projection SHALL be explicitly included with permission, externally pinned or reported unavailable. Exported parents SHALL not expose excluded native history."
ac_8 = "When inbound contribution ingestion is enabled, it SHALL pin source repository/commit/object format and native base mapping, verify and quarantine bounded object streams without executing repository code, then create an idempotent native proposal subject to ordinary scope, qualification and acceptance. A remote force-push SHALL never mutate an existing native revision."

[req.10]
title = "Existing projects and history consolidate into one authoritative monorepo"
story = "As a monorepo operator, I consolidate large existing projects into a shared native repository while retaining provenance, valid evidence and acknowledged work across the authority transition."
ac_1 = "A versioned consolidation manifest SHALL pin every selected input repository identity, immutable tips/history policy, format, target project identity/path, dependency policy and public projection mapping. Project roots SHALL remain logical boundaries and SHALL NOT determine a single physical storage/query partition."
ac_2 = "Import SHALL detect target path/type/case/encoding collisions and explicitly resolve or reject symlinks, gitlinks/submodules, LFS payloads, signatures, tags and unsupported entries before selected roots become complete. It SHALL never silently replace, dereference or omit incompatible input."
ac_3 = "Streaming import SHALL retain original repository/commit or legacy snapshot identities, parent order and metadata provenance in a durable source map, deduplicate only within authorized storage boundaries, resume bounded batches idempotently, and distinguish imported history from newly authored revisions in metrics. No importer SHALL require a full checkout or complete local history."
ac_4 = "Shadow parity SHALL compare exact selected tree contents, entry types/modes, ancestry/source mappings and source-access decisions without granting a second writer. Initial ingestion and live source operations SHALL have independent resource budgets, and partial imports SHALL not appear as complete accepted snapshots."
ac_5 = "Pilot and cutover SHALL inventory and fence all legacy source writers, preserve/drain active dirty work and custody, reconcile external effects, pin final legacy source inputs, prove parity and atomically record the native authority epoch before opening native mutation admission. Dual authoritative writers SHALL be prohibited."
ac_6 = "Versioned source/evidence interfaces SHALL preserve historical Git/local snapshot receipts and migrate assignment, graph, finding, qualification and publication references explicitly. Activation SHALL supersede only the named legacy source-engine/worktree contracts and SHALL not rewrite historical specs or imply that unrelated offline functionality grants native online authority."
ac_7 = "Rollback before new native writes SHALL prove closed native admission and absence of new acknowledged/external effects; recovery after native writes SHALL reconcile/export every acknowledged revision and external effect before any successor authority opens. Reopening a stale writable source store SHALL be rejected."
ac_8 = "Cutover/recovery SHALL be idempotent, resumable and epoch-fenced with crash evidence at each boundary; retained imports, workspaces, evidence, source maps and uncertain exports SHALL remain valid garbage-collection roots until their declared obligations end. Final qualification SHALL exercise the actual Hyperfide pilot and source-authority transition."

[req.11]
title = "Scoped source access, integrity and recovery authority"
story = "As a project owner, I need source visibility, mutation and retention to follow explicit authority across workers, caches, APIs and recovery."
ac_1 = "Authenticated source capabilities SHALL bind security domain, repository, action, scope, policy/authority epoch and expiry; managed mutations SHALL also validate current workspace/task attempt generation or submission custody. Authorized human, import and automation principals SHALL use the same protocol without fabricated agent tasks."
ac_2 = "Authorization SHALL apply to content, listings, history, ancestry, blame, diff, symbols/search, object existence, exports and event streams. Shared caches, deduplication and pagination SHALL preserve security scope; object hashes and cache hits SHALL NOT grant read access or reveal another security domain's object existence."
ac_3 = "Direct object-transfer grants SHALL be bounded, short-lived and method/object/incarnation scoped; durable bucket administration credentials SHALL remain outside agent workspaces. Revocation SHALL prevent new authoritative mutations immediately while documenting the tested residual validity of already issued read grants."
ac_4 = "The server and materializer SHALL reject forged/mismatched object receipts, malformed tree ranges, decompression/size violations and path or symlink escape. Native content verification SHALL remain independent of backend ETags, transport success, worker exit and claimed model correctness."
ac_5 = "Public export metadata SHALL use an explicit allowed schema separate from private task conversation, memory, credentials and control-plane records. Audit records SHALL preserve attributable operation/request/source identities and generations without exposing transfer secrets or source outside the reader's scope."
ac_6 = "Collection, recovery, routing transfer and authority failover SHALL require current scoped service authority and persisted generation-fenced intents. Negative cases SHALL prove stale workers, delayed deletes, revoked principals, old primaries and stale backup credentials cannot mutate or destroy a successor's accepted source."

[req.12]
title = "Within-monorepo scale, measured growth and honest qualification"
story = "As an operator of a growing monorepo and connected agent fleet, I need measured source throughput, bounded clients and demonstrable recovery without equating imports, admission counters or component checks with completed engineering work."
ac_1 = "Qualification SHALL identify immutable native inputs, backend/configuration and toolchain, exact assertions, fault schedules, offered and completed work, independent oracles and cleanup; all cases SHALL remain UNRUN until actual execution and component evidence SHALL NOT imply full-case qualification."
ac_2 = "The proposed capacity campaign SHALL sustain at least 5,000 active native workspaces in one repository, at least 100,000 newly authored durable revisions per 24 hours for 72 elapsed hours, and 100 distinct revision submissions per second for five minutes; imported history, duplicate retries, task acceptance and external publication SHALL be counted separately."
ac_3 = "A separately declared admission profile SHALL exercise at least 20,000,000 logical workspace opens per 24 hours without claiming physical materialization or actual coding-agent concurrency; cold/warm sparse, virtual and explicit full-source materialization SHALL report actual paths, bytes, storage requests and host resource use."
ac_4 = "Growth campaigns SHALL hold a fixed change set constant while logical file count, unique content, directory fan-out and history vary independently within one repository; they SHALL establish relevant-scope work bounds, expose any global ordering contention, and measure independent tier scaling without a full-repository checkout or scan prerequisite."
ac_5 = "Mixed-load campaigns SHALL record per-operation p50/p95/p99/max, offered-load schedules, failures/timeouts, cache state, query result size, queue/lock/connection pressure, storage requests/bytes and publication lag; provisional budgets in verification.md SHALL be evaluated on explicitly identified resources rather than presented as achieved guarantees."
ac_6 = "Real S3, remote-provider and Hyperfide worker variants SHALL use actual resources and operations; absent credentials/capacity SHALL produce BLOCKED, and replay, local backend tests or load clients SHALL NOT substitute for live backend, elapsed-time endurance or actual agent qualification."
ac_7 = "Failover, restore, garbage-collection races, stale authority and ambiguous external effects SHALL be checked against a declared durability/fault model; release closure SHALL reject missing/tampered/stale evidence and report any loss against the configured recovery point."

[req.13]
title = "Usable native source journeys and bounded operational visibility"
story = "As an operator, developer or agent integrator, I need one coherent Hyperfide source-control interface and evidence of where time, bandwidth and integration capacity are spent."
ac_1 = "The CLI under hyperfide and the versioned SDK SHALL expose the shared source API with authentication, typed errors, pagination, cancellation and operation reconciliation; metadata/source queries SHALL work without a local repository or task."
ac_2 = "Workspace, checkpoint, submission, qualification, acceptance and remote publication views SHALL show durable identities, freshness, current owner and actionable failure states; local edits or uploads SHALL never be presented as acknowledged source history."
ac_3 = "Metrics SHALL distinguish logical opens from sparse/virtual/full materializations, source ingestion from new revisions, bytes/files from commit counts, and graph work from source acceptance; bounded metric labels and access-controlled exact-identity traces SHALL preserve observability without exposing unauthorized source."
ac_4 = "Host and service budgets SHALL bound cache/dirty bytes, transfer concurrency, queued operations and graph work while retaining heartbeat/cancellation capacity; refused work SHALL name the limiting budget and retry policy rather than appearing stalled."
ac_5 = "Native app journeys SHALL use existing headers, forms, navigation and human-readable project/task/revision pickers, with copy/detail access to IDs, paginated large views and demonstrated desktop/tablet/mobile interaction and reconnect continuity."

[req.14]
title = "Versioned adoption, documentation and release evidence"
story = "As an operator adopting native source control, I need a complete migration and recovery contract, truthful documentation, and release evidence that describes the running system rather than a design claim."
ac_1 = "The specification SHALL maintain complete acceptance-to-task-to-case traceability, pending implementation status before execution and UNRUN case status before qualified evidence; authoring checks SHALL never satisfy product acceptance."
ac_2 = "Documentation SHALL describe implemented API, workspace, authority, remote publication, retention and recovery behavior with source/evidence links; proposed or unsupported modes SHALL be distinguished from shipped behavior in CLI, SDK and product surfaces."
ac_3 = "A release profile SHALL identify storage endpoints, capability references, supported filesystem and remote profiles, metadata durability topology, retention and recovery objectives; missing mandatory deployment inputs SHALL produce named diagnostics without silent fallback to unsafe authority."
ac_4 = "Native format, protocol, identity and evidence schema versions SHALL have compatibility and rollback rules preserving historical Git and legacy snapshot evidence; active workflow changes SHALL occur only through the migration task and never as a side effect of importing this specification."
ac_5 = "Release closure SHALL require qualified canonical cases, exact release inputs and artifacts, real-backend and real-fleet evidence, restore and publication reconciliation, and recorded operator acceptance of the running source-control journey; unresolved required failures SHALL remain visible and block a qualified release claim."

[req.15]
title = "Category-based repository layout before native source-control implementation"
story = "As a maintainer, I need one coherent repository organized by package purpose so SDKs, core implementations, apps, plugins and tools are discoverable without navigating separate nested system codebases."
ac_1 = "The repository SHALL organize source by category using repository-layout.json: core implementations under core/, supported SDKs under sdk/, and explicit apps/, plugins/, contracts/, lib/, tools/ and other declared categories. Every current platform/ and services/ tracked input SHALL have an explicit move, merge, regenerate or archive rule, with collisions and drift resolved before mutation."
ac_2 = "Relocation SHALL preserve public package names, module identities, exports, executable commands, plugin/extension IDs, protocol behavior, license obligations and dependency resolutions. Existing package units and runtime storage boundaries SHALL remain intact; directory movement SHALL NOT silently activate, remove or rewrite functionality."
ac_3 = "The relocated pnpm workspace SHALL have its authoritative root configuration, lockfile and build/test discovery at repository root while preserving separately managed npm and language-module boundaries. Importer, patch, alias, filter and cache paths SHALL be regenerated and verified without unplanned dependency or toolchain upgrades."
ac_4 = "Each producer move SHALL update direct consumers, native registry/include rules, CLI/root discovery, environment hooks, SDK/plugin generators, runtime loaders and package assets in the same runnable candidate; final checkout operation SHALL require no old platform/ or services/ source facade or duplicate source tree."
ac_5 = "CI triggers, cache invalidation, sandbox preparation, current docs, ignore rules, release assembly and deployment checkout fallbacks SHALL recognize the target categories. Installed artifact paths and historical source/evidence paths SHALL remain explicitly versioned and SHALL NOT be indiscriminately rewritten as checkout paths."
ac_6 = "Move qualification SHALL compare the complete tracked content/type/mode inventory, package/extension identities, dependency graph, workspace/test membership and actual affected runtime/build/package behavior, with baseline failures distinguished from introduced regressions and prepared images bound to a layout generation."
ac_7 = "A current layout qualification receipt SHALL gate fleet prerequisite task 0.10, and native task 0.1 SHALL wait for final fleet gate 0.14. Layout and fleet prerequisite tasks SHALL have no dependency on native SCM implementation or its future case registry; later tasks SHALL transitively require the layout receipt and target category paths."
ac_8 = "The migration SHALL retain the original layout revision, path mapping, evidence lineage and rollback/image compatibility contract. Active future task scopes SHALL use target paths while historical receipts/specifications remain pinned to their original source; rollback SHALL preserve subsequent work rather than reopen stale source or maintain parallel authoritative trees."

[req.16]
title = "Agent-led Primary and Wave Manager orchestration"
story = "As a fleet operator, I need models to adapt work distribution and recovery while executable contracts bound every effect."
ac_1 = "The Primary agent and Wave Manager sessions SHALL run on the same configured supervisory box with distinct authenticated identities and recoverable state; the Primary SHALL assign waves and cross-wave obligations, and managers SHALL own execution decisions for their delegated wave scopes."
ac_2 = "Wave Managers SHALL choose provider/profile, sandbox creation or reuse, worker allocation, task assignments, concurrency and recovery through admitted tool calls within delegated budgets. Task assignment bundles SHALL remain distinct from sandbox environment package.kvx files, with individually attributable task/attempt outcomes."
ac_3 = "The engine SHALL enforce schema validity, scope, dependencies, capacity, leases, generations, idempotency, evidence and cancellation. It SHALL NOT substitute a deterministic task ranking, fixed worker retry policy or hidden fallback planner for unavailable model decisions. Mechanical delivery retries and receipt reconciliation SHALL preserve the admitted intent identity."
ac_4 = "Agent decisions SHALL persist exact contract/source/context versions, actor and delegation identities, selected actions and operation receipts before or alongside external effects. Recovery SHALL reconstruct accepted decisions and uncertain outcomes without requiring deterministic regeneration of model text or exposing private reasoning."
ac_5 = "Leader or manager replacement SHALL revoke former generations and recover outstanding provider operations, workers and custody. Same-box loss SHALL have an explicit durable recovery path, and stale supervisors SHALL NOT dispatch new work or terminate resources owned by replacement generations."
ac_6 = "Workers SHALL receive immutable task assignments and reference a ready environment generation, isolated writable source and scoped credentials. Manager reassignment, cancellation and worker retries SHALL preserve checkpoints and reconcile pending effects before issuing conflicting replacements."
ac_7 = "Agent-driven scope or interface changes SHALL create versioned proposals and revalidate dependency and acceptance obligations; managers SHALL NOT weaken their own completion criteria or self-attest success in place of required execution evidence."
ac_8 = "The fleet prerequisite SHALL qualify actual co-located Primary/manager sessions and provider sandbox/worker execution, adaptive decisions, interrupted install and supervisor recovery under an explicit existing-source backend before native task 0.1. Future native source adoption SHALL preserve these contracts and qualify the backend transition separately."

[req.17]
title = "Sandbox source configuration environment manifest and interface contracts"
story = "As a worker, I need one install operation to assemble exactly the source, dependencies and configuration required for my assigned work."
ac_1 = "Every fleet sandbox SHALL carry .neron as nonsecret source-control configuration and package.kvx as a versioned environment manifest before worker workload execution. Their grammar, validation and resolution rules SHALL be explicit; neither file SHALL itself grant authorization or represent the task assignment ledger."
ac_2 = "package.kvx SHALL declare scoped source inputs, dependency lockfiles and managers, toolchain/image requirements, configuration references, required interface IDs and declared preparation/check steps. Immutable resolved identities SHALL bind installation; floating selectors SHALL resolve once into a recorded lock before workers begin."
ac_3 = ".neron SHALL bind the selected source adapter, repository/workspace identities, immutable source input, endpoint or transfer configuration, read/write scopes, authentication-profile references and cache policy. The bootstrap identity SHALL authorize access independently, and tokens or provider secrets SHALL NOT be embedded in tracked configuration."
ac_4 = "hyperfide install SHALL bootstrap from an already available installer and authenticated assignment envelope, validate both files, resolve bounded source/dependency/interface closure, fetch verified inputs, invoke pinned dependency tools, apply scoped configs and run declared readiness checks. A success receipt SHALL follow complete readiness only; fetch success alone SHALL NOT mark a worker ready."
ac_5 = "Install retries SHALL use an environment generation and canonical input identity, reconcile interrupted stages, preserve dirty worker overlays and isolate mutable environments between workers. A changed manifest SHALL require a new generation or an explicit safe transition; cache hits SHALL verify content, scope and toolchain compatibility."
ac_6 = "interfaces.kvx SHALL preserve the observed interface.<id> block grammar and kind, path, line, signature, callers, status, contract and notes fields. Stable IDs SHALL be referenced from tasks and package manifests; source-pinned indexed subsets SHALL serve workers without requiring a complete catalogue in each sandbox or prompt."
ac_7 = "Interface extraction and authored contracts SHALL have distinct provenance; source locations and caller inventories SHALL NOT alone prove behavioral compatibility or exhaustive dependencies. The system SHALL check declared provided/required interfaces and surface stale, missing or incompatible contracts with affected consumer obligations."
ac_8 = "Each ready environment receipt SHALL bind source and manifest digests, selected interface block identities and provenance, resolved dependencies, toolchain/configuration versions, actual checks, sandbox boot identity and environment generation. Secret values SHALL remain outside durable receipts while configuration versions remain attributable."
ac_9 = "Prerequisite installation SHALL use an explicit existing-source backend without requiring native SCM, native object storage or task 0.2. The later native adapter SHALL implement the same install/source contract with scoped snapshot/object reads; adapter failure SHALL NOT silently switch backend or materialize full repository history."
ac_10 = "The contract suite SHALL reject ambiguous identities, unknown schema versions, escaping paths, source/manifest mismatch, forged ready receipts and dependency/configuration drift; real install qualification SHALL demonstrate bounded selected source, consumer interface checks, repeat installs, partial failures and multiple-worker isolation."

[design]
overview = "The normative contract is spec.kvx, refined by design.body.md, storage.md, protocol.md, workspaces.md, hyperfide-integration.md, identity-security.md, git-interop.md, migration.md and verification.md. README.md indexes the pack; implementation-plan.md and traceability.md are derived views. Final prerequisite contracts: fleet-orchestration.md, sandbox-contracts.md and interface-contracts.md."
authority = "Hyperfide task/attempt authority and source transaction authority have explicit ownership. Uploads precede revision metadata publication; root pins coordinate retention. Candidate acceptance validates exact evidence, expected source predecessor and current authority in a short transaction."
source = "Native object IDs use a proposed versioned type-tagged SHA-256 envelope; immutable bounded trees identify full logical snapshots without materialization. Project scopes are independent of physical partitions. External Git hashes are a separate typed namespace."
implementation = "After layout and fleet prerequisite qualification, the native service modules live in core/control-plane/src/source_control/, host modules in core/host-daemon/src/source-control/, and the client package in sdk/source-control/. Existing inspected paths remain baseline references; repository-layout.json maps old paths to target categories."
verification = "Future per-task drivers live at tests/hyperfide/cases/source_control/W_N.py and are created by their tasks. Task 0.2 versions the existing qualification registry/schema for SCM case IDs and native source evidence. Structural validation uses tools/validate_spec.py and does not execute product drivers."
layout = "Requirement 15 and repository-layout.md gate fleet entry 0.10 through layout receipt 0.9. Requirements 16 and 17 then gate native entry 0.1 through fleet receipt 0.14. No native implementation is a prerequisite dependency."

