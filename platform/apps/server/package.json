{
  "name": "@hyperfide/server",
  "version": "2.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --external ./start-server.js --copy-dir ../../packages/db/drizzle dist/drizzle --copy-dir src/assets dist/assets && node --import tsx scripts/copy-builtin-skills.ts && node ../../scripts/build-node-entry.mjs src/start-server.ts dist/start-server.js && node ../../scripts/build-node-entry.mjs ../../packages/plugin-sdk/src/index.ts dist/plugin-sdk-runtime.js && node ../../scripts/build-node-entry.mjs src/services/plugins/zod-runtime.ts dist/zod-runtime.js",
    "start": "node dist/index.js",
    "dev": "node --conditions=source --import tsx scripts/dev-supervisor.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:provider-corpus": "vitest run --config vitest.config.ts test/provider-corpus"
  },
  "dependencies": {
    "@hyperfide/authority": "workspace:*",
    "@hyperfide/config": "workspace:*",
    "@hyperfide/core-ui": "workspace:*",
    "@hyperfide/db": "workspace:*",
    "@hyperfide/domain": "workspace:*",
    "@hyperfide/host-daemon-contract": "workspace:*",
    "@hyperfide/logger": "workspace:*",
    "@hyperfide/plugin-build": "workspace:*",
    "@hyperfide/process-utils": "workspace:*",
    "@hyperfide/sdk": "workspace:*",
    "@hyperfide/secret-storage": "workspace:*",
    "@hyperfide/server-archive": "workspace:*",
    "@hyperfide/server-contract": "workspace:*",
    "@hyperfide/templates": "workspace:*",
    "@hyperfide/text-utils": "workspace:*",
    "@hyperfide/thread-view": "workspace:*",
    "@better-auth/api-key": "^1.6.23",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@hyperfide/plugin-sdk": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@opentelemetry/api": "1.9.1",
    "better-auth": "^1.6.23",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.38.4",
    "gray-matter": "^4.0.3",
    "hono": "^4.7.0",
    "mime-types": "^3.0.2",
    "npm": "11.16.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "semver": "^7.7.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hyperfide/agent-runtime": "workspace:*",
    "@hyperfide/client-core": "workspace:*",
    "@hyperfide/scripts": "workspace:*",
    "@hyperfide/test-helpers": "workspace:*",
    "@hyperfide/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "ajv": "8.20.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
