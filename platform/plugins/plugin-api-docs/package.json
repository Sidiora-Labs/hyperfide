{
  "name": "hyperfide-plugin-plugin-api-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browse the hyperfide-platform plugin API as an annotated map of the product.",
  "engines": {
    "hyperfide": ">=0.0",
    "hyperfidePluginSdk": ">=0.4.3"
  },
  "hyperfide": {
    "name": "Plugin Guide",
