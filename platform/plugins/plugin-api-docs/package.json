    "branding": {
      "icon": "./icons/ai-generative.svg",
      "experimental_icons": {
        "guide": "./icons/ai-generative.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "keywords": [
    "hyperfide-plugin"
  ],
  "scripts": {
