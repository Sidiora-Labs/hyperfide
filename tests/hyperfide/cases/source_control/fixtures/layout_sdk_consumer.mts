import fs from 'node:fs/promises';
import path from 'node:path';
import {createRequire} from 'node:module';
import {pathToFileURL} from 'node:url';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';

const root=process.argv[2]!,out=process.argv[3]!,results:string[]=[];
const check=(name:string,value:unknown)=>{if(!value)throw new Error(name);results.push(name);};
const load=(name:string)=>import(pathToFileURL(path.join(root,name)).href);
const {scaffoldPlugin}=await load('lib/templates/src/plugin-scaffold.ts');
const {buildPluginServer}=await load('tools/plugin-build/src/build-plugin-server.ts');
const {resolvePluginBuildToolchain}=await load('tools/plugin-build/src/toolchain.ts');
const {parseChangelog}=await load('lib/changelog/parser.ts');
const {fuzzyMatchText}=await load('lib/fuzzy-match/src/index.ts');
const work=await fs.mkdtemp(path.join(out,'consumer-')),plugin=path.join(work,'hyperfide-plugin-layout-gate');
await scaffoldPlugin({targetDir:plugin,packageName:'hyperfide-plugin-layout-gate',hyperfideVersion:'2.2.0'});
const manifest=JSON.parse(await fs.readFile(path.join(plugin,'package.json'),'utf8'));
check('real-scaffold-emits-public-sdk-pin',manifest.devDependencies['@hyperfide/plugin-sdk']===JSON.parse(await fs.readFile(path.join(root,'sdk/plugins/package.json'),'utf8')).version);
await fs.access(path.join(plugin,'components/ui/button.tsx'));
await fs.mkdir(path.join(plugin,'node_modules/@hyperfide'),{recursive:true});
for(const [name,target]of [['plugin-sdk','sdk/plugins'],['sdk','sdk/client']]as const)await fs.symlink(path.join(root,target),path.join(plugin,'node_modules/@hyperfide',name),'dir');
const pluginRequire=createRequire(path.join(root,'sdk/plugins/package.json'));
for(const name of ['zod','better-sqlite3']){const file=pluginRequire.resolve(name+'/package.json');await fs.symlink(path.dirname(file),path.join(plugin,'node_modules',name),'dir');}
await fs.appendFile(path.join(plugin,'server.ts'),'\nimport { experimental_PluginRpcCallError as LayoutRpcError } from "@hyperfide/plugin-sdk";\nexport function layoutSdkConsumer() { return LayoutRpcError.from(new Error("layout consumer")).code; }\n');
const toolchain=await resolvePluginBuildToolchain(path.join(work,'toolchain'),{onFetchStart(){throw new Error('Pinned installed plugin toolchain is required; network installation is outside this gate');}});
const built=await buildPluginServer(plugin,'2.2.0',toolchain);
const consumer=path.join(plugin,'consumer.mjs');
await fs.writeFile(consumer,`import {realpath} from 'node:fs/promises';
import {createNodeTransport} from '@hyperfide/sdk';
import {experimental_PluginRpcCallError} from '@hyperfide/plugin-sdk';
import {layoutSdkConsumer} from ${JSON.stringify('./'+path.relative(plugin,built.jsPath).split(path.sep).join('/'))};
const transport=createNodeTransport({baseUrl:'http://127.0.0.1:1'});
const body=await transport.readJson(new Response(JSON.stringify({consumer:'category-layout-v1'}),{headers:{'Content-Type':'application/json'}}));
if(body.consumer!=='category-layout-v1'||transport.baseUrl!=='http://127.0.0.1:1'||layoutSdkConsumer()!=='transport_error'||experimental_PluginRpcCallError.from(new Error('consumer')).code!=='transport_error')throw new Error('Public SDK consumer failed');
console.log(JSON.stringify({sdk:await realpath(new URL(import.meta.resolve('@hyperfide/sdk'))),plugin_sdk:await realpath(new URL(import.meta.resolve('@hyperfide/plugin-sdk'))),plugin_result:layoutSdkConsumer()}));\n`);
const child=spawnSync(process.execPath,['--import',path.join(root,'node_modules/tsx/dist/loader.mjs'),consumer],{cwd:plugin,encoding:'utf8',env:{...process.env,NODE_OPTIONS:'',COREPACK_ENABLE_NETWORK:'0'}});
if(child.status!==0)throw new Error(child.stdout+child.stderr);
const observed=JSON.parse(child.stdout.trim());
check('sdk-runtime-resolves-relocated-built-export',observed.sdk.startsWith(path.join(root,'sdk/client/dist/')));
check('plugin-runtime-resolves-relocated-built-export',observed.plugin_sdk.startsWith(path.join(root,'sdk/plugins/dist/')));
check('generated-plugin-build-and-runtime-consumer',observed.plugin_result==='transport_error');
const changelog=parseChangelog('## 2.2.0\n\nRelocated source.\n\n### Libraries\n\n- Preserved behavior.\n');
check('relocated-changelog-parser-executes',changelog[0]?.version==='2.2.0'&&changelog[0]?.sections[0]?.title==='Libraries');
check('relocated-library-transitive-dependency-executes',fuzzyMatchText({items:['sdk/client','core/server'],query:'sdk',getText:(value:string)=>value,limit:1})[0]?.item==='sdk/client');
const artifacts=[];
for(const name of ['package.json','server.ts','components/ui/button.tsx',path.relative(plugin,built.jsPath),path.relative(plugin,built.metaPath)]){const filename=path.join(plugin,name);artifacts.push({path:path.relative(root,filename).split(path.sep).join('/'),sha256:createHash('sha256').update(await fs.readFile(filename)).digest('hex')});}
const report={status:'PASS',assertions:results,consumer:observed,artifacts,node:process.version,toolchain};
await fs.writeFile(path.join(out,'consumer-report.json'),JSON.stringify(report,null,2)+'\n');
console.log(JSON.stringify(report));
