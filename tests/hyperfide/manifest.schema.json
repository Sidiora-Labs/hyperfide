{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperfide.invalid/schemas/qualification-manifest-v2.json",
  "title": "Hyperfide qualification manifest, Git v1 and native v2",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "registered_variant",
    "scope",
    "case_ids",
    "expected_assertion_ids",
    "approval",
    "inputs",
    "resources",
    "seed",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "registered_variant": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "scope": {
      "enum": [
        "task-component",
        "full-case",
        "campaign"
      ]
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(V|SCM)-[0-9]{3}$",
        "minLength": 1
      }
    },
    "expected_assertion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "approved",
        "allowed_actions"
      ],
      "additionalProperties": false,
      "properties": {
        "approved": {
          "const": true
        },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "allow_retained_resources": {
          "type": "boolean",
          "default": false,
          "description": "Explicit authorization to retain inventory resources with recorded owner and expiry."
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "additionalProperties": true
      }
    },
    "seed": {
      "type": "integer"
    },
    "policy": {
      "type": "object"
    },
    "feature": {
      "const": "hyperfide-source-control"
    },
    "native_source": {
      "type": "object",
      "required": [
        "schema_version",
        "scope",
        "revision_id",
        "root_tree_id",
        "authority_epoch",
        "policy_version",
        "manifest",
        "readiness_receipt",
        "toolchain",
        "environment",
        "test_inventory_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organisation_id",
            "repository_id",
            "security_domain_id"
          ],
          "properties": {
            "organisation_id": {
              "type": "string",
              "format": "uuid"
            },
            "repository_id": {
              "type": "string",
              "format": "uuid"
            },
            "security_domain_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "revision_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "root_tree_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authority_epoch": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Canonical positive PostgreSQL bigint authority epoch; maximum 9223372036854775807."
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "readiness_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "toolchain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "required": [
            "platform",
            "identity"
          ],
          "additionalProperties": false,
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "test_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$comment": "Runtime additionally checks registered variant/case/assertion equality, current content pins, action and resource approval, and scope-specific full inventories. Schema validation alone never proves qualification.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "feature",
          "native_source"
        ],
        "properties": {
          "case_ids": {
            "items": {
              "pattern": "^SCM-[0-9]{3}$"
            }
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "feature"
              ]
            },
            {
              "required": [
                "native_source"
              ]
            }
          ]
        },
        "properties": {
          "case_ids": {
            "items": {
              "pattern": "^V-[0-9]{3}$"
            }
          }
        }
      }
    }
  ]
}
