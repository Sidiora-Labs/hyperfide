{
  "name": "@hyperfide/control-services",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../deploy/hyperfide/dist-stamp.mjs write .",
    "check": "tsc -p tsconfig.json --noEmit",
    "control": "node dist/control.js",
    "provisioner": "node dist/provisioner.js",
    "dispatch": "node dist/dispatch.js"
  },
  "dependencies": {
    "@blaxel/core": "0.3.30",
    "pg": "8.23.1",
    "railway": "3.16.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
