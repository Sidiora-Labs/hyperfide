    "menus": {
      "view/title": [
        {
          "command": "codify.tasks.filter",
          "when": "view == codifyTasks",
          "group": "navigation@0"
        },
        {
          "command": "codify.tasks.search",
          "when": "view == codifyTasks",
          "group": "0_filter@1"
        },
        {
          "command": "codify.tasks.filterStatus",
          "when": "view == codifyTasks",
          "group": "0_filter@2"
        },
        {
          "command": "codify.tasks.filterWave",
          "when": "view == codifyTasks",
          "group": "0_filter@3"
        },
        {
          "command": "codify.tasks.filterOwner",
          "when": "view == codifyTasks",
          "group": "0_filter@4"
        },
        {
          "command": "codify.tasks.clearFilters",
          "when": "view == codifyTasks",
          "group": "0_filter@5"
        },
        {
          "command": "codify.refresh",
          "when": "view == codifyTasks",
          "group": "navigation@1"
        },
        {
          "command": "codify.brief",
          "when": "view == codifyTasks",
          "group": "navigation@2"
        },
        {
          "command": "codify.actions",
          "when": "view == codifyTasks",
          "group": "navigation@3"
        },
        {
          "command": "codify.addTask",
          "when": "view == codifyTasks",
          "group": "1_spec@1"
        },
        {
          "command": "codify.newFeature",
          "when": "view == codifyTasks",
          "group": "1_spec@2"
        },
        {
          "command": "codify.lint",
          "when": "view == codifyTasks",
          "group": "1_spec@3"
        },
        {
          "command": "codify.render",
          "when": "view == codifyTasks",
          "group": "1_spec@4"
        },
        {
          "command": "codify.nextTask",
          "when": "view == codifyTasks",
          "group": "2_work@1"
        },
        {
          "command": "codify.wave",
          "when": "view == codifyTasks",
          "group": "2_work@2"
        },
        {
          "command": "codify.review",
          "when": "view == codifyTasks",
          "group": "2_work@3"
        },
        {
          "command": "codify.check",
          "when": "view == codifyTasks",
          "group": "2_work@4"
        },
        {
          "command": "codify.agent.runWave",
          "when": "view == codifyTasks",
          "group": "2_work@5"
        },
        {
          "command": "codify.agent.newChat",
          "when": "view == codifyAgentView",
          "group": "navigation@1"
        },
        {
          "command": "codify.agent.configure",
          "when": "view == codifyAgentView",
          "group": "navigation@2"
        },
        {
          "command": "codify.memories.browse",
          "when": "view == codifyMemories",
          "group": "navigation@0"
        },
        {
          "command": "codify.remember",
          "when": "view == codifyMemories",
          "group": "navigation@1"
        },
        {
          "command": "codify.refresh",
          "when": "view == codifyMemories",
          "group": "navigation@2"
        },
        {
          "command": "codify.memories.classifyAll",
          "when": "view == codifyMemories",
          "group": "1_memory@1"
        },
        {
          "command": "codify.fleet.start",
          "when": "view == codifyFleet && !codify.fleet.running",
          "group": "navigation@0"
        },
        {
          "command": "codify.fleet.stop",
          "when": "view == codifyFleet && codify.fleet.running",
          "group": "navigation@0"
        },
        {
          "command": "codify.fleet.pause",
          "when": "view == codifyFleet && codify.fleet.running",
          "group": "navigation@1"
        },
        {
          "command": "codify.fleet.resume",
          "when": "view == codifyFleet && codify.fleet.paused",
          "group": "navigation@1"
        },
        {
          "command": "codify.fleet.refresh",
          "when": "view == codifyFleet",
          "group": "navigation@2"
        },
        {
          "command": "codify.fleet.begin",
          "when": "view == codifyFleet",
          "group": "navigation@3"
        },
        {
          "command": "codify.fleet.approve",
          "when": "view == codifyFleet",
          "group": "1_fleet@0"
        },
        {
          "command": "codify.fleet.land",
          "when": "view == codifyFleet",
          "group": "1_fleet@1"
        },
        {
          "command": "codify.fleet.openPr",
          "when": "view == codifyFleet",
          "group": "1_fleet@2"
        },
        {
          "command": "codify.fleet.checkpoint",
          "when": "view == codifyFleet",
          "group": "1_fleet@3"
        },
        {
          "command": "codify.sandboxes.refresh",
          "when": "view == codifySandboxes",
          "group": "navigation"
        },
        {
          "command": "codify.needs.refresh",
          "when": "view == codifyNeeds",
          "group": "navigation@0"
        },
        {
          "command": "codify.issues.refresh",
          "when": "view == codifyIssues",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "codify.tasks.detail",
          "when": "view == codifyTasks && viewItem =~ /^task-/",
          "group": "1_task@0"
        },
        {
          "command": "codify.tasks.verify",
          "when": "view == codifyTasks && viewItem =~ /^task-/",
          "group": "1_task@3"
        },
        {
          "command": "codify.tasks.copyPrompt",
          "when": "view == codifyTasks && viewItem =~ /^task-/",
          "group": "1_task@4"
        },
        {
          "command": "codify.tasks.openBranch",
          "when": "view == codifyTasks && viewItem =~ /^task-/",
          "group": "2_claim@3"
        },
        {
          "command": "codify.startTask",
          "when": "view == codifyTasks && viewItem == task-pending",
          "group": "inline@1"
        },
        {
          "command": "codify.implementedTask",
          "when": "view == codifyTasks && viewItem == task-in_progress",
          "group": "inline@1"
        },
        {
          "command": "codify.doneTask",
          "when": "view == codifyTasks && viewItem =~ /^task-(in_progress|implemented)$/",
          "group": "inline@2"
        },
        {
          "command": "codify.traceTask",
          "when": "view == codifyTasks && viewItem =~ /^task-/",
          "group": "1_task@1"
        },
        {
          "command": "codify.openTask",
          "when": "view == codifyTasks && viewItem =~ /^task-/",
          "group": "1_task@2"
        },
        {
          "command": "codify.claimTask",
          "when": "view == codifyTasks && viewItem =~ /^task-/ && codify.parallel",
          "group": "2_claim@1"
        },
        {
          "command": "codify.releaseTask",
          "when": "view == codifyTasks && viewItem =~ /^task-/ && codify.parallel",
          "group": "2_claim@2"
        },
        {
          "command": "codify.agent.startOnTask",
          "when": "view == codifyTasks && viewItem =~ /^task-(pending|in_progress)$/",
          "group": "inline@3"
        },
        {
          "command": "codify.agent.openPanel",
          "when": "view == codifyTasks && viewItem =~ /^task-(pending|in_progress)$/",
          "group": "3_agent@0"
        },
        {
          "command": "codify.agent.startHeadless",
          "when": "view == codifyTasks && viewItem =~ /^task-(pending|in_progress)$/",
          "group": "3_agent@1"
        },
        {
          "command": "codify.agent.resume",
          "when": "view == codifyTasks && viewItem == task-in_progress",
          "group": "3_agent@2"
        },
        {
          "command": "codify.agent.handoff",
          "when": "view == codifyTasks && viewItem == task-in_progress",
          "group": "3_agent@3"
        },
        {
          "command": "codify.agent.stop",
          "when": "view == codifyTasks && viewItem =~ /^task-/",
          "group": "3_agent@4"
        },
        {
          "command": "codify.forget",
          "when": "view == codifyMemories && viewItem == memory",
          "group": "inline"
        },
        {
          "command": "codify.memories.supersede",
          "when": "view == codifyMemories && viewItem == memory",
          "group": "1_memory@1"
        },
        {
          "command": "codify.memories.promote",
          "when": "view == codifyMemories && viewItem == memory",
          "group": "1_memory@2"
        },
        {
          "command": "codify.fleet.openTranscript",
          "when": "view == codifyFleet && viewItem =~ /^fleet-(main|manager|worker)/",
          "group": "inline@0"
        },
        {
          "command": "codify.fleet.approve",
          "when": "view == codifyFleet && viewItem == fleet-approval",
          "group": "inline@0"
        },
        {
          "command": "codify.fleet.openWorktree",
          "when": "view == codifyFleet && viewItem =~ /-worktree/",
          "group": "inline@1"
        },
        {
          "command": "codify.fleet.begin",
          "when": "view == codifyFleet && viewItem =~ /^fleet-task-(pending|in_progress)$/",
          "group": "inline@1"
        },
        {
          "command": "codify.fleet.mergeUp",
          "when": "view == codifyFleet && viewItem =~ /^fleet-(worker|task-)/",
          "group": "1_fleet@1"
        },
        {
          "command": "codify.fleet.begin",
          "when": "view == codifyFleet && viewItem =~ /^fleet-worker/",
          "group": "1_fleet@2"
        },
        {
          "command": "codify.fleet.land",
          "when": "view == codifyFleet && viewItem =~ /^fleet-(main|manager)/",
          "group": "1_fleet@1"
        },
        {
          "command": "codify.fleet.openPr",
          "when": "view == codifyFleet && viewItem =~ /^fleet-manager/",
          "group": "1_fleet@2"
        },
        {
          "command": "codify.fleet.checkpoint",
          "when": "view == codifyFleet && viewItem =~ /^fleet-main/",
          "group": "1_fleet@3"
        },
        {
          "command": "codify.fleet.openWorktree",
          "when": "view == codifyFleet && viewItem =~ /-worktree/",
          "group": "2_open@1"
        },
        {
          "command": "codify.fleet.openSessionTranscript",
          "when": "view == codifyFleet && viewItem =~ /^fleet-native.*-ntx/",
          "group": "inline@0"
        },
        {
          "command": "codify.fleet.openSessionWorktree",
          "when": "view == codifyFleet && viewItem =~ /^fleet-native.*-nwt/",
          "group": "inline@1"
        },
        {
          "command": "codify.sandboxes.attach",
          "when": "view == codifySandboxes && viewItem == sandbox-worker-session",
          "group": "inline@0"
        },
        {
          "command": "codify.needs.answer",
          "when": "view == codifyNeeds && viewItem == needs-row-answerable",
          "group": "inline"
        },
        {
          "command": "codify.issues.open",
          "when": "view == codifyIssues && viewItem =~ /^issues-row/",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "codify.why",
          "when": "editorTextFocus && codify.hasSpec",
          "group": "codify@1"
        },
        {
          "command": "codify.testImpact",
          "when": "editorTextFocus",
          "group": "codify@2"
        }
      ],
      "explorer/context": [
        {
          "command": "codify.render",
          "when": "resourceExtname == .kvx",
          "group": "codify@1"
        },
        {
          "command": "codify.lint",
          "when": "resourceExtname == .kvx",
          "group": "codify@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codify.openTask",
          "when": "false"
        },
        {
          "command": "codify.forget",
          "when": "false"
        },
        {
          "command": "codify.needs.answer",
          "when": "false"
        },
        {
          "command": "codify.issues.open",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Hyperfide",
      "properties": {
        "codify.serve": {
          "type": "boolean",
          "default": true,
          "description": "Keep one `hyperfide serve` connection open for every call and live events (no polling). Off, or with an older hyperfide, the extension shells out and polls as before."
        },
        "codify.binaryPath": {
          "type": "string",
          "default": "cg",
          "description": "Deprecated: use hyperfide.binaryPath. An explicit value is honoured only when hyperfide.binaryPath is unset."
        },
        "codify.feature": {
          "type": "string",
          "default": "",
          "description": "Spec feature override (passed as -f). Empty uses [meta] active_feature."
        },
        "codify.languageServer": {
          "type": "boolean",
          "default": true,
          "description": "Run `hyperfide lsp` for go-to-definition, references, hover, code lens, and scope diagnostics. Turn off to use the task board alone."
        },
        "codify.agentName": {
          "type": "string",
          "default": "",
          "description": "Default name used when claiming a task in parallel mode."
        },
        "codify.agent.driver": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "custom"
          ],
          "default": "codex",
          "description": "Which agent provider drives sessions: the Codex adapter, the Claude Code adapter, or the custom ACP command in codify.acp.customCommand. The Agent view's provider picker changes this for the next chat."
        },
        "codify.agent.interface": {
          "type": "string",
          "enum": [
            "panel",
            "terminal"
          ],
          "default": "panel",
          "description": "How a task agent session opens: the Hyperfide agent panel (ACP) or a seeded terminal. The terminal is offered as the fallback when the ACP adapter fails to start."
        },
        "codify.acp.claudeCommand": {
          "type": "string",
          "default": "claude-code-acp",
          "description": "Command that starts the Claude Code ACP adapter (quote-aware; e.g. npx -y @zed-industries/claude-code-acp)."
        },
        "codify.acp.codexCommand": {
          "type": "string",
          "default": "npx -y @agentclientprotocol/codex-acp@1.7.0",
          "description": "Command that starts the Codex ACP adapter (quote-aware). The verified default uses the maintained Agent Client Protocol adapter."
        },
        "codify.acp.customCommand": {
          "type": "string",
          "default": "",
          "description": "Any ACP-speaking agent command, offered as the Custom provider in the Agent view. Selected explicitly with codify.agent.driver = custom, or used by default when it is set and no provider was picked."
        },
        "codify.acp.diffStyle": {
          "type": "string",
          "enum": [
            "unified",
            "split"
          ],
          "default": "unified",
          "description": "How a file edit opens in the agent chat: one unified column, or old and new side by side. Each diff can still be flipped in place."
        },
        "codify.acp.envRefs": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "pattern": "^secret-ref:[A-Za-z0-9._/-]+$"
          },
          "description": "Variables the ACP adapter starts with, as NAME: \"secret-ref:ID\". Only references live here; each value is kept in VS Code secret storage under its ID and asked for once."
        },
        "codify.acp.mcpEnv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Variable names passed to the injected Hyperfide MCP server, each from codify.acp.envRefs when referenced there, otherwise from the editor's environment. Nothing else is passed."
        },
        "codify.acp.authMethod": {
          "type": "string",
          "default": "",
          "description": "ACP auth method id used when an agent asks for sign-in. Empty: use the only method offered, or ask."
        },
        "codify.acp.selectionContext": {
          "type": "boolean",
          "default": true,
          "description": "Attach the current editor selection to the next chat message (embedded when the agent accepts it, otherwise as a link)."
        },
        "codify.agent.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Path to the Codex CLI."
        },
        "codify.agent.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude Code CLI."
        },
        "codify.agent.codexArgs": {
          "type": "string",
          "default": "",
          "description": "Extra arguments passed to codex when starting a session."
        },
        "codify.agent.claudeArgs": {
          "type": "string",
          "default": "",
          "description": "Extra arguments passed to claude when starting a session."
        },
        "codify.agent.parallelism": {
          "type": "number",
          "default": 2,
          "description": "Agent slots used by Hyperfide: Run Wave with Agents (hyperfide spec run -n)."
        },
        "hyperfide.binaryPath": {
          "type": "string",
          "default": "hyperfide",
          "description": "Canonical Hyperfide executable. Explicit conflicting codify.binaryPath settings are refused."
        }
      }
    }
  }
}
