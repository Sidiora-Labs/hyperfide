{
  "name": "codify-workflow",
  "displayName": "Hyperfide Workflow",
  "description": "Hyperfide agent workflow, distributed fleet supervision and compatible local code graph navigation.",
  "version": "2.0.0-dev",
  "publisher": "SidioraLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidiora-labs/codify"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other",
    "Linters"
  ],
  "keywords": [
    "hyperfide",
    "codify",
    "code graph",
    "spec",
    "agent",
    "kvx"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kvx",
        "aliases": [
          "kvx",
          "Ion KVX"
        ],
        "extensions": [
          ".kvx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kvx",
        "scopeName": "source.kvx",
        "path": "./syntaxes/kvx.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codify",
          "title": "Hyperfide",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "codify": [
        {
          "id": "codifyTasks",
          "name": "Tasks",
          "contextualTitle": "Hyperfide Tasks"
        },
        {
          "type": "webview",
          "id": "codifyAgentView",
          "name": "Agent",
          "contextualTitle": "Hyperfide Agent"
        },
        {
          "id": "codifyMemories",
          "name": "Memory",
          "contextualTitle": "Hyperfide Memory",
          "visibility": "collapsed"
        },
        {
          "id": "codifyFleet",
          "name": "Fleet",
          "contextualTitle": "Hyperfide Fleet",
          "visibility": "collapsed"
        },
        {
          "id": "codifySandboxes",
          "name": "Sandboxes",
          "contextualTitle": "Hyperfide Sandboxes",
          "visibility": "collapsed"
        },
        {
          "id": "codifyNeeds",
          "name": "Needs",
          "contextualTitle": "Hyperfide Needs",
          "visibility": "collapsed"
        },
        {
          "id": "codifyIssues",
          "name": "Issues",
          "contextualTitle": "Hyperfide Issues",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codifyTasks",
        "contents": "No Hyperfide spec found.\nA task board appears here when the workspace contains spec/workflow.kvx and the hyperfide binary is on PATH (or set hyperfide.binaryPath).\n[Create a feature spec](command:codify.newFeature)\n[Refresh](command:codify.refresh)"
      },
      {
        "view": "codifyMemories",
        "contents": "No project memories yet.\nMemories are decisions, constraints, and facts worth knowing in a later session. They live in .codegraph beside the code graph.\n[Remember a decision](command:codify.remember)"
      },
      {
        "view": "codifyFleet",
        "contents": "No fleet here yet.\nA fleet is Main Gideon, one manager per feature, and one worker per wave \u2014 each on its own branch and worktree. It appears once spec/workflow.kvx has a [hierarchy] section.\n[Start the fleet](command:codify.fleet.start)\n[Begin a task in the fleet](command:codify.fleet.begin)\n[Refresh](command:codify.fleet.refresh)"
      },
      {
        "view": "codifySandboxes",
        "contents": "No sandboxes to show.\nThis view reads the console.sandboxes inventory from the Hyperfide control service (hyperfide console sandboxes). It lists sandboxes once the workspace is in distributed authority mode and the organisation has some.\n[Refresh](command:codify.sandboxes.refresh)"
      },
      {
        "view": "codifyNeeds",
        "contents": "Nothing needs you.\nAsks (secrets, variables, permissions, decisions, questions), human intents and admission escalations appear here from the Hyperfide console, or this project's local Asks.\n[Refresh](command:codify.needs.refresh)"
      },
      {
        "view": "codifyIssues",
        "contents": "No issues.\nThe leader queue, external intake, escalated repairs and drift appear here from the Hyperfide console and the local drift log.\n[Refresh](command:codify.issues.refresh)"
      }
    ],
