{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hyperfide internal service component v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task",
    "roles",
    "module",
    "entry",
    "api_version",
    "actions",
    "requires"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "const": "system"
      }
    },
    "task": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "control",
          "provisioner",
          "dispatch"
        ]
      }
    },
    "module": {
      "type": "string",
      "pattern": "^[^/\\\\].*\\.js$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "api_version": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    }
  }
}
