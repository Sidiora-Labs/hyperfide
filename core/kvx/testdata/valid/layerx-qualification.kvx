[observation.22.5.1]
task = "22.5"
file = "contracts/CheckpointRegistry.sol, contracts/challenge/CheckpointChallengeManager.sol, contracts/EmergencyExit.sol, test/CheckpointRegistry.t.sol, test/ContractIntegration.t.sol"
symbol = "CheckpointRegistry.invalidateCheckpoint, CheckpointRegistry.latestCanonicalCheckpointHash, EmergencyExit.latestCheckpointHash"
observed = "The inherited emergency-exit path treated an upheld challenge against the latest checkpoint as both the eligibility trigger and the checkpoint whose state root authorised payout. The repair makes challenge resolution record an irreversible invalidation watermark through the existing slashing-authority boundary, preserves every registered checkpoint and certificate for audit, makes the challenged checkpoint and all descendants non-canonical, halts further registration on that invalid lineage, and selects the immediately preceding canonical checkpoint for emergency exit. If the first registered checkpoint is invalidated, no certificate-backed predecessor is invented and exit remains fail-closed."
assumption = "Human qualification must exercise an upheld challenge against the latest and a non-latest checkpoint, prove no invalid checkpoint or descendant can authorise a withdrawal or emergency exit, prove the last canonical predecessor remains executable with sequencer and guarantors offline, and confirm deployment sets the challenge manager as the GuarantorBond slashing authority before challenges are accepted. No build or test result is asserted by this implementation repair."
severity = "qualification-repair"

[observation.1.4.1]
task = "1.4"
file = "src/protocol/lxp_arena.c, tests/protocol/lxp_test_arena.c"
symbol = "lxp_arena_alloc"
observed = "Post-implementation review found that a valid zero-capacity arena could reach null-pointer arithmetic during a zero-byte allocation. The repair defines that exact case as a successful null allocation and refuses every nonzero request as arena exhaustion without pointer arithmetic."
assumption = "Human qualification must run the arena suite under the declared sanitizers and retain identical allocation/content behavior for nonempty arenas. No passing test result is asserted here."
severity = "post-implementation-repair"

[observation.2.1.1]
task = "2.1"
file = "src/codec/lxp_codec.c, tests/codec/lxp_test_codec_primitives.c"
symbol = "lxp_codec_read_u16"
observed = "The primitive decoder consumed two input bytes before checking whether the caller supplied an output pointer. The repair refuses a null output before reading, so a rejected call leaves the canonical decoder cursor unchanged."
assumption = "Human qualification must exercise every primitive reader with null output, truncation and exact-boundary input and confirm rejection never advances the cursor."
severity = "post-implementation-repair"

