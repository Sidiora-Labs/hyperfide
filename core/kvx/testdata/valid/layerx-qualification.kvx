[observation.17.1.2]
task = "17.1"
file = "src/modules/asset, src/modules/budget, src/modules/escrow, src/modules/governance, src/modules/perps, src/modules/service, src/modules/stream, tests/modules, tests/test_governance_emergency.c"
symbol = "epoch callbacks and fixed-capacity public mutation helpers"
observed = "A second full traversal audit found epoch callbacks, reverse lookups, state-root and reserve helpers, idempotency tables, delegate and meter key arrays, oracle accepted/key stores, governance emergency state and effect buffers that still trusted caller-visible counts. Several append paths called a bounded lookup but discarded its malformed-store result, then checked only count equal to capacity; count above capacity could therefore proceed through a balance transfer and out-of-bounds append. The repair performs typed structural admission before every affected traversal or economic mutation, makes the boolean withdrawal replay helper conservatively report seen for malformed state while public mutators return NON_CANONICAL, and caps asset attestations to the asset registry bound."
assumption = "Human qualification must exercise each epoch and helper with every count at zero, exact capacity and capacity plus one under memory instrumentation, prove malformed mutation requests emit no transfer and change no state, and retain canonical roots, reserve totals, replay receipts and valid exact-capacity behavior. No build or test result is asserted here."
severity = "post-implementation-repair"

[observation.22.2.1]
task = "22.2"
file = "contracts/GuarantorBond.sol, contracts/CheckpointRegistry.sol, contracts/challenge/CheckpointChallengeManager.sol, spec/layerx-protocol/docs/guarantors.md"
symbol = "GuarantorBond.activateGuarantor, GuarantorBond.depositBond, GuarantorBond.submitEquivocation, GuarantorBond.membershipVersion, CheckpointRegistry.verifyRegisteredCertificate"
observed = "Post-implementation review found that depositBond created its own guarantor identity, signer and caller-selected joined epoch, allowing bond funding to manufacture historical threshold membership, and registered-certificate verification accepted a caller-selected epoch instead of the recorded checkpoint epoch. A follow-up review found that merely recording the set version was insufficient because verification still consulted current jail, slashing, bond and minimum-bond state, and permissionless equivocation accepted a caller-selected removal epoch that could rewrite membership history. The repair separates strictly sequenced governed activation, rotation, jailing and removal from permissionless funding, binds each exact registered certificate to its immutable checkpoint epoch and guarantor-set version, verifies recorded certificates without mutable current eligibility, and makes proven slashing an immediate versioned exclusion without inventing a removal epoch or rewriting signer intervals. The normative guarantor guide currently orders bond posting before the GOV_SET_GUARANTOR_SET activation step, while the explicit repair requirement permits deposits only after an authorised record exists; the implementation follows the explicit fail-closed repair boundary and does not preserve self-enrolment as a pre-activation funding shortcut."
assumption = "Human qualification must reconcile the onboarding-order wording with the governed Paxeer record ceremony and exercise sequence replay, rotation, governed removal, permissionless funding, old-signer equivocation, outside-set signatures and recorded-certificate verification after jailing, unresolved slashing, rotation, removal, unbonding, slashing and minimum-bond changes. No build or test result is asserted here."
severity = "spec-conflict"

[observation.19.4.1]
task = "19.4"
file = "include/layerx/lxp_guarantor.h, src/guarantor/lxp_attestation.c, src/guarantor/lxp_guarantor.c, src/guarantor/lxp_equivocation.c, src/paxeer/lxp_bond_client.c, src/paxeer/lxp_slashing_submit.c, contracts/libraries/CanonicalCheckpoint.sol, contracts/GuarantorBond.sol, contracts/CheckpointRegistry.sol, agent/crates/layerx-proof/src/checkpoint.rs, human/crates/layerx-paxeer-client/src/withdraw.rs, platform/sdk, agent/sdk, spec/layerx-protocol/docs/guarantors.md, spec/layerx-protocol/docs/wire-format.md"
symbol = "lxp_guarantor_attestation, lxp_equivocation_verify, lxp_slashing_submit, CanonicalCheckpoint.attestationHash, GuarantorBond.submitEquivocation"
observed = "Post-implementation review found that the signed guarantor statement omitted protocol, LayerX network, Paxeer chain, settlement contract and checkpoint epoch, so two otherwise valid signatures from unrelated networks or settlement deployments could be presented as a same-height contradiction, while the slashing target could establish only that the key had once existed. The repair defines one 189-byte big-endian signed statement under the distinct LXP/v1/guarantor-attestation domain, requires an exact protocol/network/Paxeer-chain/settlement-contract/epoch/batch coordinate, requires each checkpoint identifier to equal its signed checkpoint hash and the two hashes to differ, checks the evidence epoch against the historical signer-authorisation interval, and makes accepted evidence an immediate versioned ejection without a submitter-selected removal epoch. Certificate producers and verifiers carry the same domain coordinate and reject header or settlement-domain mismatch. The normative guarantor and wire-format guides still specify a 55-byte checkpoint_id-plus-flags preimage and describe body-assisted contradiction checks; that format cannot satisfy the explicit cross-network replay rejection and self-contained historical-height slashing requirements, so generated or normative documents were not hand-edited around the contradiction."
assumption = "Human qualification must reconcile and regenerate the normative wire documents, regenerate every published SDK artifact from source, publish cross-language golden vectors for the 189-byte signed statement, 277-byte canonical C attestation record and enclosing equivocation evidence, and exercise foreign LayerX network, foreign Paxeer chain, foreign settlement contract, mixed epoch, mixed batch, unauthorized-era signer, rotated historical signer, malformed identifier/hash relation and genuine same-domain same-height conflicts. No build, test, formatting or qualification result is asserted here."
severity = "spec-conflict"

[observation.19.4.2]
task = "19.4"
file = "contracts/CheckpointRegistry.sol, include/layerx/lxp_guarantor.h, include/layerx/lxp_paxeer.h, src/guarantor/lxp_attestation.c, src/guarantor/lxp_bond_state.c, src/paxeer/lxp_finalisation.c, src/paxeer/lxp_paxeer_client.c, src/paxeer/lxp_slashing_submit.c, agent/crates/layerx-crypto/src/secp256k1.rs, agent/crates/layerx-proof/src/checkpoint.rs, human/crates/layerx-paxeer-client/src/withdraw.rs, agent/sdk, platform/sdk"
symbol = "CheckpointRegistry._wallClockMilliseconds, lxp_guarantor_signer_authorization, lxp_guarantor_attest, lxp_checkpoint_registration, WithdrawalBoundary.rpc"
observed = "The integration review found three cross-boundary failures after the domain-bound attestation repair. Canonical batch and attestation timestamps are unsigned milliseconds, while CheckpointRegistry compared them directly with EVM wall-clock seconds and second-denominated configuration; the registry now preserves the canonical millisecond fields and performs checked seconds-to-milliseconds conversion only at its wall-clock boundary. The C Paxeer mirror previously overwrote the sole signer key on rotation, so old-key evidence and pre-rotation certificates could not be verified; each member now retains a bounded, version-stamped, half-open signer-authorisation history, finalisation selects the key authorised at the checkpoint epoch, and slashing accepts a historically authorised old signer while recording an immediate versioned ejection. C signing previously emitted only compact r||s and could not produce the Solidity signer+r+s+v tuple; signing now derives the EVM signer, searches all four secp256k1 recovery identifiers, admits only the Solidity-representable 0/1 cases as v 27/28, explicitly fails the rare 2/3 case, and lxp_checkpoint_registration exposes the exact typed header, validity proof and 18-field Paxeer attestations. Rust verifies the carried signer and recovery byte against the member key, while SDK verifier source types carry signer and recovery metadata and reject absent or non-EVM values. The rebased Human withdrawal boundary obtains every registry-domain field and eth_chainId through verifier-owned agreed_call quorum reads; no first-endpoint fallback was introduced. No repository-owned transaction broadcaster consumes lxp_checkpoint_registration and submits registerCheckpoint, so the typed producer-to-contract transport remains an external integration responsibility rather than an end-to-end path proved here."
assumption = "Human qualification must publish new cross-language vectors for canonical millisecond timestamps, the 306-byte C attestation evidence record, signer address, r, s and v; exercise exact drift and delay boundaries around a real 1.7e12 millisecond timestamp; rotate and remove signers around checkpoint epochs; corrupt every set and signer-history count and interval boundary; submit old-key same-height evidence; force a recovery-id 2/3 fixture and confirm publication fails explicitly; prove the new domain reads reject split endpoint observations; and connect the typed C registration output to the real transaction broadcaster. The normative wire guide still describes the superseded 55-byte preimage and must be reconciled and regenerated by its owner. No build, test, formatting, deployment or passing result is asserted by this source repair."
severity = "integration-boundary"

[observation.22.2.2]
task = "22.2"
file = "include/layerx/lxp_paxeer.h, src/paxeer/lxp_bond_client.c, tests/test_paxeer_bond.c"
symbol = "lxp_paxeer_bond_deposit, lxp_paxeer_membership_sync_status"
observed = "The C Paxeer bond mirror still let a bond deposit create a guarantor from caller-selected identity, key and historical joined epoch, and its jail and rotation wrappers manufactured ordered-governance admission internally. The repair removes those unauthenticated Paxeer membership mutation wrappers, makes deposit accept only value for an already governed core record without advancing membership version, and exposes an explicit typed UNAVAILABLE membership-sync status. The repository contains no authentic producer or verifier for the identical Paxeer and LayerX GOV_SET_GUARANTOR_SET registry evidence, so the C Paxeer client fails closed at that integration boundary instead of representing a caller boolean as governance authority. Core signer history and ordered set application remain the state-machine consumer for a future authenticated registry producer."
assumption = "Human qualification must provide and bind the real canonical membership-registry evidence producer before enabling C Paxeer membership sync; prove identity, signer, activation/removal epoch, governance sequence and set version against both registries; then exercise deposit before activation, after activation, after removal and after versioned ejection. No build, test, formatting, deployment or passing result is asserted by this source repair."
severity = "integration-boundary"
