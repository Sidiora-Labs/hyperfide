[observation.23.5.1]
task = "23.5"
file = "cmd/layerxd/lxp_daemon_config.c, tests/test_layerxd.c"
symbol = "parse_u64"
observed = "The daemon configuration delegated unsigned parsing directly to strtoull, which accepts a leading minus sign and can map -1 to UINT64_MAX. The repair requires the first value byte to be an ASCII digit before conversion, thereby also refusing plus signs and whitespace-prefixed values."
