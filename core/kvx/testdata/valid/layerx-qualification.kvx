file = "include/layerx/lxp_governance.h, src/modules/governance/lxp_params.c, src/modules/governance/lxp_gov_param.c, tests/test_governance_params.c"
symbol = "lxp_param_table_validate"
observed = "Governance parameter APIs traversed caller-visible count, version, proposal, key, history and cohort fields before proving they fit their fixed arrays. A corrupt restored or directly supplied table could therefore read out of bounds in lookup, proposal, activation, enactment, version and state-root paths. The repair centralises structural admission and invokes it before every public traversal or mutation."
assumption = "Human qualification must corrupt each table and nested count one at a time at exact capacity and capacity plus one, exercise every public parameter and rollout API, and confirm valid activation roots and histories are unchanged. No build or test result is asserted here."
severity = "post-implementation-repair"

