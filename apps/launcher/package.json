{
  "name": "hyperfide-app",
  "version": "0.46.1",
  "description": "hyperfide app launcher for npx",
  "keywords": [
    "hyperfide",
    "coding-agent",
    "agent",
    "cli",
    "workspace",
    "codex",
    "claude-code"
  ],
  "homepage": "https://github.com/hyperfide/hyperfide#readme",
  "bugs": {
    "url": "https://github.com/hyperfide/hyperfide/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperfide/hyperfide.git",
    "directory": "apps/launcher"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/public-sdk.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/hyperfide-app.js": "./dist/hyperfide-app.js"
  },
  "types": "./dist/index.d.ts",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "bin": {
    "hyperfide-app": "dist/hyperfide-app.js",
    "hyperfide": "dist/hyperfide.js",
    "hyperfide-server": "dist/hyperfide-server.js",
    "hyperfide-host-daemon": "dist/hyperfide-host-daemon.js"
  },
  "files": [
    "app/dist",
    "dist",
    "host-daemon/dist/hyperfide",
    "host-daemon/dist/hyperfide.cmd",
    "host-daemon/dist/hyperfide-chunks",
    "host-daemon/dist/hyperfide-parcel-watcher-child.mjs",
    "host-daemon/dist/hyperfide-plugin-host-worker.mjs",
    "host-daemon/dist/hyperfide-provider-bridge-worker.mjs",
    "host-daemon/dist/daemon-bundle.mjs",
    "server/dist",
    "README.md",
    "!**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "clean": "rimraf dist app host-daemon server tsconfig.tsbuildinfo",
    "prepack": "node dist/prune-hyperfide-chunks.mjs",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "13.0.3",
    "fs-native-extensions": "1.5.0",
    "hono": "^4.7.0",
    "node-pty": "1.2.0-beta.15",
    "npm": "11.16.0",
    "picocolors": "^1.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hyperfide/config": "workspace:*",
    "@hyperfide/host-daemon-contract": "workspace:*",
    "@hyperfide/sdk": "workspace:*",
    "@hyperfide/server-archive": "workspace:*",
    "@hyperfide/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "rimraf": "^6.1.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "semver": "^7.7.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  }
}
