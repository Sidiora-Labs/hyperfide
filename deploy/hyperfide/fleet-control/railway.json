{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/hyperfide/fleet-control/Dockerfile",
    "watchPatterns": ["/core/control-plane/**", "/contracts/fleet/**", "/deploy/hyperfide/fleet-control/**", "/deploy/hyperfide/fleet-env.mjs", "/deploy/hyperfide/dist-stamp.mjs"]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "sleepApplication": false
  }
}
