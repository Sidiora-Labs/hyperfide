[Unit]
Description=Hyperfide Primary and Wave Manager fleet supervisor
After=network-online.target hyperfide-control.service
Wants=network-online.target
[Service]
Type=exec
User=hyperfide
Group=hyperfide
WorkingDirectory=/opt/hyperfide/current
ExecStart=/opt/hyperfide/current/runtime/node /opt/hyperfide/current/services/dist/fleet-supervisor.js --config /etc/hyperfide/fleet-supervisor.json
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
KillMode=control-group
TimeoutStopSec=130
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hyperfide/fleet-supervisor
UMask=0077
[Install]
WantedBy=multi-user.target
