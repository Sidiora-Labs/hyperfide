[Unit]
Description=Hyperfide provider provisioner
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=hyperfide-provisioner
Group=hyperfide
WorkingDirectory=/opt/hyperfide/current
EnvironmentFile=/etc/hyperfide/provisioner.env
Environment=HF_PROVISIONER_EXECUTOR_CONFIG_FILE=/etc/hyperfide/provisioner-worker.json
Environment=HF_IDENTITY_CONFIG_FILE=/etc/hyperfide/provisioner-identity.json
ExecStart=/opt/hyperfide/current/runtime/node /opt/hyperfide/current/services/dist/provisioner.js --mode https --host ${HYPERFIDE_PROVISIONER_LISTEN_HOST} --port ${HYPERFIDE_PROVISIONER_LISTEN_PORT} --tls-cert /etc/hyperfide/provisioner.crt --tls-key /etc/hyperfide/provisioner.key --policy /etc/hyperfide/provisioner-policy.json --spec-revision ${HYPERFIDE_SPEC_REVISION}
Restart=on-failure
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hyperfide
Environment=HYPERFIDE_SUPERVISOR_PYTHON=/opt/hyperfide/current/runtime/python/bin/python3
Environment=LD_LIBRARY_PATH=/opt/hyperfide/current/lib/hyperfide
UMask=0077
[Install]
WantedBy=multi-user.target
