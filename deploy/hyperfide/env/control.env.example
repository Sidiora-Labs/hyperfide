# Operator template, installed as /etc/hyperfide/control.env (root:root 0600). Replace placeholders before starting.
# Never add migration credentials or the migration job flag here; the preflight refuses with MIGRATION_CREDENTIAL_EXPOSED.
HYPERFIDE_LISTEN_HOST=127.0.0.1
HYPERFIDE_LISTEN_PORT=REPLACE_WITH_PORT
HYPERFIDE_SPEC_REVISION=REPLACE_WITH_APPROVED_REVISION
HYPERFIDE_REQUIRE_SYNC_REPLICA=REPLACE_WITH_0_OR_1
HYPERFIDE_DEPLOYMENT_ID=REPLACE_WITH_DEPLOYMENT_UUID
HYPERFIDE_AUTHORITY_JOURNAL_DIR=/var/lib/hyperfide/control/authority-journal
HYPERFIDE_CAUSAL_BARRIER_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
HF_IDENTITY_CONFIG_FILE=/etc/hyperfide/control-identity.json
# Optional. Operator credential UUIDs, comma-separated, allowed to request a DEPLOYMENT-wide stop (D14). Unset or empty refuses every DEPLOYMENT stop.
# HYPERFIDE_DEPLOYMENT_OPERATORS=REPLACE_WITH_OPERATOR_CREDENTIAL_UUID
# Optional. Stop driver poll interval in ms; default 5000, 0 disables the driver, maximum 3600000.
# HYPERFIDE_STOP_DRIVER_INTERVAL_MS=5000
# Provider resolution policy window (D15): orphans and quarantined intents unresolved this long become decision Asks.
# No code default; provider.resolutions.escalate refuses with RESOLUTION_WINDOW_REQUIRED until the operator sets it (3600 recommended):
# HYPERFIDE_PROVIDER_RESOLUTION_WINDOW_SECONDS=3600
# Written by hand to /etc/hyperfide/control.db.env (root:root 0600), loaded by the db-env.conf drop-in:
# HYPERFIDE_CONTROL_PRIMARY_DATABASE_URL=postgresql://REPLACE_WITH_SCOPED_ROLE:REPLACE_WITH_SECRET@REPLACE_WITH_HOST/hyperfide
# Drain and offline policy (recovery.stop, recovery.offline; see docs/hyperfide/operations.md, "Stop, recovery and retention").
# Optional. Drain deadline in ms before the fallback applies; default 300000, a positive integer at most 86400000.
# HYPERFIDE_DRAIN_TIMEOUT_MS=300000
# Optional. What a drain that misses its deadline becomes: STOP (default) or PAUSE.
# HYPERFIDE_DRAIN_FALLBACK_MODE=STOP
# Optional. Behaviour while the control service is unreachable: PAUSE (default) or BOUNDED_LOCAL.
# HYPERFIDE_OFFLINE_POLICY=PAUSE
# Optional. Longest BOUNDED_LOCAL run without the control service, in ms; default 0 (none), at most 86400000.
# HYPERFIDE_MAX_OFFLINE_MS=0
# Every other variable the control service reads, by area: names only, set the ones your deployment uses.
# Secrets (keys, tokens, database URLs) belong in a root-only drop-in like control.db.env, never in this file.
# agents: HF_AGENT_ADMISSION_POLICY_FILE HF_CONNECTOR_QUALIFICATION_SIGNING_KEY_FILE HF_CONNECTOR_QUALIFICATION_TTL_SECONDS HF_NATIVE_AUTH_PROFILES_FILE HF_SUPERVISOR_LAUNCH_PROFILES_FILE HF_SUPERVISOR_NATIVE_RUNNER HF_SUPERVISOR_NATIVE_RUNNER_DIGEST HF_SUPERVISOR_PLAN_ROOT HF_SUPERVISOR_PRIVATE_SPOOL HYPERFIDE_AUTHORITY_DESCRIPTOR HYPERFIDE_MCP_TOOL_POLICY_FILE HYPERFIDE_MODE HYPERFIDE_SUPERVISORY_HOST_SOCKET HYPERFIDE_TRANSPORT_CONFIG
# artifacts: HF_ARTIFACT_ALLOWED_RUN_IDS HF_ARTIFACT_ALLOW_LOOPBACK_HTTP HF_ARTIFACT_ORGANISATION_ID HF_ARTIFACT_RETENTION_POLICY_FILE HF_ARTIFACT_S3_ACCESS_KEY_ID HF_ARTIFACT_S3_BUCKET HF_ARTIFACT_S3_ENDPOINT HF_ARTIFACT_S3_REGION HF_ARTIFACT_S3_SECRET_ACCESS_KEY HF_ARTIFACT_S3_SESSION_TOKEN
# assurance: HF_CHECKPOINT_ALLOWED_ROOT HF_CHECKPOINT_SPOOL_ROOT HF_QUALIFICATION_MAX_CHECK_MS HF_QUALIFICATION_REPOSITORIES HF_SNAPSHOT_NATIVE_BINARY
# components: HF_SERVICE_MAX_REQUEST_BYTES HF_SERVICE_MAX_RESPONSE_BYTES
# decisions: CG_JEV_ENDPOINT CG_JEV_MODEL CG_RECAP_DECIDE_ENDPOINT CG_RECAP_DECIDE_MODEL CG_RECAP_MODEL HF_SPEC_ALLOWED_ROOT HYPERFIDE_DECISION_CALIBRATIONS HYPERFIDE_DECISION_CAPABILITY_PROFILES HYPERFIDE_DECISION_JOB_POLICY HYPERFIDE_DECISION_ROUTES HYPERFIDE_DECISION_SIGNER
# deployment: HYPERFIDE_RELEASE_ROOT HYPERFIDE_RELEASE_SIGNATURE_FILE HYPERFIDE_TRUSTED_RELEASE_KEY_FILE
# docs: HYPERFIDE_DOCUMENTATION_EXECUTION_PROFILE HYPERFIDE_REPOSITORY_ROOTS
# evaluation: HYPERFIDE_EVAL_STORE HYPERFIDE_EVAL_TRUSTED_KEYS
# events: HF_EVENT_DISPATCH_CONFIG
# findings: HF_FINDING_REPAIR_MAX_ATTEMPTS HF_GITHUB_ALLOWED_HOSTS HF_GITHUB_ALLOW_LOOPBACK HF_GITHUB_API_URL HF_GITHUB_MARKER_SECRET HF_GITHUB_REQUESTS_APPROVED HF_GITHUB_TOKEN HF_GITHUB_WEBHOOK_SECRET
# graph: HYPERFIDE_GRAPH_CONFIG HYPERFIDE_GRAPH_MAX_ACTIVE HYPERFIDE_GRAPH_MAX_QUEUED HYPERFIDE_GRAPH_QUERY_CACHE_ENTRIES HYPERFIDE_GRAPH_QUEUE_WAIT_MS HYPERFIDE_PG_POOL_MAX
# identity: HF_AUTHORIZATION_CONFIG_FILE HF_CREDENTIAL_CONFIG_FILE HF_NATIVE_AUTH_MODE_FILE
# integration: HYPERFIDE_CHECKER_DIGEST HYPERFIDE_GATEWAY_HOOK_DIGEST HYPERFIDE_GATEWAY_KEY_FILE HYPERFIDE_GITHUB_INSTALLATION_TOKEN HYPERFIDE_GITHUB_PUBLICATION_CONFIG HYPERFIDE_INTEGRATION_CONFIG HYPERFIDE_INTEGRATION_REPOSITORIES_JSON HYPERFIDE_INTEGRATION_ROLE HYPERFIDE_QUALIFICATION_ROOT HYPERFIDE_QUALIFIER_DIGEST HYPERFIDE_REMOTE_CLOSURE_DIGEST HYPERFIDE_REMOTE_CLOSURE_MODULE HYPERFIDE_REMOTE_NODE_DIGEST HYPERFIDE_REMOTE_QUALIFICATION_ROOT HYPERFIDE_SCOPE_MANIFEST
# migration: HF_LEGACY_WRITER_CONFIG_FILE HF_MIGRATION_ALLOWED_ROOT HF_MIGRATION_ARCHIVE_ROOT HF_MIGRATION_BINARY HF_MIGRATION_BINARY_SHA256 HF_MIGRATION_PLACEMENT HF_MIGRATION_SOURCES_FILE
# observability: HYPERFIDE_NOTIFICATION_PAGE_BUDGET HYPERFIDE_NOTIFICATION_REDACTION_SECRETS HYPERFIDE_OBSERVABILITY_ALLOW_REPLAY
# policy: HF_EXECUTION_HOST_BINDING HF_FRONTIER_POLICY_FILE HF_FRONTIER_QUALIFICATION_FILE HF_FRONTIER_QUALIFIER_PUBLIC_KEY_B64 HF_PLACEMENT_POLICY_FILE
# preparation: HF_EXECUTION_HOST_CLASS HF_PREPARATION_ALLOWED_ROOT HF_PREPARATION_WORKSPACE_ROOT HF_SLICE_SOURCE_CONFIG HYPERFIDE_PREPARATION_BACKOFF_BASE_MS HYPERFIDE_PREPARATION_BACKOFF_MAX_MS HYPERFIDE_PREPARATION_MAX_ATTEMPTS HYPERFIDE_PREPARATION_RECIPE_DIR HYPERFIDE_PREPARED_BASE_TTL_MS
# providers: HF_PROVISIONER_EXECUTOR_CONFIG_FILE HYPERFIDE_CAPACITY_ATTESTATIONS HYPERFIDE_CONNECTIVITY_CONFIG HYPERFIDE_POOL_CONFIG HYPERFIDE_PROVISIONER_CONCURRENCY HYPERFIDE_PROVISIONER_LEASE_MS HYPERFIDE_PROVISIONER_POLL_MS HYPERFIDE_PROVISIONER_RETRY_MS HYPERFIDE_RESOLUTION_ESCALATE_INTERVAL_MS HYPERFIDE_WRITER_ISOLATION_CONFIG
# recovery: HYPERFIDE_RECOVERY_PROBE_PROFILE
# release: HF_TRACEABILITY_PACK_ROOT HYPERFIDE_RELEASE_EVIDENCE_INDEX HYPERFIDE_RELEASE_PYTHON HYPERFIDE_RELEASE_QUALIFIED_PROOF_ROOT
# review: HYPERFIDE_REVIEW_ALLOWED_ROOT HYPERFIDE_REVIEW_APPROVED_POLICY_DIGESTS HYPERFIDE_REVIEW_REPOSITORIES
# runner: HF_RUNNER_PREPARATION_RECIPES_DIGEST HF_RUNNER_PREPARATION_RECIPES_FILE HF_SCHEDULER_NATIVE_CONSUMER_ID
# scheduler: HF_SCHEDULER_AUDIT_CONSUMER_IDS HF_SCHEDULER_DISPATCH_CONSUMER_ID
# spec: HF_AUTHORITY_EPOCH HF_PROOF_MAX_CHECK_MS HF_SPEC_ORGANISATION_ID HF_SPEC_PROJECT_ID
# storage: DATABASE_URL HYPERFIDE_CONTROL_REPLICA_DATABASE_URL HYPERFIDE_PG_CONNECT_TIMEOUT_MS HYPERFIDE_PG_IDLE_TIMEOUT_MS HYPERFIDE_PG_LISTENER_MAX HYPERFIDE_PG_LOCK_TIMEOUT_MS HYPERFIDE_PG_MAX_QUEUED HYPERFIDE_PG_STATEMENT_TIMEOUT_MS HYPERFIDE_PG_SYNCHRONOUS_COMMIT
# supervisor: HYPERFIDE_MAIN_BUDGET_FILE HYPERFIDE_SUPERVISOR_PYTHON
# Read only by the migration job, never set here (the preflight refuses): HYPERFIDE_MIGRATION_DATABASE_URL HYPERFIDE_MIGRATION_JOB HYPERFIDE_MIGRATION_TIMEOUT_MS
