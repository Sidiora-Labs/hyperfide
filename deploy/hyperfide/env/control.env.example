# Operator template, installed as /etc/hyperfide/control.env (root:root 0600). Replace placeholders before starting.
# Never add migration credentials or the migration job flag here; the preflight refuses with MIGRATION_CREDENTIAL_EXPOSED.
HYPERFIDE_LISTEN_HOST=127.0.0.1
HYPERFIDE_LISTEN_PORT=REPLACE_WITH_PORT
HYPERFIDE_SPEC_REVISION=REPLACE_WITH_APPROVED_REVISION
HYPERFIDE_REQUIRE_SYNC_REPLICA=REPLACE_WITH_0_OR_1
HYPERFIDE_DEPLOYMENT_ID=REPLACE_WITH_DEPLOYMENT_UUID
HYPERFIDE_AUTHORITY_JOURNAL_DIR=/var/lib/hyperfide/control/authority-journal
HYPERFIDE_CAUSAL_BARRIER_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
HF_IDENTITY_CONFIG_FILE=/etc/hyperfide/control-identity.json
# Optional. Operator credential UUIDs, comma-separated, allowed to request a DEPLOYMENT-wide stop (D14). Unset or empty refuses every DEPLOYMENT stop.
# HYPERFIDE_DEPLOYMENT_OPERATORS=REPLACE_WITH_OPERATOR_CREDENTIAL_UUID
# Optional. Stop driver poll interval in ms; default 5000, 0 disables the driver, maximum 3600000.
# HYPERFIDE_STOP_DRIVER_INTERVAL_MS=5000
# Provider resolution policy window (D15): orphans and quarantined intents unresolved this long become decision Asks.
# No code default; provider.resolutions.escalate refuses with RESOLUTION_WINDOW_REQUIRED until the operator sets it (3600 recommended):
# HYPERFIDE_PROVIDER_RESOLUTION_WINDOW_SECONDS=3600
# Written by hand to /etc/hyperfide/control.db.env (root:root 0600), loaded by the db-env.conf drop-in:
# HYPERFIDE_CONTROL_PRIMARY_DATABASE_URL=postgresql://REPLACE_WITH_SCOPED_ROLE:REPLACE_WITH_SECRET@REPLACE_WITH_HOST/hyperfide
