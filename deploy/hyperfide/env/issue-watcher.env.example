# Operator template, installed as /etc/hyperfide/issue-watcher.env (root:root 0600) and loaded by hyperfide-issue-watcher.service.
# The watcher is a signed client of control and takes its configuration from /etc/hyperfide/issue-watcher.json; it holds no database URL.
# Local and offline modes are refused (DISTRIBUTED_AUTHORITY_REQUIRED).
HYPERFIDE_MODE=distributed
