# Operator template, installed as /etc/hyperfide/provisioner.env (root:root 0600). Replace placeholders before starting.
# Never add migration credentials or the migration job flag here; the preflight refuses with MIGRATION_CREDENTIAL_EXPOSED.
HYPERFIDE_PROVISIONER_LISTEN_HOST=127.0.0.1
HYPERFIDE_PROVISIONER_LISTEN_PORT=REPLACE_WITH_PORT
HYPERFIDE_SPEC_REVISION=REPLACE_WITH_APPROVED_REVISION
HYPERFIDE_REQUIRE_SYNC_REPLICA=REPLACE_WITH_0_OR_1
HYPERFIDE_DEPLOYMENT_ID=REPLACE_WITH_DEPLOYMENT_UUID
HYPERFIDE_AUTHORITY_JOURNAL_DIR=/var/lib/hyperfide/provisioner/authority-journal
HYPERFIDE_EXTERNAL_FENCE_CONFIG_FILE=/etc/hyperfide/external-fence.json
HYPERFIDE_POOL_CONFIG=/etc/hyperfide/pools.json
HF_RAILWAY_CONFIG=/etc/hyperfide/railway.json
HF_RAILWAY_TOKEN=REPLACE_WITH_PROVIDER_TOKEN
HF_PREPARATION_ALLOWED_ROOT=/var/lib/hyperfide/provisioner/preparation
# Internal object store and regional mirrors (docs/hyperfide/operations.md); preflight validates it when set:
# HF_SLICE_SOURCE_CONFIG=/etc/hyperfide/object-store.json
HF_PROVISIONER_EXECUTOR_CONFIG_FILE=/etc/hyperfide/provisioner-worker.json
# Provider resolution policy window (D15): orphans and quarantined intents unresolved this long become decision Asks.
# No code default; provider.resolutions.escalate refuses with RESOLUTION_WINDOW_REQUIRED until the operator sets it (3600 recommended):
# HYPERFIDE_PROVIDER_RESOLUTION_WINDOW_SECONDS=3600
# Worker cadence for provider.resolutions.escalate in milliseconds; 0 disables it, unset runs every 60000:
# HYPERFIDE_RESOLUTION_ESCALATE_INTERVAL_MS=60000
HF_IDENTITY_CONFIG_FILE=/etc/hyperfide/provisioner-identity.json
# Written by hand to /etc/hyperfide/provisioner.db.env (root:root 0600), loaded by the db-env.conf drop-in:
# HYPERFIDE_PROVISIONER_PRIMARY_DATABASE_URL=postgresql://REPLACE_WITH_SCOPED_ROLE:REPLACE_WITH_SECRET@REPLACE_WITH_HOST/hyperfide
