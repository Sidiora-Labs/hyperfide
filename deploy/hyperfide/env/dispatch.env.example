# Operator template: replace placeholders before starting services.
HYPERFIDE_DISPATCH_LISTEN_HOST=127.0.0.1
HYPERFIDE_DISPATCH_LISTEN_PORT=REPLACE_WITH_PORT
HYPERFIDE_SPEC_REVISION=REPLACE_WITH_APPROVED_REVISION
HYPERFIDE_DISPATCH_PRIMARY_DATABASE_URL=postgresql://REPLACE_WITH_SCOPED_ROLE:REPLACE_WITH_SECRET@REPLACE_WITH_HOST/hyperfide
HYPERFIDE_REQUIRE_SYNC_REPLICA=REPLACE_WITH_0_OR_1
HYPERFIDE_DEPLOYMENT_ID=REPLACE_WITH_DEPLOYMENT_UUID
HYPERFIDE_AUTHORITY_JOURNAL_DIR=/var/lib/hyperfide/dispatch/authority-journal
HF_EVENT_DISPATCH_CONFIG=/etc/hyperfide/dispatch-worker.json
HF_IDENTITY_CONFIG_FILE=/etc/hyperfide/dispatch-identity.json
