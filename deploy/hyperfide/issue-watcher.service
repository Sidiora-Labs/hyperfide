# Qualified by task 26.4 receipt (ff4632c9bc89), checked by release.inspect.
# Explicit start still requires the operator qualification marker below.
[Unit]
Description=Hyperfide issue watcher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
ConditionPathExists=/opt/hyperfide/current/share/hyperfide/qualified/issue-watcher
[Service]
Type=exec
User=hyperfide
Group=hyperfide
WorkingDirectory=/opt/hyperfide/current
EnvironmentFile=/etc/hyperfide/issue-watcher.env
Environment=LD_LIBRARY_PATH=/opt/hyperfide/current/lib/hyperfide
ExecStart=/opt/hyperfide/current/bin/hyperfide issue-watcher --config /etc/hyperfide/issue-watcher.json
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hyperfide
UMask=0077
