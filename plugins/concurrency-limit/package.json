{
  "name": "hyperfide-plugin-concurrency-limit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control the number of concurrent threads that are running in hyperfide",
  "engines": {
    "hyperfide": ">=0.0",
    "hyperfidePluginSdk": ">=0.4.102"
  },
  "hyperfide": {
    "name": "Concurrency limit",
    "description": "Control the number of concurrent threads that are running in hyperfide",
    "branding": {
      "icon": "Limitation"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "keywords": [
    "hyperfide-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "hyperfide-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@hyperfide/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hyperfide/plugin-build": "workspace:*",
    "@hyperfide/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
