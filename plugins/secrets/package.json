{
  "name": "hyperfide-plugin-secrets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Securely request credentials from a user and reconcile them into dotenv files.",
  "engines": {
    "hyperfide": ">=0.0",
    "hyperfidePluginSdk": ">=0.4.102"
  },
  "hyperfide": {
    "name": "Secrets",
    "description": "Securely request credentials from a user and reconcile them into dotenv files.",
    "branding": {
      "icon": "Lock"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "hyperfide-plugin"
  ],
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "hyperfide-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@hyperfide/shared-ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hyperfide/plugin-build": "workspace:*",
    "@hyperfide/plugin-sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.1",
    "hono": "4.11.9",
    "react": "^19.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
