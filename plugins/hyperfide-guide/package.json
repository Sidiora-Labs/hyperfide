{
  "name": "hyperfide-plugin-hyperfide-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control the HYPERFIDE introduction and bundled agent skills.",
  "engines": {
    "hyperfide": ">=0.0",
    "hyperfidePluginSdk": ">=0.6.0"
  },
  "hyperfide": {
    "name": "HYPERFIDE guide",
    "description": "Control the HYPERFIDE introduction and bundled agent skills.",
    "branding": {
      "icon": "Explore"
    },
    "server": "./server.ts",
    "app": "./app.ts"
  },
  "keywords": [
    "hyperfide-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
