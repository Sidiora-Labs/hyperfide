    "prepare:bundled": "hyperfide-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@hyperfide/plugin-build": "workspace:*",
    "@hyperfide/plugin-sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
