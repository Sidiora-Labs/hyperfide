{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/components/ui/icon": [
        "../../tools/plugin-registry/flavors/components/ui/icon.tsx"
      ],
      "@/*": ["../../lib/shared-ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts"]
}
