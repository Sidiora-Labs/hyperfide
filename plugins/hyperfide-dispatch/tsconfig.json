{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/components/ui/icon": [
        "../../tools/plugin-registry/flavors/components/ui/icon.tsx"
      ],
      "@/*": ["../../lib/shared-ui/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
