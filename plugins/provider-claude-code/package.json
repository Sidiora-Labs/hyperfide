{
  "name": "hyperfide-plugin-provider-claude-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run hyperfide-platform threads with Claude Code.",
  "engines": {
    "hyperfide": ">=0.0",
    "hyperfidePluginSdk": ">=0.4.90"
  },
  "hyperfide": {
    "name": "Claude Code provider",
    "description": "Run hyperfide-platform threads with Claude Code.",
    "branding": {
      "icon": "./icons/claude-code.svg"
    },
    "server": "./server.ts",
    "host": "./src/host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "claude-code",
        "displayName": "Claude Code"
      }
    ]
  },
  "keywords": [
    "hyperfide-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "hyperfide-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@hyperfide/plugin-build": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "@hyperfide/plugin-sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
