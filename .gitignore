**/provider-corpus/**
!core/server/test/provider-corpus/**
!tools/workspace/provider-corpus/**
.builtin-server-test-*/
.builtin-host-test-*/

/plugins/.bundled-stage-*/
/plugins/*/.bundled-runtime/

.ci-health/

