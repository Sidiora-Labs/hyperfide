# Desktop packaging keeps its tracked build inputs
!/apps/desktop/build/

# Root runtime workspace dependencies, generated outputs and private state
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
coverage

# next.js
.next
dist
out

# production
/build
/apps/web/build/
/apps/launcher/host-daemon/
/apps/launcher/host-package/
/apps/desktop/release/
/apps/desktop/.electron-builder.generated.json

# Generated at build time by turbo `generate:*` / `build:types` tasks (see
# turbo.json). Never commit these: they are pure functions of tracked sources
# and only produce merge conflicts.
/lib/templates/src/generated/
/lib/process-utils/src/generated/
/sdk/plugins/bundled-types/
/tools/plugin-build/src/generated/
/core/server/src/generated/

# misc
.DS_Store
*.pem
