# Generated by the hyperfide:bundle-stats Vite plugin for the boot-payload budget check.
apps/web/bundle-stats.json

# Raw provider bridge recordings (record mode output) can hold secrets; only
# the redacted copies under core/provider-bridge-protocol/recordings ship.
provider-recordings/raw/

# Private provider corpus (tests read it through HYPERFIDE_PROVIDER_CORPUS_DIR).
